---
/**
 * The page shell. `theme` picks the page's first tone, written server side on
 * <html data-theme> so the first paint is right before the script runs:
 * "cream" for the Suite pages, "ac-cream" (alias "teal") for the Academy and
 * INQ pages, which also get the .theme-teal class for the teal accent system.
 * `navStart` seeds the header tone ("light" on every page today).
 *
 * The head: every page passes its own title (under 60 characters) and
 * description (120 to 160), each built from that page's own copy; the
 * canonical URL, Open Graph and Twitter card tags follow from them, with the
 * shared /og-image.png (1200 x 630) unless a page passes `image` and
 * `imageAlt`. `noindex` (the 404 page) drops the canonical and asks search
 * engines not to index it. theme-color is the page's first tone. `preload`
 * names the first screen's image, so it is requested with the fonts.
 */
import "../styles/global.css";
import "../styles/motion.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config/links";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  theme?: "cream" | "ac-cream" | "teal";
  themeColor?: string;
  navStart?: "light" | "dark";
  imageAlt?: string;
  noindex?: boolean;
  preload?: { href: string; srcset?: string; sizes?: string; type?: string; media?: string };
}
const {
  title, description, path = "/", image = "/og-image.png", theme = "cream", themeColor, navStart = "light", noindex = false, preload,
  imageAlt = "The InnerBoard logo."
} = Astro.props;
const teal = theme === "teal" || theme === "ac-cream";
const dataTheme = teal ? "ac-cream" : "cream";
const color = themeColor || (teal ? "#f7f4ee" : "#f4efe4");
const canonical = new URL(path, SITE.url).toString();
/* The link preview (Open Graph, Twitter) must load from the host that serves this build: on Vercel that is the
 * project's production URL (its vercel.app address until the domain is attached, then the domain), or the branch
 * URL for previews. Without Vercel it falls back to the site's own domain. */
const host = process.env.VERCEL_ENV === "production" ? process.env.VERCEL_PROJECT_PRODUCTION_URL : (process.env.VERCEL_BRANCH_URL || process.env.VERCEL_URL);
const origin = host ? `https://${host}` : SITE.url;
const imageUrl = new URL(image, origin).toString();
const shareUrl = new URL(path, origin).toString();
---
<!doctype html>
<html lang="en" class={`no-js ${teal ? "theme-teal" : ""}`} data-theme={dataTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={color} />
    <meta name="nav-start" content={navStart} />
    <link rel="icon" href="/brand/icon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/brand/icon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/brand/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={shareUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="preload" href="/fonts/fraunces-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-latin-wght-italic.woff2" as="font" type="font/woff2" crossorigin />
    {preload && <link rel="preload" as="image" href={preload.href} imagesrcset={preload.srcset} imagesizes={preload.sizes} type={preload.type} media={preload.media} fetchpriority="high" />}
    <script is:inline>document.documentElement.classList.remove("no-js");document.documentElement.classList.add("js");</script>
    <style is:inline>@view-transition { navigation: auto; }</style>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <ClientRouter />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "InnerBoard",
      url: SITE.url,
      sameAs: ["https://innerboardos.com", "https://practiceinnerboard.com"]
    })} />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Header theme={teal ? "teal" : "cream"} />
    <main id="main">
      <slot />
    </main>
    <Footer theme={teal ? "teal" : "cream"} />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
