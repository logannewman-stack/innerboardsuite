---
/**
 * innerboardsuite.com, the homepage (BUILD_SPEC 2.1).
 *
 * Built to the InnerBoard Suite handoff (October 15, 2026) and the build
 * brief: the copy below is theirs, section by section, in the locked order.
 * Eight sections: the plate hero, the recognition cards, the Practice panel
 * with the looping phone, the quiz still life, the typographic Academy, the
 * INQ teaser (where the page turns to evening), the lit mission and the
 * InnerBoard IOS panel. Every image is a real capture of Practice.
 */
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import FlipCards from "../components/FlipCards.astro";
import PhoneFrame from "../components/PhoneFrame.astro";
import Geo from "../components/Geo.astro";
import HomeHeroPlate from "../components/HomeHeroPlate.astro";
import HomeQuizStill from "../components/HomeQuizStill.astro";
import { LINKS } from "../config/links";

const title = "InnerBoard · A new way to meet this life";
const description =
  "A few minutes a day to think more clearly, feel more confident, and choose what comes next, with a coach in your pocket. Practice, Academy, INQ and InnerBoard IOS.";

/* The five features, with the loop phone's step for each row (1.7.8). */
const features = [
  { name: "Daily Practice Coach", body: "Type what is happening, and think it through right when it matters.", frame: "0", ms: 2600, tap: undefined },
  { name: "The Daily Dare", body: "One small thing to do before the day ends. A new one every day.", frame: "1", ms: 3200, tap: "19,69,900,2" },
  { name: "Courses", body: "Go deeper on what you're living, from your thoughts and feelings to relationships and confidence.", frame: "none", ms: 1800, tap: undefined },
  { name: "Live Sessions and Community", body: "Monthly masterclasses, coaching labs, and a room where nobody has to figure it out alone.", frame: "none", ms: 1800, tap: undefined },
  { name: "Tools for the Moment", body: "For when you're reacting right now: a breath, a reset, and your next move.", frame: "3", ms: 3600, tap: "50,60,1200,4" }
];

const quizBenefits = [
  { name: "4 minutes to complete", body: "Quick, simple, and insightful." },
  { name: "Personalized results", body: "See what might be auto-renewing in your life." },
  { name: "Discover the unseen cost", body: "What it could be costing you in time, energy, confidence, peace, and relationships." },
  { name: "One thing to do differently", body: "Your gift: a simple next step you can try right away." }
];
---
<Base title={title} description={description} path="/">
  <!-- 1. Hero: the plate, the hanging phone, the line rise -->
  <section class="hm-hero grain grain-cream" data-tone="cream">
    <i class="lamp lamp-cream" aria-hidden="true" style="--lx:50%;--ly:0%"></i>
    <div class="wrap hm-hero-wrap">
      <div class="grid">
        <div class="hm-hero-copy">
          <p class="eyebrow rise" style="--d:.45s">Practice by InnerBoard</p>
          <h1 data-lines class="t-xl hm-h1"><span class="hl">You don't need a different life,</span> <em class="hl">just a new way to meet this one.</em></h1>
          <p class="t-lead hm-lead rise" style="--d:.52s">A few minutes a day to think more clearly, feel more confident, and choose what comes next with a coach in your pocket.</p>
          <div class="hm-btns hm-hero-btns rise" style="--d:.6s">
            <a href={LINKS.practice} class="btn btn-gold" data-passthrough data-event="practice_click" data-event-location="hero">Start in Practice <Arrow /></a>
            <a href={LINKS.quiz} class="btn btn-line" data-passthrough data-event="quiz_click" data-event-location="hero">What's Holding You Back?</a>
          </div>
        </div>
      </div>
    </div>
    <HomeHeroPlate />
  </section>

  <!-- 2. Recognition cards -->
  <section id="recognize" class="hm-recognize" data-tone="cream">
    <div class="wrap">
      <h2 class="t-l wipe hm-recognize-h2">On paper, <em>it all looks fine.</em></h2>
      <FlipCards class="hm-flips" />
    </div>
  </section>

  <!-- 3. Practice: the forest panel with the looping phone and the ladder -->
  <section id="practice" class="hm-practice" data-tone="cream">
    <div class="wrap-wide panel-forest grain surface-forest hm-panel" data-surface="dark" data-loop>
      <i class="lamp" aria-hidden="true" style="--lx:18%;--ly:0%"></i>
      <div class="hm-panel-in">
        <div class="hm-panel-grid">
          <div class="hm-panel-head">
            <p class="eyebrow rise">Practice by InnerBoard</p>
            <h2 class="t-m wipe hm-panel-h2">A different way to meet <em>whatever life brings.</em></h2>
          </div>
          <p class="t-lead hm-panel-lead rise" style="--d:.28s">A daily practice coach with personalized insight, real-time support, and tools to help you think differently, feel differently, and choose what's next.</p>
          <div class="hm-panel-phone rise-obj floor-on" style="--d:.2s">
            <PhoneFrame width={300} shadow="dark" screens={[
              { name: "coach-draft", alt: "The Daily Practice Coach with a sentence typed in the composer.", w: 780, h: 1688 },
              { name: "home", alt: "The Coach home as a visitor.", w: 600, h: 1298 },
              { name: "dare", alt: "The home after the Dare is checked, with the star line.", w: 600, h: 1298 },
              { name: "tools-home", alt: "The Tools hub.", w: 780, h: 1688 },
              { name: "pause-breath", alt: "Pause + Redirect, one breath.", w: 780, h: 1688 }
            ]} />
            <!-- While Courses and Live Sessions are lit, a soft halo marks the app's own Academy and Inner Lab tabs (no tap, no state change). -->
            <i class="hm-halo hm-halo-academy" aria-hidden="true"></i>
            <i class="hm-halo hm-halo-lab" aria-hidden="true"></i>
          </div>
          <ul class="ladder ladder-gold hm-ladder" role="list">
            {features.map((f, i) => (
              <li class="rise" style={`--d:${i * 70}ms;--ms:${f.ms}ms`} data-loop-step={i} data-loop-frame={f.frame} data-loop-ms={f.ms} data-loop-tap={f.tap}>
                <svg class="hm-tick" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><circle class="hm-tick-track" cx="6" cy="6" r="5.5"></circle><circle class="hm-tick-run" cx="6" cy="6" r="5.5" pathLength="100"></circle><circle class="hm-tick-dot" cx="6" cy="6" r="3"></circle></svg>
                <div><p class="ladder-name">{f.name}</p><p class="ladder-body">{f.body}</p></div>
              </li>
            ))}
          </ul>
        </div>
        <div class="rule-gold hm-panel-rule" aria-hidden="true"></div>
        <div class="hm-panel-foot">
          <div class="hm-panel-close rise">
            <p class="t-s hm-panel-close-line">Start today, <em>as you are.</em></p>
            <p class="t-body hm-panel-close-body">Bring what's happening in your life right now. We'll help you take the next step.</p>
          </div>
          <div class="hm-btns hm-panel-btns rise" style="--d:.3s">
            <a href={LINKS.practice} class="btn btn-gold" data-passthrough data-event="practice_click" data-event-location="practice">Start in Practice <Arrow /></a>
            <a href={LINKS.practicePage} class="btn btn-line">See everything inside</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. The subscription quiz: the still life with the scrolling result -->
  <section id="quiz" class="hm-quiz" data-tone="cream">
    <div class="wrap grid hm-quiz-grid">
      <div class="hm-quiz-copy">
        <div class="hm-quiz-head">
          <p class="eyebrow rise">The subscription quiz</p>
          <h2 class="t-m wipe">What's costing you <em>more than you think?</em></h2>
          <div class="t-lead hm-stack hm-quiz-lead">
            <p class="rise">You know those subscriptions you forgot about, but they're still on auto-renew?</p>
            <p class="rise" style="--d:.28s">What if you're doing the same thing in your life?</p>
            <p class="rise" style="--d:.36s">Except these subscriptions aren't charging your credit card. They're costing you time, energy, confidence, peace, and connection.</p>
          </div>
        </div>
        <ul class="hm-benefits" role="list">
          {quizBenefits.map((b, i) => (
            <li class="rise" style={`--d:${0.2 + i * 0.07}s`}><b class="t-title">{b.name}</b><p class="t-body">{b.body}</p></li>
          ))}
        </ul>
        <div class="hm-quiz-cta rise" style="--d:.5s">
          <a href={LINKS.quiz} class="btn btn-gold" data-passthrough data-event="quiz_click" data-event-location="quiz">Take the Quiz <Arrow /></a>
          <p class="hm-quiz-closing">It's time to cancel what's no longer serving you.</p>
        </div>
      </div>
      <div class="hm-quiz-still">
        <HomeQuizStill />
      </div>
    </div>
  </section>

  <!-- 5. Academy: typographic, with the italic deck and the paper note -->
  <section id="academy" class="hm-academy" data-tone="cream">
    <div class="wrap hm-academy-wrap">
      <div class="grid">
        <div class="hm-academy-head">
          <p class="eyebrow rise">Academy | Courses to own</p>
          <h2 class="t-l wipe">Go deeper into the skills <em>that change everything.</em></h2>
        </div>
      </div>
      <div class="grid hm-academy-grid">
        <p class="t-lead hm-academy-body rise">Practical, transformational learning for real life. Buy the courses you want. Keep them forever.</p>
        <div class="hm-deck rise" style="--d:.24s">
          <i class="rule-draw" aria-hidden="true"></i>
          <p class="t-s-pull hm-deck-line">Explore courses in thinking, feeling, and leading differently.</p>
          <i class="rule-draw" aria-hidden="true" style="--d:.15s"></i>
        </div>
        <div class="hm-btns hm-academy-btns rise" style="--d:.3s">
          <a href={LINKS.academy} class="btn btn-gold" data-event="academy_click" data-event-location="academy">Explore Academy <Arrow /></a>
          <a href={LINKS.practice} class="btn btn-line" data-passthrough data-event="practice_click" data-event-location="academy">Explore Practice</a>
        </div>
        <div class="paper hm-note rise" style="--d:.2s">
          <p class="eyebrow">Also included in Practice</p>
          <p class="t-body hm-note-body">Get access to these courses with a paid Practice subscription, alongside your daily coach, live sessions, and tools for the moment.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. INQ Certification teaser: a navy bleed, the page turns to evening -->
  <section id="inq" class="hm-inq" data-tone="navy">
    <i class="lamp grain" aria-hidden="true" style="--lx:85%;--ly:0%"></i>
    <Geo class="hm-geo-inq" color="#f4efe4" opacity={0.08} ringsOnly />
    <div class="wrap grid">
      <div class="hm-inq-copy">
        <p class="eyebrow rise">INQ Certification | Lead it</p>
        <h2 class="t-l wipe">Coach the change that <em>actually changes people.</em></h2>
        <p class="t-lead hm-inq-lead rise">A science-informed certification in human behavior, neuroscience, emotional intelligence, and habit change.</p>
        <p class="t-lead hm-inq-lead hm-inq-lead-2 rise" style="--d:.3s">Gain the confidence to create meaningful results for your clients, apply the work to your own life, and build a coaching business around the impact you make.</p>
      </div>
      <i class="rule-gold-v rule-draw-v hm-inq-rule" aria-hidden="true"></i>
      <div class="hm-inq-btns rise" style="--d:.24s">
        <a href={LINKS.inq} class="btn btn-gold" data-event="inq_click" data-event-location="teaser">Explore INQ Certification <Arrow /></a>
        <a href={LINKS.inqBook} class="btn btn-line" data-event="inq_book_click" data-event-location="teaser">Book a Conversation</a>
      </div>
    </div>
  </section>

  <!-- 7. Why InnerBoard exists: the lit mission -->
  <section id="mission" class="hm-mission" data-tone="cream">
    <div class="wrap">
      <div class="hm-mission-in">
        <p class="eyebrow rise">Why InnerBoard exists</p>
        <h2 class="t-l wipe hm-mission-h2">We believe people are capable of more.</h2>
        <p class="t-s-pull hm-mission-sub rise">Sometimes they just need a different way forward.</p>
        <div class="t-state hm-mission-lit" data-lit>
          <p><b class="lb">InnerBoard was built on a simple belief:</b> the way we think, feel, and respond shapes the way we experience our lives.</p>
          <p><b class="lb">And those aren't things we're stuck with.</b> They're skills we can learn, strengthen, and practice.</p>
          <p><b class="lb">Our mission</b> is to make that kind of growth accessible, practical, and part of everyday life, so more people can become who they're capable of being.</p>
        </div>
        <p class="t-s hm-mission-close" data-lit="lines" data-lit-step="120"><span class="lw">Learn it.</span> <span class="lw">Live it.</span> <span class="lw">Lead it.</span> <em class="lw">Practice it.</em></p>
      </div>
    </div>
  </section>

  <!-- 8. InnerBoard IOS: the navy panel, the page's last and largest action -->
  <section id="ios" class="hm-ios" data-tone="cream">
    <div class="wrap-wide panel-navy grain hm-ios-panel" data-surface="dark">
      <i class="lamp" aria-hidden="true" style="--lx:12%;--ly:72%;--la:.12"></i>
      <Geo class="hm-geo-ios" color="#f4efe4" opacity={0.08} ringsOnly />
      <div class="hm-ios-in">
        <div class="hm-ios-copy">
          <i class="rule-gold-v rule-draw-v hm-ios-rule" aria-hidden="true"></i>
          <p class="eyebrow rise">InnerBoard IOS | Scale it</p>
          <h2 class="t-m wipe hm-ios-h2">Imagine what happens when <em class="grad">an entire team grows.</em></h2>
          <p class="t-lead hm-ios-lead rise">Personal growth changes how one person shows up. Imagine what becomes possible when an entire organization learns to think differently, lead themselves, and bring their best to work.</p>
          <p class="t-lead hm-ios-lead hm-ios-lead-2 rise" style="--d:.3s">InnerBoard IOS brings a people operating system into organizations, helping build the confidence, capability, and accountability that strengthen culture and drive results.</p>
        </div>
        <div class="hm-ios-btn rise" style="--d:.36s">
          <a href={LINKS.ios} class="btn btn-gold btn-lg" rel="noopener" data-event="ios_click" data-event-location="pathway">Explore InnerBoard IOS <Arrow /></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* Homepage layout (BUILD_SPEC 2.1, with the art director's round one
   * punch list applied). Every number is from the spec or the punch list;
   * the system's tokens, classes and components do the rest. Prefixed hm-
   * so the rules never reach a shared component: where the page needs a
   * shared component to look different (the flip cards, the toggle card, the
   * geo, the ladder rows) it says so here, scoped under an hm- class. */

  /* ── 2.1.1 Hero ───────────────────────────────────────────────────── */
  .hm-hero { --hero-h: max(640px, min(100svh, 900px)); min-height: var(--hero-h); padding-top: var(--nav-h); padding-bottom: 0; overflow: visible; }
  .hm-hero > .lamp { z-index: 0; }
  /* The lamp's gold foot and the grain fade out before the section's bottom edge, so the hero ends in the page's cream rather than on a line. */
  .hm-hero > .lamp-cream, .hm-hero.grain::after { -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 96px), transparent); mask-image: linear-gradient(to bottom, #000 calc(100% - 96px), transparent); }
  .hm-hero-wrap { position: relative; z-index: 2; }
  .hm-hero-copy { grid-column: 1 / span 7; padding-top: 90px; }
  .hm-h1 { max-width: 7.8em; margin: 0; }
  .hm-lead { margin-top: 28px; color: var(--fg-2); }
  .hm-btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .hm-hero-btns { margin-top: 36px; }
  .hm-hero-phone { --col-r: calc(var(--edge) + 8 * (var(--colw) + var(--gap))); }
  /* The product shot is the hero's object: the phone alone on the cream, about 380 wide at 1440
   * (outer about 403 x 845), centred over columns 9 to 12, its top under the header and its foot
   * hanging past the fold onto section 2, so the first screen is the product, not a block of colour. */
  .hm-hero-phone { --pw: clamp(280px, min(26.5vw, 48vh), 400px); position: absolute; z-index: 3;
    top: max(108px, calc(var(--hero-h) + 56px - var(--pw) * 2.224));
    left: calc(100% - var(--edge) - var(--pw) * 1.06); }
  /* A warm light behind the phone and a gold hairline ring at its edge: it reads lit and set apart from the cream. */
  .hm-halo { position: absolute; z-index: -1; pointer-events: none; left: 50%; top: 42%; width: 190%; aspect-ratio: 1; transform: translate(-50%, -50%);
    border-radius: 50%; background: radial-gradient(closest-side, rgba(201,171,102,.34), rgba(201,171,102,.12) 55%, rgba(201,171,102,0) 100%); }
  .hm-hero-phone .phone { box-shadow: inset 0 0 0 .55em #0c0b09, inset 0 0 0 .9em rgba(255,255,255,.06), 0 0 0 1px rgba(110,87,36,.18),
    0 2px 4px rgba(31,29,26,.14), 0 24px 40px -16px rgba(31,29,26,.34), 0 90px 120px -50px rgba(31,29,26,.5); }
  .hm-hero-phone .phone-floor { --floor-a: .38; }

  /* ── 2.1.2 Recognition ────────────────────────────────────────────── */
  /* Top padding: 60% of a section plus the phone's 72 px overhang, so the h2 follows the first screen without a stall. */
  .hm-recognize { padding-top: calc(var(--sec) * .6 + 72px); padding-bottom: var(--sec); }
  .hm-recognize-h2 { max-width: calc(7 * var(--colw) + 6 * var(--gap)); }
  .hm-flips { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); margin-top: var(--head-gap); }
  .hm-flips > li:nth-child(1) { grid-column: 1 / span 5; }
  .hm-flips > li:nth-child(2) { grid-column: 7 / span 5; margin-top: 96px; }
  .hm-flips > li:nth-child(3) { grid-column: 2 / span 5; margin-top: -24px; }
  .hm-flips > li:nth-child(4) { grid-column: 8 / span 5; margin-top: 72px; }
  /* Tighter cards (FlipCards is shared, so this is scoped): the face hugs its
   * words, the quote sits 18 px under the eyebrow and the cue is pinned to the
   * bottom. Cards 2 to 4 keep "Sound familiar?" for assistive technology only,
   * so it prints once. */
  .hm-flips .flip-inner, .hm-flips .flip-face { min-height: 248px; }
  .hm-flips .flip-face { justify-content: flex-start; gap: 0; padding: 32px 32px 28px; }
  .hm-flips .flip-quote { font-size: clamp(26px, 2.2vw, 34px); margin-top: 18px; }
  .hm-flips .flip-reframe { margin-top: 18px; }
  .hm-flips .flip-cue { margin-top: auto; padding-top: 28px; }
  .hm-flips > li:nth-child(n+2) .flip-front .eyebrow { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .hm-flips > li:nth-child(n+2) .flip-front .flip-quote { margin-top: 0; }
  .hm-recognize .flip-close { max-width: calc(8 * var(--colw) + 7 * var(--gap)); }

  /* ── 2.1.3 The forest panel ───────────────────────────────────────── */
  /* Row one: the h2 at the left, the lead beside it at the right on the same
   * last baseline, so no block of forest stands empty. Row two: the phone
   * from column 2 and the ladder at the right, bottom aligned. The panel's
   * full width gold rule runs directly under that row: it is the floor line
   * the phone stands on and the line the ladder ends on. */
  .hm-practice { padding-bottom: var(--sec); }
  .hm-panel { padding: 88px 80px 72px; }
  .hm-panel-in { position: relative; z-index: 1; }
  .hm-panel-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: 56px; }
  .hm-panel-head { grid-column: 1 / span 7; grid-row: 1; align-self: last baseline; }
  .hm-panel-h2 { color: #f4efe4; }
  .hm-panel-lead { grid-column: 8 / span 5; grid-row: 1; align-self: last baseline; color: #cdc6b8; max-width: 28em; margin: 0; }
  .hm-panel-phone { grid-column: 2 / span 5; grid-row: 2; justify-self: start; position: relative; }
  .hm-ladder { grid-column: 8 / span 5; grid-row: 2; align-self: end; }
  /* The loop's own progress mark replaces the icon circles: a 12 px ring in
   * gold-2 at .5; on the lit row its stroke runs once round over the row's
   * dwell and the centre fills gold-2. */
  .hm-ladder > li { grid-template-columns: 12px 1fr; column-gap: 20px; padding-block: 26px; }
  .hm-ladder > li:last-child { padding-bottom: 26px; }
  .hm-tick { display: block; width: 12px; height: 12px; margin-top: calc((var(--fs-title) * 1.2 - 12px) / 2); overflow: visible; }
  .hm-tick circle { fill: none; stroke-width: 1; }
  .hm-tick-track { stroke: rgba(201,171,102,.5); }
  .hm-tick-run { stroke: #c9ab66; stroke-dasharray: 100; stroke-dashoffset: 100; transform: rotate(-90deg); transform-origin: 50% 50%; }
  .hm-tick .hm-tick-dot { fill: #c9ab66; stroke: none; opacity: 0; transform: scale(.4); transform-origin: 50% 50%; transition: opacity 350ms var(--ease), transform 350ms var(--ease); }
  .hm-ladder > li.is-on .hm-tick-dot { opacity: 1; transform: none; }
  .hm-ladder > li.is-on .hm-tick-run { animation: hm-tick var(--ms, 2400ms) linear forwards; }
  @keyframes hm-tick { to { stroke-dashoffset: 0; } }
  .no-js .hm-ladder > li[data-loop-step="0"] .hm-tick-dot { opacity: 1; transform: none; }
  .hm-ladder .ladder-name { color: #f4efe4; }
  .hm-ladder .ladder-body { color: #cdc6b8; }
  /* The halo on the app's own bottom bar (Academy for Courses, Inner Lab for
   * Live Sessions and Community), in % of the phone's outer box: the tabs sit
   * at 26.8% and 42.2% across the screen and 95% down it. Shown only while
   * the screen is one with that bar. */
  .hm-halo { position: absolute; top: 94.1%; width: 15%; aspect-ratio: 1; border-radius: 50%; translate: -50% -50%; pointer-events: none; z-index: 2; opacity: 0;
    background: radial-gradient(closest-side, rgba(201,171,102,.42), rgba(201,171,102,.18) 62%, transparent); box-shadow: 0 0 0 1px rgba(201,171,102,.38); transition: opacity 350ms var(--ease); }
  .hm-halo-academy { left: 28%; }
  .hm-halo-lab { left: 42.6%; }
  .hm-panel:has([data-loop-step="2"].is-on):not(:has(img.ds.on:is([src*="tools-home"], [src*="pause-breath"]))) .hm-halo-academy,
  .hm-panel:has([data-loop-step="3"].is-on):not(:has(img.ds.on:is([src*="tools-home"], [src*="pause-breath"]))) .hm-halo-lab { opacity: 1; animation: hm-halo 1.6s var(--ease) infinite; }
  @keyframes hm-halo { 0%, 100% { scale: .82; opacity: .55; } 50% { scale: 1.06; opacity: 1; } }
  .hm-panel-rule { margin-block: 0 48px; }
  .hm-panel-foot { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); align-items: end; }
  .hm-panel-close { grid-column: 1 / span 7; }
  .hm-panel-close-line { color: #f4efe4; }
  .hm-panel-close-body { color: #cdc6b8; margin-top: 12px; }
  .hm-panel-btns { grid-column: 8 / span 5; justify-content: flex-end; }

  /* ── 2.1.4 The quiz still life ────────────────────────────────────── */
  /* The copy comes first in the document (so the phone never arrives before
   * its heading at 390); at desktop the still life takes columns 1 to 6 and
   * the copy columns 7 to 12. */
  .hm-quiz { padding-block: var(--sec); }
  .hm-quiz-still { grid-column: 1 / span 6; grid-row: 1; }
