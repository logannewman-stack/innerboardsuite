---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import PracticePhone from "../components/PracticePhone.astro";
import QuizPhone from "../components/QuizPhone.astro";
import FlipCards from "../components/FlipCards.astro";
import { LINKS } from "../config/links";

const title = "InnerBoard · Self-leadership from the inside out";
const description =
  "You don't need a different life, just a new way to meet this one. Practice, the daily app. The Academy. INQ Certification. InnerBoard IOS for organizations.";

const features = [
  { name: "Daily Practice Coach", body: "Bring the real moment. Leave with your next move. Trained on the InnerBoard method and the material behind it. It is not a person." },
  { name: "Tools for the moment", body: "STEAR, RAP, Pause + Redirect, the Capacity Edge and more, each small enough for the ninety seconds you actually have." },
  { name: "A check-in and a dare", body: "Set up your day in under a minute. Close it in the evening. One Dare of the Day, read, done, checked off." },
  { name: "The Academy, inside", body: "Every collection, every course, in the same place you practice it. Start with Human Foundations." },
  { name: "InnerLab", body: "Live coaching each month, a community, and real accountability for the work you are already doing." }
];

const quizBenefits = [
  "Eighteen questions about the last thirty days, the way it actually went.",
  "Scored as you answer, with your results shown right away.",
  "No sign-in to see them. Saving them is the moment an account exists.",
  "Retake it anytime. Every result is kept, so you can watch a subscription shrink."
];
---
<Base title={title} description={description} path="/">
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-cream">
    <div class="absolute inset-0 grain opacity-60" aria-hidden="true"></div>
    <div class="absolute -top-32 right-[-12%] w-[720px] h-[720px] rounded-full bg-gold/15 blur-3xl" aria-hidden="true"></div>
    <div class="absolute bottom-[-30%] left-[-10%] w-[520px] h-[520px] rounded-full bg-forest/10 blur-3xl" aria-hidden="true"></div>
    <div class="wrap relative pt-[120px] sm:pt-[150px] pb-10 sm:pb-20">
      <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div class="reveal is-in">
          <p class="eyebrow">InnerBoard</p>
          <h1 class="mt-5 text-[42px] sm:text-[58px] lg:text-[68px] leading-[1.02] text-ink">
            You don't need a different life, <em class="text-gold-ink">just a new way to meet this one.</em>
          </h1>
          <p class="mt-6 max-w-[560px] text-[17px] sm:text-[19px] leading-relaxed text-ink-muted">
            The situation is neutral. What you make it mean is the lever. Practice by InnerBoard is the daily app for pulling it: a coach for the real moment, tools for the reaction, and a check-in short enough to keep.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3 sm:items-center">
            <a href={LINKS.practice} class="btn btn-gold" data-passthrough data-event="practice_click" data-event-location="hero">Start in Practice <Arrow /></a>
            <a href={LINKS.quiz} class="btn btn-outline" data-passthrough data-event="quiz_click" data-event-location="hero">What's Holding You Back?</a>
          </div>
          <p class="mt-4 text-[13.5px] text-ink-faint">A web app, on the home screen of any phone. Nothing to install from a store.</p>
        </div>
        <div class="reveal is-in relative flex justify-center lg:justify-end" style="--d:150ms">
          <div class="hero-scene relative">
            <div class="hero-backdrop absolute inset-0 rounded-[40px]" aria-hidden="true"></div>
            <PracticePhone class="relative z-[1] phone-float" />
            <div class="float-card absolute -left-6 sm:-left-16 bottom-16 card p-4 w-[220px] z-[2]" aria-hidden="true">
              <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-steel">Proof Log</p>
              <p class="mt-1 text-[13px] font-medium text-ink">Had the conversation I had been circling. It took four minutes.</p>
              <p class="mt-2 text-[11px] text-ink-faint">Tuesday · 3 this week</p>
            </div>
            <div class="float-card-2 hidden sm:block absolute -right-4 sm:-right-12 top-24 card p-4 w-[200px] z-[2]" aria-hidden="true">
              <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-steel">STEAR · Reset</p>
              <p class="mt-1 text-[13px] font-medium text-ink">Where you are now</p>
              <p class="mt-1.5 flex gap-1">{[1,2,3,4,5].map((n) => <span class={`w-6 h-6 rounded-full text-[11px] flex items-center justify-center border border-line ${n === 4 ? "bg-ink text-cream" : "text-ink-faint"}`}>{n}</span>)}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Recognition cards ────────────────────────────────────────────── -->
  <section id="recognize" class="bg-cream-2">
    <div class="wrap py-20 sm:py-28">
      <div class="reveal max-w-[720px]">
        <p class="eyebrow">The subscriptions you forgot you had</p>
        <h2 class="mt-4 text-[34px] sm:text-[46px] text-ink">A rule you signed up for years ago. <em>You're still paying for it.</em></h2>
        <p class="mt-5 text-[16.5px] leading-relaxed text-ink-muted">It made you a promise. You stopped reading the bill a long time ago. Flip a card and read what it costs.</p>
      </div>
      <div class="mt-12">
        <FlipCards />
      </div>
    </div>
  </section>

  <!-- ── Practice ─────────────────────────────────────────────────────── -->
  <section id="practice" class="on-dark bg-forest text-cream relative overflow-hidden">
    <div class="absolute -top-40 left-[-10%] w-[600px] h-[600px] rounded-full bg-gold/10 blur-3xl" aria-hidden="true"></div>
    <div class="wrap relative py-20 sm:py-28">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <div class="reveal">
            <p class="eyebrow">Practice by InnerBoard · Live it</p>
            <h2 class="mt-4 text-[34px] sm:text-[48px]">The daily practice, <em>sixty seconds at a time.</em></h2>
            <p class="mt-5 text-[16.5px] leading-relaxed text-on-dark-muted max-w-[520px]">
              Insight is not the constraint and never was. Practice is where the frameworks become what you do when it counts, in the moment, on your phone, before the meeting starts.
            </p>
          </div>
          <div class="reveal mt-10 flex justify-center lg:justify-start gap-6" style="--d:120ms">
            <PracticePhone variant="coach" class="phone-sm" />
            <PracticePhone variant="stear" class="phone-sm hidden sm:block" />
          </div>
        </div>
        <div>
          <ul class="divide-y divide-gold/40">
            {features.map((f, i) => (
              <li class="reveal py-6 first:pt-0" style={`--d:${i * 80}ms`}>
                <h3 class="text-[24px] text-cream">{f.name}</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-on-dark-muted">{f.body}</p>
              </li>
            ))}
          </ul>
          <div class="reveal mt-8 flex flex-col sm:flex-row gap-3 sm:items-center">
            <a href={LINKS.practice} class="btn btn-gold" data-passthrough data-event="practice_click" data-event-location="practice">Start in Practice <Arrow /></a>
            <a href={LINKS.practicePage} class="btn btn-outline-light">See everything inside</a>
          </div>
        </div>
      </div>
      <p class="reveal mt-16 font-display text-[26px] sm:text-[34px] text-center text-gold-soft">Start today, as you are.</p>
    </div>
  </section>

  <!-- ── Subscription quiz ─────────────────────────────────────────────── -->
  <section id="quiz" class="bg-cream">
    <div class="wrap py-20 sm:py-28">
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div class="reveal relative flex justify-center">
          <div class="quiz-scene relative w-full max-w-[520px] aspect-[4/5] sm:aspect-square">
            <div class="absolute inset-0 rounded-[32px] bg-cream-2 grain" aria-hidden="true"></div>
            <div class="book-prop absolute left-[4%] bottom-[8%] w-[46%]" aria-hidden="true">
              <div class="relative aspect-[4/3] rounded-[6px] bg-forest shadow-float rotate-[-6deg]">
                <div class="absolute inset-[7%] border border-gold-soft/50 rounded-[3px]"></div>
                <p class="absolute inset-x-[12%] top-[22%] font-display text-cream text-[clamp(16px,2.6vw,24px)] leading-[1.1]">A Different Way <em>to Meet Life</em></p>
                <p class="absolute left-[12%] bottom-[14%] text-[10px] uppercase tracking-[0.18em] text-gold-soft">Leah Roling</p>
              </div>
              <div class="cup absolute -top-10 right-[-6%] w-[34%] aspect-square rounded-full bg-cream-3 border border-line shadow-card">
                <div class="absolute inset-[18%] rounded-full bg-[#3b2a1f]"></div>
                <div class="absolute inset-[18%] rounded-full bg-[radial-gradient(circle_at_40%_35%,rgba(255,255,255,0.18),transparent_55%)]"></div>
                <div class="absolute right-[-18%] top-[36%] w-[26%] h-[30%] rounded-r-full border-[5px] border-cream-3 border-l-0"></div>
              </div>
            </div>
            <div class="absolute right-[4%] top-[6%] scale-[0.66] sm:scale-[0.78] origin-top-right">
              <QuizPhone />
            </div>
          </div>
        </div>
        <div class="reveal" style="--d:120ms">
          <p class="eyebrow">The subscription quiz</p>
          <h2 class="mt-4 text-[34px] sm:text-[46px] text-ink">What are you <em>subscribing to?</em></h2>
          <p class="mt-5 text-[16.5px] leading-relaxed text-ink-muted max-w-[520px]">
            Everyone has a few. I have to earn my rest. I can't let anyone down. I need to know how this ends first. Dig up the ones you forgot you had, and see what each one is costing you.
          </p>
          <ul class="mt-7 space-y-3">
            {quizBenefits.map((b) => (
              <li class="flex gap-3 text-[15.5px] text-ink-muted"><span class="mt-[9px] w-2 h-2 rounded-full bg-gold shrink-0"></span>{b}</li>
            ))}
          </ul>
          <div class="mt-8">
            <a href={LINKS.quiz} class="btn btn-dark" data-passthrough data-event="quiz_click" data-event-location="quiz">What's Holding You Back? <Arrow /></a>
          </div>
          <p class="mt-3 text-[13px] text-ink-faint">A reflection tool, not a clinical assessment. Opens inside Practice.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Academy ──────────────────────────────────────────────────────── -->
  <section id="academy" class="bg-cream-2 relative overflow-hidden">
    <div class="wrap py-20 sm:py-28">
      <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div class="reveal">
          <p class="eyebrow">InnerBoard Academy · Learn it</p>
          <h2 class="mt-4 text-[34px] sm:text-[48px] text-ink">The curriculum school <em>never offered.</em></h2>
          <p class="mt-5 text-[16.5px] leading-relaxed text-ink-muted max-w-[560px]">
            Self-paced courses in the skills nobody taught you: what to do with a racing mind, a big feeling, a hard conversation. Twelve collections, one direction. Start at the beginning, or start where you are.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3 sm:items-center">
            <a href={LINKS.academy} class="btn btn-dark" data-event="academy_click" data-event-location="academy">Explore Academy <Arrow /></a>
            <a href={LINKS.practicePage} class="btn btn-outline">Explore Practice</a>
          </div>
        </div>
        <div class="reveal" style="--d:120ms">
          <div class="card p-7 sm:p-9 relative overflow-hidden">
            <div class="absolute -right-10 -top-10 w-40 h-40 rounded-full bg-gold/15 blur-2xl" aria-hidden="true"></div>
            <p class="eyebrow">Also included in Practice</p>
            <p class="mt-3 font-display text-[24px] sm:text-[28px] leading-[1.15] text-ink">Every Academy collection opens inside the app, next to the tools that practice it.</p>
            <ul class="mt-6 space-y-3">
              {[
                ["Human Foundations", "Thought, emotion, identity, belief, and the daily practice of self-leadership."],
                ["The Wisdom Collective", "The science underneath why this work works."],
                ["The Certified Mind Method", "The complete method behind INQ Certification."]
              ].map(([n, b]) => (
                <li class="flex gap-3">
                  <span class="mt-2 w-2 h-2 rounded-full bg-gold shrink-0"></span>
                  <p class="text-[15px] text-ink-muted"><span class="font-semibold text-ink">{n}.</span> {b}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── INQ teaser ───────────────────────────────────────────────────── -->
  <section id="inq" class="on-dark bg-navy text-cream relative overflow-hidden">
    <div class="absolute inset-0 opacity-70" style="background-image: linear-gradient(to right, rgba(244,239,228,0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(244,239,228,0.05) 1px, transparent 1px); background-size: 64px 64px; mask-image: radial-gradient(ellipse at 80% 50%, black 20%, transparent 70%);" aria-hidden="true"></div>
    <div class="wrap relative py-20 sm:py-28">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
        <div class="reveal">
          <p class="eyebrow">INQ Certification · Lead it</p>
          <h2 class="mt-4 text-[36px] sm:text-[52px]">Coach the change that <em class="text-gold-2">actually changes people.</em></h2>
          <p class="mt-5 text-[16.5px] leading-relaxed text-on-dark-muted max-w-[560px]">
            Work the surface and you create a session. Work the source and you create change. INQ is the certification for coaches, leaders and practitioners who are finished working the surface.
          </p>
        </div>
        <div class="reveal flex flex-col sm:flex-row lg:flex-col gap-3 lg:items-start" style="--d:120ms">
          <a href={LINKS.inq} class="btn btn-gold" data-event="inq_click" data-event-location="teaser">Explore INQ Certification <Arrow /></a>
          <a href={LINKS.inqBook} class="btn btn-outline-light" data-event="inq_book_click" data-event-location="teaser">Book a Conversation</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Mission ──────────────────────────────────────────────────────── -->
  <section id="mission" class="bg-cream">
    <div class="wrap py-24 sm:py-32">
      <div class="reveal mx-auto max-w-[820px] text-center">
        <p class="eyebrow">Why InnerBoard</p>
        <h2 class="mt-5 text-[38px] sm:text-[56px] text-ink">We believe people are <em>capable of more.</em></h2>
        <p class="mt-6 text-[17px] sm:text-[19px] leading-relaxed text-ink-muted">
          Not more effort. More authorship. Almost all of the exhaustion in life comes from trying to control what was never ours to control. What is ours is how we think, how we feel, how we show up, and the results that follow. InnerBoard exists to teach those four, and to make them a practice rather than an idea.
        </p>
        <p class="mt-6 text-[13px] uppercase tracking-[0.16em] font-semibold text-ink-faint">Founded by Leah Roling</p>
      </div>
    </div>
  </section>

  <!-- ── IOS pathway ──────────────────────────────────────────────────── -->
  <section id="ios" class="on-dark bg-navy-2 text-cream">
    <div class="wrap py-20 sm:py-24">
      <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
        <div class="reveal">
          <p class="eyebrow">InnerBoard IOS · Scale it</p>
          <h2 class="mt-4 text-[32px] sm:text-[44px]">The same work, installed across <em>a whole organization.</em></h2>
          <p class="mt-4 text-[16px] leading-relaxed text-on-dark-muted max-w-[560px]">
            Measure self-leadership in your company with the Company OS Score, develop it one module at a time, and build the leader who holds the standard after the launch.
          </p>
        </div>
        <div class="reveal lg:justify-self-end" style="--d:100ms">
          <a href={LINKS.ios} class="btn btn-gold" rel="noopener" data-event="ios_click" data-event-location="pathway">Explore InnerBoard IOS <Arrow /></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-scene { width: min(100%, 440px); padding: 24px 0; }
  .hero-backdrop { background: linear-gradient(160deg, var(--color-cream-2), var(--color-gold-soft) 60%, var(--color-cream-2)); transform: rotate(-4deg) scale(1.02); }
  .phone-float { margin-inline: auto; animation: float 7s ease-in-out infinite; }
  .float-card { animation: float 9s ease-in-out infinite 1s; }
  .float-card-2 { animation: float 8s ease-in-out infinite 0.5s; }
  @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  .phone-sm { transform: scale(0.82); transform-origin: top center; margin-bottom: -100px; }
  @media (max-width: 420px) { .phone-float { transform: scale(0.9); transform-origin: top center; } .float-card { bottom: 6px; left: 0; } }
  @media (prefers-reduced-motion: reduce) { .phone-float, .float-card, .float-card-2 { animation: none; } }
</style>
