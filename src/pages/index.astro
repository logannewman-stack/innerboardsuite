---
/**
 * innerboardsuite.com, the homepage (BUILD_SPEC 2.1, STORY_V2 part 2).
 *
 * Built to the InnerBoard Suite handoff (October 15, 2026) and the build
 * brief: the copy below is theirs, section by section. Eight sections, in the
 * order the client set on October 20: the hero, the Practice panel (the green
 * panel), the quiz still life, the recognition cards, the typographic Academy,
 * the INQ teaser (where the page turns to evening), the lit mission and the
 * InnerBoard IOS panel. Every image is a real capture of Practice.
 *
 * The hero does not pin: the first notch of scroll moves the page, and the
 * Practice navy panel's top edge shows at the bottom of the first screen. Two scroll
 * stories (site.ts 1.7.19) show the app on the step layout (Story v2): the
 * device pinned on one side with a segmented rail and its "01 / 05" counter,
 * one step's copy at a time on the other, the copy and the screen changing
 * together. The Practice navy panel pins for five steps (one per feature, the phone
 * at the left) and the quiz still life for four (one per benefit, the mat at
 * the right, "Take the Quiz" pinned under the copy the whole time). The scroll
 * position alone moves them; scrolling back plays them backwards. Without the
 * pin (no script, reduced motion, a landscape phone, a short laptop window)
 * every step is on the page, in order, each with its own still screen, and
 * the button follows the four benefits.
 */
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import FlipCards from "../components/FlipCards.astro";
import PhoneFrame from "../components/PhoneFrame.astro";
import StoryMarks from "../components/StoryMarks.astro";
import FeatureIcon from "../components/FeatureIcon.astro";
import Geo from "../components/Geo.astro";
import HomeHeroPlate from "../components/HomeHeroPlate.astro";
import HomeQuizStill from "../components/HomeQuizStill.astro";
import { LINKS } from "../config/links";

const title = "InnerBoard · You don't need a different life";
const description =
  "A few minutes a day to think more clearly, feel more confident, and choose what comes next with a coach in your pocket. Learn it. Live it. Lead it. Practice it.";

/* S2, the Practice navy panel: the phone's frames, in the order the acts index them (STORY_V2 2.3). Frame 0 is the
 * hero's own capture, so the story opens on the screen the reader has just scrolled away from. Every step shows its
 * own screen: the Coach, the Dare, the Academy, Inner Lab, Tools. The Academy and Inner Lab are captures of the live
 * app (October 21, 2026; it has the real courses). Inner Lab is shown down to The Masterclass: its calendar note and
 * the month's resources are not shown, so the frame fades to the app's ivory just under the Masterclass card (a mask
 * on that frame only, PhoneFrame `fade`), keeping the app's own bottom bar, whose Tools tab the next step taps. */
const labFade = "linear-gradient(to bottom, #000 38%, transparent 40.6%, transparent 91.3%, #000 91.8%)";
const panelScreens = [
  { name: "home", alt: "The Coach home as a visitor.", w: 600, h: 1298 },
  { name: "coach-draft", alt: "The Daily Practice Coach with a sentence typed in the composer.", w: 780, h: 1688,
    type: [{ x: 7.8, y: 25.8, w: 55.4, h: 2.55, fill: "#f9f6ee" }, { x: 7.8, y: 28.6, w: 38.8, h: 2.45, fill: "#f9f6ee" }] },
  { name: "dare", alt: "The home after the Dare is checked, with the star line.", w: 600, h: 1298 },
  { name: "academy-courses", alt: "The Academy: learn how your thoughts, feelings, and actions affect everyday life, InnerBoard 101 to start, and the Human Foundations courses, with Academy active in the bottom bar.", w: 780, h: 1688 },
  { name: "lab-masterclass", alt: "Inner Lab for October: live it, practice what you're learning through live sessions and monthly resources, and The Masterclass, open to anybody, with Inner Lab active in the bottom bar.", w: 780, h: 1688, fade: labFade },
  { name: "tools-home", alt: "The Tools hub.", w: 780, h: 1688 },
  { name: "pause-breath", alt: "Pause + Redirect, one breath.", w: 780, h: 1688 }
];
/* The five features, one step each: the eyebrow (the app's own tab, a .story-only label), the icon (FeatureIcon,
 * BRAND_FIX H3), the act (STORY_V2 2.3), the screen in words, and the step's static figure (the Coach's figure is
 * the typed draft). Courses, Live Sessions and Tools each open with the ring on the app's own bottom tab (Academy at
 * x 26.7, Inner Lab 42.2, Tools 88.8, all at y 95.4 of the capture) as the step begins, so the screen changes with
 * the copy; Tools starts from the Inner Lab screen. */
const features = [
  { eyebrow: "Coach", icon: "coach", name: "Daily Practice Coach", body: "Type what is happening, and think it through right when it matters.", w: 1.2,
    alt: "The Daily Practice Coach with a sentence typed in the composer.",
    st: { name: "coach-draft", alt: "The Daily Practice Coach with a sentence typed in the composer.", w: 780, h: 1688 },
    act: '{"panel":{"f":0,"tap":[42,26.6,.18],"next":[.22,1],"type":[.28,.7]}}' },
  { eyebrow: "Coach", icon: "dare", name: "The Daily Dare", body: "One small thing to do before the day ends. A new one every day.", w: 1,
    alt: "The home after the Dare is checked, with the star line.", st: panelScreens[2],
    act: '{"panel":{"f":0,"tap":[19,69.2,.5],"next":[.54,2]}}' },
  { eyebrow: "Academy", icon: "courses", name: "Courses", body: "Go deeper on what you're living, from your thoughts and feelings to relationships and confidence.", w: 1,
    alt: "The ring taps Academy in the app's bottom bar: the Academy, with InnerBoard 101 to start and the Human Foundations courses.", st: panelScreens[3],
    act: '{"panel":{"f":3,"in":[26.7,95.4]}}' },
  { eyebrow: "Inner Lab", icon: "live", name: "Live Sessions and Community", body: "Monthly masterclasses, coaching labs, and a room where nobody has to figure it out alone.", w: 1,
    alt: "The ring taps Inner Lab in the app's bottom bar: Inner Lab for October, with The Masterclass, open to anybody.", st: panelScreens[4],
    act: '{"panel":{"f":4,"in":[42.2,95.4]}}' },
  { eyebrow: "Tools", icon: "tools", name: "Tools for the Moment", body: "For when you're reacting right now: a breath, a reset, and your next move.", w: 1.2,
    alt: "From Inner Lab, the ring taps Tools: the Tools hub, then Pause + Redirect, one breath.", st: panelScreens[6],
    act: '{"panel":{"f":5,"in":[88.8,95.4],"tap":[40,60.2,.52],"next":[.56,6]}}' }
];

/* S3, the quiz still life: one screen per benefit. Question one; the result's top (what's on auto-renew, Approval);
 * the result scrolled to what it's actually costing you and where you're paying; the result scrolled to your first
 * step. The two scrolled screens are the result as the app scrolls it (its header fixed, the body moved up; the
 * capture and its second half joined at 179.56 em, as the strip did), so each step has its own still. */
const quizQ1 = { name: "quiz-q1", alt: "The quiz, question one of eighteen: when I get less done than I planned, I'm disappointed in myself, from Never to Almost always.", w: 600, h: 1298 } as const;
const quizResult = { name: "quiz-results", alt: "The quiz result: here's what's on auto-renew, Approval, and what you're paying for: if everyone's happy with me, I'll be okay.", w: 600, h: 1298 } as const;
const quizCost = { name: "quiz-cost", alt: "The quiz result scrolled to what it's actually costing you, then where you're paying: health, relationships and money.", w: 600, h: 1298 } as const;
const quizStep = { name: "quiz-first-step", alt: "The quiz result scrolled to your first step: buy yourself a beat, decide what you actually want, then answer with that.", w: 600, h: 1298 } as const;
const quizBenefits = [
  { name: "4 minutes to complete", body: "Quick, simple, and insightful.", alt: quizQ1.alt, fig: quizQ1, w: 1,
    act: '{"quiz":{"f":0}}' },
  { name: "Personalized results", body: "See what might be auto-renewing in your life.", alt: quizResult.alt, fig: quizResult, w: 1,
    act: '{"quiz":{"f":1}}' },
  { name: "Discover the unseen cost", body: "What it could be costing you in time, energy, confidence, peace, and relationships.", alt: quizCost.alt, fig: quizCost, w: 1,
    act: '{"quiz":{"f":2}}' },
  { name: "One thing to do differently", body: "Your gift: a simple next step you can try right away.", alt: quizStep.alt, fig: quizStep, w: 1.2,
    act: '{"quiz":{"f":3}}' }
];
---
<Base title={title} description={description} path="/"
  preload={{ href: "/app/home.webp", srcset: "/app/home-390.webp 390w, /app/home.webp 600w", sizes: "400px", type: "image/webp" }}>
  <!-- 1. Hero: the copy and the phone on the Coach home, one first screen. It does not pin; it ends 40 px above the
       fold, so the Practice navy panel's top edge shows under it (STORY_V2 2.2). -->
  <section class="hm-hero grain grain-cream" data-tone="cream">
    <i class="lamp lamp-cream" aria-hidden="true" style="--lx:50%;--ly:0%"></i>
    <div class="wrap hm-hero-wrap">
      <div class="grid">
        <div class="hm-hero-copy">
          <p class="eyebrow rise" style="--d:.45s">Practice by InnerBoard</p>
          <h1 data-lines class="t-xl hm-h1"><span class="hl">You don't need a different life,</span> <em class="hl">just a new way to meet this one.</em></h1>
          <p class="t-lead hm-lead rise" style="--d:.52s">A few minutes a day to think more clearly, feel more confident, and choose what comes next with a coach in your pocket.</p>
          <div class="hm-btns hm-hero-btns rise" style="--d:.6s">
            <a href={LINKS.practice} class="btn btn-gold" data-passthrough data-event="practice_click" data-event-location="hero">Start in Practice <Arrow /></a>
            <a href={LINKS.quiz} class="btn btn-line" data-passthrough data-event="quiz_click" data-event-location="hero">What's Holding You Back?</a>
          </div>
        </div>
      </div>
    </div>
    <HomeHeroPlate />
  </section>

  <!-- 2. Practice: the Practice navy panel. The phone pins at the left with the rail; one feature's copy at a time at the
       right, five steps (STORY_V2 2.3). The buttons follow the story with the closing line. -->
  <section id="practice" class="hm-practice" data-tone="cream">
    <div class="wrap-wide panel-practice grain surface-practice hm-panel" data-surface="dark">
      <i class="lamp" aria-hidden="true" style="--lx:18%;--ly:0%;--la:.07"></i>
      <div class="hm-panel-in">
        <div class="hm-panel-grid">
          <div class="hm-panel-head">
            <p class="eyebrow rise">Practice by InnerBoard</p>
            <h2 class="t-m wipe hm-panel-h2">A different way to meet <em>whatever life brings.</em></h2>
          </div>
          <p class="t-lead hm-panel-lead rise" style="--d:.28s">A daily practice coach with personalized insight, real-time support, and tools to help you think differently, feel differently, and choose what's next.</p>
        </div>
        <div class="story hm-panel-story" data-story="practice" data-story-ui="steps" data-side="left" data-kind="phone" data-warm style="--story-w:5.4;--step-l:64svh;--step-l-n:58svh">
          <div class="story-track">
            <div class="story-stage">
              <i class="lamp hm-stage-lamp" aria-hidden="true" style="--lx:30%;--ly:50%;--la:.16"></i>
              <div class="story-device-col">
                <StoryMarks variant="rail" labels={features.map((f) => f.name)} label="Practice, feature by feature" />
                <div class="story-device-box story-phone hm-panel-phone floor-on" style="--pw-max:320px;--pw-max-n:240px">
                  <PhoneFrame device="panel" width={320} style="--pw:inherit" shadow="dark" label="Practice on a phone, feature by feature."
                    screens={panelScreens} />
                </div>
              </div>
              <div class="story-copy">
                <ol class="story-steps ladder ladder-gold hm-ladder" role="list">
                  {features.map((f, i) => (
                    <li class="story-step" data-step={i} data-w={f.w} data-act={f.act}>
                      <FeatureIcon name={f.icon} class="hm-ico hm-row-ico" />
                      <p class="eyebrow story-eyebrow story-only" aria-hidden="true"><FeatureIcon name={f.icon} class="hm-ico" />{f.eyebrow}</p>
                      <div class="hm-row">
                        <p class="ladder-name story-h">{f.name}</p>
                        <p class="ladder-body story-body">{f.body}</p>
                        <span class="sr-only story-alt">{f.alt}</span>
                      </div>
                      {f.st && <div class="story-static floor-on"><PhoneFrame width={200} shadow="dark" screens={[f.st]} /></div>}
                    </li>
                  ))}
                </ol>
              </div>
            </div>
            <div class="story-run" aria-hidden="true"></div>
          </div>
        </div>
        <div class="rule-gold hm-panel-rule" aria-hidden="true"></div>
        <div class="hm-panel-foot">
          <div class="hm-panel-close rise">
            <p class="t-s hm-panel-close-line">Start today, <em>as you are.</em></p>
            <p class="t-body hm-panel-close-body">Bring what's happening in your life right now. We'll help you take the next step.</p>
          </div>
          <div class="hm-btns hm-panel-btns rise" style="--d:.3s">
            <a href={LINKS.practice} class="btn btn-gold" data-passthrough data-event="practice_click" data-event-location="practice">Start in Practice <Arrow /></a>
            <a href={LINKS.practicePage} class="btn btn-line">See everything inside</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. The subscription quiz: the head, then the story: one benefit's copy at a time at the left with "Take the
       Quiz" pinned under it, the mat with the phone and the toggle card at the right, four steps (STORY_V2 2.4);
       then the closing line. -->
  <section id="quiz" class="hm-quiz" data-tone="cream">
    <div class="wrap">
      <div class="grid">
        <div class="hm-quiz-head">
          <p class="eyebrow rise">The subscription quiz</p>
          <h2 class="t-m wipe">What's costing you <em>more than you think?</em></h2>
          <div class="t-lead hm-stack hm-quiz-lead">
            <p class="rise">You know those subscriptions you forgot about, but they're still on auto-renew?</p>
            <p class="rise" style="--d:.28s">What if you're doing the same thing in your life?</p>
            <p class="rise" style="--d:.36s">Except these subscriptions aren't charging your credit card. They're costing you time, energy, confidence, peace, and connection.</p>
          </div>
        </div>
      </div>
      <div class="story hm-quiz-story" data-story="home-quiz" data-story-ui="steps" data-side="right" data-kind="mat" data-warm style="--story-w:4.2;--step-l:64svh;--step-l-n:58svh">
        <div class="story-track">
          <div class="story-stage">
            <div class="story-device-col">
              <StoryMarks variant="rail" labels={quizBenefits.map((b) => b.name)} label="The subscription quiz, benefit by benefit" />
              <HomeQuizStill screens={[quizQ1, quizResult, quizCost, quizStep]} />
            </div>
            <div class="story-copy">
              <ul class="story-steps hm-benefits" role="list">
                {quizBenefits.map((b, i) => (
                  <li class="story-step" data-step={i} data-w={b.w} data-act={b.act}>
                    <p class="eyebrow story-eyebrow story-only story-repeat" aria-hidden="true">The subscription quiz</p>
                    <b class="t-title story-h">{b.name}</b>
                    <p class="t-body story-body">{b.body}</p>
                    <span class="sr-only story-alt">{b.alt}</span>
                    {b.fig && <div class="story-static floor-on"><PhoneFrame width={200} screens={[b.fig]} /></div>}
                  </li>
                ))}
              </ul>
              <div class="story-cta hm-quiz-cta">
                <a href={LINKS.quiz} class="btn btn-gold" data-passthrough data-event="quiz_click" data-event-location="quiz">Take the Quiz <Arrow /></a>
              </div>
            </div>
          </div>
          <div class="story-run" aria-hidden="true"></div>
        </div>
      </div>
      <p class="hm-quiz-closing rise" style="--d:.2s">It's time to cancel what's no longer serving you.</p>
    </div>
  </section>

  <!-- 4. Recognition cards, on the linen band (BRAND_FIX H0): the four cards and the closing line, which now answers
       the green panel's heading. Not a story. -->
  <section id="recognize" class="hm-recognize sec-alt" data-tone="cream">
    <div class="wrap">
      <h2 class="t-l wipe hm-recognize-h2">On paper, <em>it all looks fine.</em></h2>
      <FlipCards class="hm-flips" />
    </div>
  </section>

  <!-- 5. Academy: typographic, with the italic deck and the paper note -->
  <section id="academy" class="hm-academy" data-tone="cream">
    <div class="wrap hm-academy-wrap">
      <div class="grid">
        <div class="hm-academy-head">
          <p class="eyebrow rise">Academy | Courses to own</p>
          <h2 class="t-l wipe">Go deeper into the skills <em>that change everything.</em></h2>
        </div>
      </div>
      <div class="grid hm-academy-grid">
        <p class="t-lead hm-academy-body rise">Practical, transformational learning for real life. Buy the courses you want. Keep them forever.</p>
        <div class="hm-deck rise" style="--d:.24s">
          <i class="rule-draw" aria-hidden="true"></i>
          <p class="t-s-pull hm-deck-line">Explore courses in thinking, feeling, and leading differently.</p>
          <i class="rule-draw" aria-hidden="true" style="--d:.15s"></i>
        </div>
        <div class="hm-btns hm-academy-btns rise" style="--d:.3s">
          <a href={LINKS.academy} class="btn btn-gold" data-event="academy_click" data-event-location="academy">Explore Academy <Arrow /></a>
          <a href={LINKS.practice} class="btn btn-line" data-passthrough data-event="practice_click" data-event-location="academy">Explore Practice</a>
        </div>
        <div class="paper hm-note rise" style="--d:.2s">
          <p class="eyebrow">Also included in Practice</p>
          <p class="t-body hm-note-body">Get access to these courses with a paid Practice subscription, alongside your daily coach, live sessions, and tools for the moment.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. INQ Certification teaser: a navy bleed, the page turns to evening -->
  <section id="inq" class="hm-inq" data-tone="slate">
    <i class="lamp grain" aria-hidden="true" style="--lx:85%;--ly:0%"></i>
    <Geo class="hm-geo-inq" color="#f2ece0" opacity={0.08} ringsOnly />
    <div class="wrap grid">
      <div class="hm-inq-copy">
        <p class="eyebrow rise">INQ Certification | Lead it</p>
        <h2 class="t-l wipe">Coach the change that <em>actually changes people.</em></h2>
        <p class="t-lead hm-inq-lead rise">A science-informed certification in human behavior, neuroscience, emotional intelligence, and habit change.</p>
        <p class="t-lead hm-inq-lead hm-inq-lead-2 rise" style="--d:.3s">Gain the confidence to create meaningful results for your clients, apply the work to your own life, and build a coaching business around the impact you make.</p>
      </div>
      <i class="rule-gold-v rule-draw-v hm-inq-rule" aria-hidden="true"></i>
      <div class="hm-inq-btns rise" style="--d:.24s">
        <a href={LINKS.inq} class="btn btn-gold" data-event="inq_click" data-event-location="teaser">Explore INQ Certification <Arrow /></a>
        <a href={LINKS.inqBook} class="btn btn-line" data-event="inq_book_click" data-event-location="teaser">Book a Conversation</a>
      </div>
    </div>
  </section>

  <!-- 7. Why InnerBoard exists: the lit mission -->
  <section id="mission" class="hm-mission" data-tone="cream">
    <div class="wrap">
      <div class="hm-mission-in">
        <p class="eyebrow rise">Why InnerBoard exists</p>
        <h2 class="t-l wipe hm-mission-h2">We believe people are capable of more.</h2>
        <p class="t-s-pull hm-mission-sub rise">Sometimes they just need a different way forward.</p>
        <div class="t-state hm-mission-lit" data-lit>
          <p><b class="lb">InnerBoard was built on a simple belief:</b> the way we think, feel, and respond shapes the way we experience our lives.</p>
          <p><b class="lb">And those aren't things we're stuck with.</b> They're skills we can learn, strengthen, and practice.</p>
          <p><b class="lb">Our mission</b> is to make that kind of growth accessible, practical, and part of everyday life, so more people can become who they're capable of being.</p>
        </div>
        <p class="t-s hm-mission-close" data-lit="lines" data-lit-step="120"><span class="lw">Learn it.</span> <span class="lw">Live it.</span> <span class="lw">Lead it.</span> <em class="lw">Practice it.</em></p>
      </div>
    </div>
  </section>

  <!-- 8. InnerBoard IOS: the navy panel, the page's last and largest action -->
  <section id="ios" class="hm-ios" data-tone="cream">
    <div class="wrap-wide panel-navy grain hm-ios-panel" data-surface="dark">
      <i class="lamp" aria-hidden="true" style="--lx:12%;--ly:72%;--la:.12"></i>
      <Geo class="hm-geo-ios" color="#f2ece0" opacity={0.08} ringsOnly />
      <div class="hm-ios-in">
        <div class="hm-ios-copy">
          <i class="rule-gold-v rule-draw-v hm-ios-rule" aria-hidden="true"></i>
          <p class="eyebrow rise">InnerBoard IOS | Scale it</p>
          <h2 class="t-m wipe hm-ios-h2">Imagine what happens when <em class="grad">an entire team grows.</em></h2>
          <p class="t-lead hm-ios-lead rise">Personal growth changes how one person shows up. Imagine what becomes possible when an entire organization learns to think differently, lead themselves, and bring their best to work.</p>
          <p class="t-lead hm-ios-lead hm-ios-lead-2 rise" style="--d:.3s">InnerBoard IOS brings a people operating system into organizations, helping build the confidence, capability, and accountability that strengthen culture and drive results.</p>
        </div>
        <div class="hm-ios-btn rise" style="--d:.36s">
          <a href={LINKS.ios} class="btn btn-gold btn-lg" rel="noopener" data-event="ios_click" data-event-location="pathway">Explore InnerBoard IOS <Arrow /></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* Homepage layout (BUILD_SPEC 2.1, with the art director's round one punch list applied, STORY_V2 part 2 for the
   * order and the two step layout stories, BRAND_FIX part 3 for the page's brand fixes). Every number is from the
   * specs or the punch list; the system's tokens, classes and components do the rest. Prefixed hm- so the rules
   * never reach a shared component: where the page needs a shared component to look different (the flip cards,
   * the toggle card, the geo, the ladder rows) it says so here, scoped under an hm- class.
   *
   * Stories: the static layout (no script, reduced motion, a landscape phone, a short laptop window) is the
   * default CSS below; every pinned rule sits inside the story media queries of site.ts (STORY_MQ), scoped
   * `.js .hm-...-story:not(.static)`, so the static layout is never touched by them, and where a static rule would
   * reach the pinned layout (a grid template, a margin) a pinned rule puts it back. The step layout itself (the
   * grid, the device column, the rail, the copy change, the roles) is the system's (motion.css, Story v2). A device
   * box is hidden in the static layout by the system, so no rule here sets `display` on one outside those queries.
   * Pinned queries:
   *   wide        (prefers-reduced-motion: no-preference) and (min-width: 1069px) and (min-height: 600px)
   *   narrow      (prefers-reduced-motion: no-preference) and (max-width: 1068px) and (min-height: 560px)
   *   side        the part of narrow from 900 to 1068 (a landscape tablet): laid out side by side like wide
   *   column      the part of narrow up to 899: one column, the device over the copy */

  /* A site-wide guard against sideways scroll (audit 2, P1), scoped to this page; the shared equivalent belongs
   * in global.css (reported to the system engineer). `clip` is not a scroll container, so the pins still work. */
  html { overflow-x: clip; }

  /* ── 1. Hero (STORY_V2 2.2) ───────────────────────────────────────── */
  /* One composition in every case (script, no script, reduced motion). Laptops and landscape tablets (900 and up):
   * the first screen less 40 px, the copy in columns 1 to 7, the phone on the Coach home at the right, its right
   * edge on the content edge, centred between the header line and the hero's bottom (40 px kept for its floor
   * shadow), so it no longer hangs past the fold and the Practice navy panel's lit top edge shows in the last 40 px.
   * Tablets and phones (under 900): the copy, then the phone under it, then the panel. The hero is its own
   * stacking context, so the phone's long shadow passes under the panel that follows. */
  .hm-hero { position: relative; isolation: isolate; padding: var(--nav-h) 0 40px; overflow: visible; }
  .hm-hero > .lamp { z-index: 0; }
  /* The lamp's gold foot and the grain fade out before the hero's bottom edge, so the hero ends in the page's
   * cream rather than on a line. */
  .hm-hero > .lamp-cream, .hm-hero.grain::after { -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 96px), transparent); mask-image: linear-gradient(to bottom, #000 calc(100% - 96px), transparent); }
  .hm-hero-wrap { position: relative; z-index: 2; }
  .hm-hero-copy { grid-column: 1 / span 7; padding-top: 90px; }
  .hm-h1 { max-width: 7.8em; margin: 0; }
  .hm-lead { margin-top: 28px; color: var(--fg-2); }
  .hm-btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .hm-hero-btns { margin-top: 36px; }
  .hm-hero-phone { position: relative; z-index: 3; }
  .hm-hero-phone .phone { box-shadow: inset 0 0 0 .55em #0c0b09, inset 0 0 0 .9em rgba(255,255,255,.06), 0 0 0 1px rgba(90,40,50,.18),
    0 2px 4px rgba(31,29,26,.14), 0 24px 40px -16px rgba(31,29,26,.34), 0 90px 120px -50px rgba(31,29,26,.5); }
  .hm-hero-phone .phone-floor { --floor-a: .38; }
  @media (min-width: 900px) {
    .hm-hero { min-height: max(640px, calc(100vh - 40px)); min-height: max(640px, calc(100svh - 40px)); padding-bottom: 0; }
    .hm-hero-copy { padding-top: clamp(24px, 6vh, 90px); padding-top: clamp(24px, 6svh, 90px); }
    /* 311 wide at 1440 x 900, 252 at 1366 x 768, 240 at 1280 x 720. */
    .hm-hero-phone { --pw: clamp(240px, min(26.5vw, calc((100svh - var(--nav-h) - 136px) / 2.224)), 400px); position: absolute;
      top: var(--nav-h); bottom: 40px; margin-block: auto; width: calc(var(--pw) * 1.06); height: calc(var(--pw) * 2.224);
      left: calc(100% - var(--edge) - var(--pw) * 1.06); }
  }

  /* ── 2. The Practice navy panel (STORY_V2 2.3) ───────────────────────────── */
  /* Row one: the h2 at the left, the lead beside it at the right on the same last baseline. Then the story: the
   * phone and its rail at the left, one feature at a time at the right, pinned while the reader scrolls through
   * the five. The panel's full width gold rule runs under the story, then the closing line and the buttons. The
   * panel is the first thing under the hero, so the section has no top padding. */
  .hm-practice { padding-top: 0; padding-bottom: var(--sec); }
  .hm-panel { padding: 72px 80px; }
  .hm-panel-in { position: relative; z-index: 1; }
  .hm-panel-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); }
  .hm-panel-head { grid-column: 1 / span 7; grid-row: 1; align-self: last baseline; }
  .hm-panel-h2 { color: #f2ece0; }
  .hm-panel-lead { grid-column: 8 / span 5; grid-row: 1; align-self: last baseline; color: #cdc6b8; max-width: 28em; margin: 0; }
  .hm-panel-story { margin-top: 48px; }
  /* The panel's lamp, moved into the stage behind the pinned phone: shown only while the story is pinned. */
  .hm-panel-story .story-stage > .hm-stage-lamp { display: none; }
  .js .hm-panel-story.is-live:not(.static) .story-stage > .hm-stage-lamp { display: block; }
  /* The features' icons (FeatureIcon, BRAND_FIX H3): gold-2 on the Practice navy; in the static ladder each row leads
   * with its icon, in the pinned step it sits on the eyebrow line in place of the dot. */
  .hm-ico { width: 22px; height: 22px; color: #a8757e; flex: none; }
  /* Static: the ladder of five, icon led, between thin gold rules, each row with its own still screen (the Coach
   * with the draft, the Dare checked, the Academy, Inner Lab, one breath). */
  .hm-ladder { --row-pad: 26px; position: relative; }
  .hm-ladder > li { grid-template-columns: 22px minmax(0, 1fr); column-gap: 18px; padding-block: var(--row-pad); }
  .hm-ladder > li:last-child { padding-bottom: var(--row-pad); }
  .hm-ladder > li > .hm-row { min-width: 0; }
  .hm-row-ico { display: block; margin-top: calc((var(--fs-title) * 1.2 - 22px) / 2); }
  .hm-ladder .ladder-name { color: #f2ece0; }
  .hm-ladder .ladder-body { color: #cdc6b8; }
  .hm-ladder > li > .story-static { grid-column: 2; margin-top: 20px; }
  .hm-panel-rule { margin-block: 56px 48px; }
  .hm-panel-foot { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); align-items: end; }
  .hm-panel-close { grid-column: 1 / span 7; }
  .hm-panel-close-line { color: #f2ece0; }
  .hm-panel-close-body { color: #cdc6b8; margin-top: 12px; }
  .hm-panel-btns { grid-column: 8 / span 5; justify-content: flex-end; }
  @media (min-width: 1069px) {
    /* Static on a laptop: the row's still screen at its right. */
    .hm-ladder > li:has(> .story-static) { grid-template-columns: 22px minmax(0, 1fr) auto; }
    .hm-ladder > li > .story-static { grid-column: 3; grid-row: 1; margin: 0 0 0 28px; }
  }
  @media (min-width: 1280px) {
    /* Static on a wide laptop: the five features side by side, each over its still screen (every row a two row
     * subgrid, so the screens start on one line), the phone as wide as its column allows (!important: PhoneFrame
     * writes its width inline). */
    .hm-ladder { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); grid-template-rows: auto auto; column-gap: var(--gap); }
    .hm-ladder > li, .hm-ladder > li:has(> .story-static) { grid-row: span 2; grid-template-rows: subgrid; grid-template-columns: 22px minmax(0, 1fr); row-gap: 0; }
    .hm-ladder > li > .story-static { grid-column: 1 / -1; grid-row: 2; margin: 28px 0 0; }
    .hm-ladder > li > .story-static .phone { --pw: min(200px, calc((min(94.4vw, var(--max-wide)) - 160px - 4 * var(--gap)) / 5.3 - 2px)) !important; }
  }

  /* ── 3. The quiz still life (STORY_V2 2.4) ────────────────────────── */
  /* The head first (columns 1 to 8), then the story: one benefit at a time at the left with the gold button under
   * it, the mat at the right with the phone and the toggle card; then the closing line. */
  .hm-quiz { padding-block: var(--sec); }
  .hm-quiz-head { grid-column: 1 / span 8; }
  .hm-stack p + p { margin-top: 1em; }
  .hm-quiz-lead { color: var(--fg-2); max-width: 28em; margin-top: var(--lead-gap); }
  .hm-quiz-story { margin-top: var(--head-gap); }
  /* The mat, when the story shows it (it is the device box, so the system hides it in the static layout): the
   * phone and the toggle card stand side by side, the card tucked 12 px behind the phone's lower left (toward the
   * copy), so its six switches and the gold on state show (ToggleCard is shared; its placement is the page's). */
  .hm-mat { justify-content: center; align-items: flex-end; padding-bottom: 22px; }
  .hm-quiz-phone { position: relative; flex: none; z-index: 2; }
  .hm-tcard { position: relative; flex: none; z-index: 1; margin: 0 -12px 26px 0; width: clamp(186px, calc(6 * var(--colw) + 5 * var(--gap) - 320px), 236px); box-shadow: var(--sh-paper), 0 18px 30px -18px rgba(31,29,26,.35); }
  .no-js .hm-tcard { transform: rotate(-5deg); }
  /* The Approval switch (the card's second row) follows the scroll: it turns off from G 3.62 to 3.72, while the
   * phone shows the result's first step. The knob moves by transform and the gold is an opacity layer (BRAND_FIX S8);
   * with --g unset (static, no script) it is on, as the card draws it. */
  .hm-tcard .tcard-row:nth-child(2) .tg { --on: calc(1 - clamp(0, (var(--g, 0) - 3.62) / .1, 1)); background: #d9cfbe; }
  .hm-tcard .tcard-row:nth-child(2) .tg::before { content: ""; position: absolute; inset: 0; border-radius: inherit; background: #7a3a4a; box-shadow: inset 0 1px 2px rgba(31,29,26,.18); opacity: var(--on); }
  .hm-tcard .tcard-row:nth-child(2) .tg::after { left: 2px; transform: translateX(calc(var(--on) * 16px)); }
  /* Static: the four benefits side by side, each with its own still screen (the question, the result, its cost, its
   * first step); names, bodies and screens each start on one line (every item is a three row subgrid). Then the button
   * (the story's .story-cta, in flow after the steps) and the closing line on its own row under it. */
  .hm-benefits { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--gap); row-gap: 0; }
  .hm-benefits > li { display: grid; grid-row: span 3; grid-template-rows: subgrid; row-gap: 6px; align-content: start; }
  .hm-benefits b { display: block; text-wrap: balance; }
  .hm-benefits .t-body { color: var(--fg-2); margin: 0; }
  .hm-benefits .story-static { margin-top: 18px; }
  .hm-quiz-story.static .hm-quiz-cta, .no-js .hm-quiz-story .hm-quiz-cta { margin-top: 48px; }
  .hm-quiz-closing { font-family: var(--font-display); font-style: italic; font-weight: 400; font-size: 16px; line-height: 1.4; color: var(--fg-2); margin: 16px 0 0; max-width: none; }
  @media (min-width: 1069px) { .hm-quiz-closing { white-space: nowrap; } }

  /* ── 4. Recognition (STORY_V2 2.5) ────────────────────────────────── */
  /* After the quiz now, on the linen band, a section of padding above and below (the hero no longer hangs a
   * phone onto the section after it). Every front carries its "Sound familiar?" eyebrow, as every back carries
   * "Another way" (BRAND_FIX S7). */
  .hm-recognize { padding-block: var(--sec); }
  .hm-recognize-h2 { max-width: calc(7 * var(--colw) + 6 * var(--gap)); }
  .hm-flips { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); margin-top: var(--head-gap); }
  .hm-flips > li:nth-child(1) { grid-column: 1 / span 5; }
  .hm-flips > li:nth-child(2) { grid-column: 7 / span 5; margin-top: 96px; }
  .hm-flips > li:nth-child(3) { grid-column: 2 / span 5; margin-top: -24px; }
  .hm-flips > li:nth-child(4) { grid-column: 8 / span 5; margin-top: 72px; }
  /* Tighter cards (FlipCards is shared, so this is scoped): the face hugs its words, the quote sits 18 px under
   * the eyebrow and the cue is pinned to the bottom. */
  .hm-flips .flip-inner, .hm-flips .flip-face { min-height: 248px; }
  .hm-flips .flip-face { justify-content: flex-start; gap: 0; padding: 32px 32px 28px; }
  .hm-flips .flip-quote { font-size: clamp(26px, 2.2vw, 34px); margin-top: 18px; }
  .hm-flips .flip-reframe { margin-top: 18px; }
  .hm-flips .flip-cue { margin-top: auto; padding-top: 28px; }
  .hm-recognize .flip-close { max-width: calc(8 * var(--colw) + 7 * var(--gap)); }

  /* ── 5. Academy ───────────────────────────────────────────────────── */
  /* One top line: the deck's rule and the note card start together, and the
   * body's first line sits level with the deck's first italic line. The
   * buttons follow the body at 28; the deck's lower rule lands level with the
   * note card's last line. */
  .hm-academy-wrap { border-top: 1px solid var(--line); padding-block: var(--sec); }
  .hm-academy-head { grid-column: 1 / span 9; }
  .hm-academy-grid { margin-top: var(--head-gap); row-gap: 0; grid-template-rows: auto auto 1fr; align-items: start; }
  .hm-academy-body { grid-column: 1 / span 4; grid-row: 1; color: var(--fg-2); max-width: 24em; padding-top: 21px; }
  .hm-academy-btns { grid-column: 1 / span 4; grid-row: 2; margin-top: 28px; align-self: start; }
  .hm-deck { grid-column: 6 / span 3; grid-row: 1 / -1; align-self: stretch; display: flex; flex-direction: column; gap: 20px; margin-bottom: 28px; }
  .hm-deck .rule-draw { display: block; flex: none; height: 1px; background: var(--line); }
  .hm-deck .rule-draw:last-child { margin-top: auto; }
  .hm-deck-line { color: var(--accent); line-height: 1.2; }
  .hm-note { grid-column: 10 / span 3; grid-row: 1 / -1; align-self: stretch; display: flex; flex-direction: column; justify-content: space-between; padding: 28px; }
  .hm-note-body { color: var(--fg-2); }

  /* ── 6. INQ teaser ────────────────────────────────────────────────── */
  /* Ring only (Geo ringsOnly; the crosshair and the dot are also hidden here
   * in case the prop is ever dropped), its centre off the section: one
   * quarter arc enters the top right, above the buttons, and the margin rule
   * stays the only vertical. */
  .hm-inq { padding-block: var(--sec-l); overflow: hidden; --line-gold: rgba(212,175,55,.4); }
  .hm-geo-inq path, .hm-geo-inq .dot, .hm-geo-ios path, .hm-geo-ios .dot { display: none; }
  /* Centre 100 px right of the section and 160 px above it: a 350 x 310 arc,
   * at least 44 px clear of every line and button from 1069 to 1920. */
  .hm-geo-inq { right: -650px; top: -710px; z-index: 0; }
  .hm-inq-copy { grid-column: 1 / span 8; grid-row: 1; }
  .hm-inq-lead { color: var(--fg-2); max-width: 28em; margin-top: 28px; }
  .hm-inq-lead-2 { margin-top: 1em; }
  .hm-inq-rule { grid-column: 9 / span 1; grid-row: 1; justify-self: start; align-self: stretch; display: block; }
  .hm-inq-btns { grid-column: 10 / span 3; grid-row: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; align-self: end; }

  /* ── 7. Mission ───────────────────────────────────────────────────── */
  /* Set from the left on columns 2 to 10 (x 222 at 1440), not centred. */
  .hm-mission { padding-block: var(--sec-l); }
  .hm-mission-in { max-width: calc(9 * var(--colw) + 8 * var(--gap)); margin-left: calc(var(--colw) + var(--gap)); text-align: start; }
  .hm-mission-h2 { text-wrap: balance; }
  .hm-mission-sub { color: var(--accent); margin: 16px 0 0; text-wrap: balance; }
  .hm-mission-lit { margin: 48px 0 0; max-width: 22em; text-wrap: pretty; }
  .hm-mission-lit p + p { margin-top: 1em; }
  .hm-mission-close { margin: 56px 0 0; }

  /* ── 8. InnerBoard IOS ────────────────────────────────────────────── */
  /* Ring only, its centre above the panel: an arc hangs from the top edge on
   * the right, clear of the copy and the button. */
  .hm-ios { padding-block: var(--sec); }
  .hm-ios-panel { padding: 96px 80px 88px; }
  .hm-geo-ios { right: -400px; top: -850px; z-index: 0; }
  .hm-ios-in { position: relative; z-index: 1; isolation: isolate; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); }
  .hm-ios-copy { grid-column: 1 / span 7; position: relative; }
  .hm-ios-rule { position: absolute; left: -32px; top: 0; bottom: 0; display: block; }
  .hm-ios-h2 { color: #f2ece0; }
  .hm-ios h2 em.grad { color: transparent; -webkit-text-fill-color: transparent; }
  .hm-ios-lead { color: #cdc6b8; max-width: 28em; margin-top: var(--lead-gap); }
  .hm-ios-lead-2 { margin-top: 1em; }
  .hm-ios-btn { grid-column: 9 / span 4; align-self: end; justify-self: end; }
  /* The panel keeps the InnerBoard IOS site's own navy and honey, so it matches the site it opens. */
  .hm-ios .hm-ios-panel { --accent: #e4b676; --focus: #e4b676; --line-gold: rgba(228,182,118,.35); }
  .hm-ios .hm-ios-panel > .lamp { background: radial-gradient(55% 60% at var(--lx, 18%) var(--ly, 0%), rgba(228,182,118,var(--la, .16)), transparent 70%); }
  .hm-ios h2 em.grad { background-image: linear-gradient(100deg, #f1dcb4 0%, #e4b676 48%, #c99a5b 100%); }
  .hm-ios .hm-ios-panel .btn.btn-gold { background: #e4b676; color: #1b1916; }
  @media (hover: hover) and (pointer: fine) { .hm-ios .hm-ios-panel .btn.btn-gold:hover { background: #ecc58e; } }

  /* ── Tablet (735 to 1068) ─────────────────────────────────────────── */
  @media (max-width: 1068px) {
    .hm-flips { grid-template-columns: 1fr 1fr; gap: 24px; }
    .hm-flips > li { grid-column: auto !important; margin-top: 0 !important; }
    .js .hm-flips > li.slide-l.rise:not(.in) { transform: translate(-24px, 16px); }
    .js .hm-flips > li.slide-r.rise:not(.in) { transform: translate(24px, 16px); }
    .hm-panel { padding: 56px 40px; }
    .hm-panel-grid { grid-template-columns: minmax(0, 1fr); row-gap: 0; }
    .hm-panel-head, .hm-panel-lead { grid-column: 1 / -1; grid-row: auto; align-self: auto; }
    .hm-panel-lead { margin-top: var(--lead-gap); }
    .hm-panel-story { margin-top: 40px; }
    .hm-panel-close { grid-column: 1 / -1; }
    .hm-panel-rule { margin-block: 40px; }
    .hm-panel-btns { grid-column: 1 / -1; justify-content: flex-start; margin-top: 28px; }
    .hm-quiz-head { grid-column: 1 / -1; }
    .hm-benefits { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 40px; }
    .hm-tcard { width: 236px; }
    .hm-academy-head { grid-column: 1 / -1; }
    .hm-academy-grid { grid-template-rows: auto auto; }
    .hm-academy-body { grid-column: 1 / span 6; }
    .hm-academy-btns { grid-column: 1 / span 6; }
    .hm-deck { grid-column: 7 / span 6; grid-row: 1; align-self: start; margin-bottom: 0; }
    .hm-note { grid-column: 7 / span 6; grid-row: 2; align-self: start; margin-top: 36px; }
    .hm-geo-inq, .hm-geo-ios { right: -700px; top: -900px; }
    .hm-ios-panel { padding: 64px 40px; }
    .hm-ios-copy { grid-column: 1 / -1; }
    .hm-ios-btn { grid-column: 1 / -1; justify-self: start; margin-top: 36px; }
    .hm-mission-in { margin-left: 0; }
  }
  /* A landscape tablet (900 to 1068): the INQ teaser keeps the desktop's composition, the copy at the left, the
   * margin rule, the buttons stacked at the right (audit 2, P2). */
  @media (min-width: 900px) and (max-width: 1068px) {
    .hm-inq-copy { grid-column: 1 / span 7; }
    .hm-inq-rule { grid-column: 8 / span 1; }
    .hm-inq-btns { grid-column: 9 / span 4; }
  }

  /* The hero stacks below 900: the phone stands under the copy, centred, 40 px of the hero under it. */
  @media (max-width: 899px) {
    .hm-hero { overflow-x: clip; }
    .hm-hero-copy { grid-column: 1 / span 10; padding-top: 48px; }
    .hm-hero-phone { --pw: 300px; width: calc(var(--pw) * 1.06); margin: 44px auto 0; }
    .hm-inq-copy { grid-column: 1 / -1; }
    .hm-inq-rule { display: none; }
    .hm-inq-btns { grid-column: 1 / -1; grid-row: 2; flex-direction: row; flex-wrap: wrap; margin-top: 32px; }
  }

  /* ── Phone (390) ──────────────────────────────────────────────────── */
  @media (max-width: 734px) {
    .hm-hero-copy { grid-column: 1 / -1; padding-top: 40px; }
    .hm-lead { margin-top: 20px; }
    .hm-btns { flex-direction: column; gap: 10px; }
    .hm-btns .btn { width: 100%; }
    .hm-hero-btns { margin-top: 28px; }
    .hm-hero-phone { --pw: min(286px, calc(100vw - 88px)); margin-top: 36px; }
    .hm-recognize-h2 { max-width: none; }
    /* "On paper," then the italic clause whole on its own line. */
    .hm-recognize-h2 em { display: block; }
    .hm-recognize .flip-close { max-width: none; }
    .hm-flips { grid-template-columns: 1fr; gap: 12px 0; }
    .hm-flips > li { grid-column: 1 / -1 !important; }
    .hm-flips > li:nth-child(even) { width: 92%; margin-left: auto; }
    .hm-flips .flip-inner, .hm-flips .flip-face { min-height: 0; }
    .hm-flips .flip-face { padding: 26px 24px 24px; }
    .hm-flips .flip-cue { padding-top: 24px; }
    .hm-panel { width: calc(100% - 24px); border-radius: 20px; padding: 48px 24px; }
    .hm-ladder { --row-pad: 18px; }
    .hm-ladder > li, .hm-ladder > li:last-child { grid-template-columns: 22px minmax(0, 1fr); column-gap: 14px; row-gap: 0; }
    .hm-panel-btns { margin-top: 24px; }
    /* The mat is full bleed: it clips its own sideways overflow (nothing of it is lost), and the quiz phone's
     * floor shadow stays inside the phone's width, so a 360 screen never scrolls sideways (audit 2, P1). */
    .hm-mat { overflow-x: clip; margin-inline: calc(-1 * var(--gutter)); border-radius: 0; padding: 0 0 20px 10px; }
    .hm-quiz-phone .phone-floor { left: 0; right: 0; }
    /* Phone and card side by side inside the phone's width: a slimmer card (shared component, scoped here) and a
     * phone of up to 200, tucked 4 px, so every switch stays clear of the phone at 390 and at 360. */
    .hm-tcard { width: 150px; height: 228px; padding: 16px 14px; font-size: 12.5px; margin: 0 -4px 22px 0; }
    .hm-tcard .tcard-row { padding: 5px 0; }
    .hm-tcard .tg { width: 30px; height: 18px; }
    .hm-tcard .tg::after { width: 14px; height: 14px; }
    .hm-tcard .tg.on::after { left: 14px; }
    .hm-tcard .tcard-row:nth-child(2) .tg::after { left: 2px; transform: translateX(calc(var(--on) * 12px)); }
    .hm-benefits { grid-template-columns: minmax(0, 1fr); row-gap: 32px; }
    .hm-benefits > li { grid-row: auto; display: block; }
    .hm-benefits .t-body { margin-top: 6px; }
    .hm-quiz-story.static .hm-quiz-cta, .no-js .hm-quiz-story .hm-quiz-cta { margin-top: 40px; }
    .hm-quiz-cta .btn { width: 100%; }
    .hm-quiz-closing { text-align: center; margin-top: 18px; }
    .hm-academy-grid { display: flex; flex-direction: column; }
    .hm-academy-body { max-width: 34em; padding-top: 0; }
    .hm-deck { margin-top: 36px; gap: 18px; order: 2; }
    .hm-deck-line { font-size: 24px; }
    .hm-note { margin-top: 28px; padding: 24px; order: 3; }
    .hm-academy-btns { order: 4; margin-top: 32px; align-self: stretch; }
    .hm-inq { padding-block: var(--sec); }
    .hm-geo-inq { --geo-o: .06 !important; right: -700px; top: -900px; }
    .hm-inq-copy { grid-column: 1 / -1; }
    .hm-inq-lead { margin-top: 22px; }
    /* The margin rule becomes a 48 px horizontal rule above the buttons. */
