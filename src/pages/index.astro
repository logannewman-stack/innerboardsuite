---
/**
 * innerboardsuite.com
 *
 * Built to the InnerBoard Suite Logan implementation handoff (October 15,
 * 2026) and the INNERBOARD SUITE build brief. The copy below is theirs,
 * section by section, in the locked order. The hero photograph is from
 * Leah's own brand shoot, placed as the handoff's "sophisticated,
 * reflective woman in a warm cream setting" until a different approved
 * image is supplied.
 */
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Mark from "../components/Mark.astro";
import FeatureIcon from "../components/FeatureIcon.astro";
import AppPhone from "../components/AppPhone.astro";
import QuizPhone from "../components/QuizPhone.astro";
import FlipCards from "../components/FlipCards.astro";
import { LINKS } from "../config/links";

const title = "InnerBoard · You don't need a different life, just a new way to meet this one";
const description =
  "A few minutes a day to think more clearly, feel more confident, and choose what comes next with a coach in your pocket. Practice, the Academy, INQ Certification and InnerBoard IOS.";

const features = [
  { icon: "coach", name: "Daily Practice Coach", body: "Type what is happening, and think it through right when it matters." },
  { icon: "dare", name: "The Daily Dare", body: "One small thing to do before the day ends. A new one every day." },
  { icon: "courses", name: "Courses", body: "Go deeper on what you're living, from your thoughts and feelings to relationships and confidence." },
  { icon: "live", name: "Live Sessions and Community", body: "Monthly masterclasses, coaching labs, and a room where nobody has to figure it out alone." },
  { icon: "tools", name: "Tools for the Moment", body: "For when you're reacting right now: a breath, a reset, and your next move." }
];

const quizBenefits = [
  { name: "4 minutes to complete", body: "Quick, simple, and insightful." },
  { name: "Personalized results", body: "See what might be auto-renewing in your life." },
  { name: "Discover the unseen cost", body: "What it could be costing you in time, energy, confidence, peace, and relationships." },
  { name: "One thing to do differently", body: "Your gift: a simple next step you can try right away." }
];
---
<Base title={title} description={description} path="/">
  <!-- ── 1. Hero ──────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-cream">
    <div class="absolute inset-0 grain opacity-60" aria-hidden="true"></div>
    <div class="absolute -top-32 right-[-12%] w-[720px] h-[720px] rounded-full bg-gold/15 blur-3xl" aria-hidden="true"></div>
    <div class="wrap relative pt-[112px] sm:pt-[140px] pb-12 sm:pb-20">
      <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-center">
        <div class="reveal is-in">
          <p class="eyebrow">Practice by InnerBoard</p>
          <h1 class="mt-5 text-[42px] sm:text-[58px] lg:text-[66px] leading-[1.02] text-charcoal" data-words>
            You don't need a different life, <em class="text-gold-ink">just a new way to meet this one.</em>
          </h1>
          <p class="mt-6 max-w-[540px] text-[17px] sm:text-[19px] leading-relaxed text-ink-muted">
            A few minutes a day to think more clearly, feel more confident, and choose what comes next with a coach in your pocket.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3 sm:items-center">
            <a href={LINKS.practice} class="btn btn-gold" data-passthrough data-event="practice_click" data-event-location="hero">Start in Practice <Arrow /></a>
            <a href={LINKS.quiz} class="btn btn-outline" data-passthrough data-event="quiz_click" data-event-location="hero">What's Holding You Back?</a>
          </div>
        </div>
        <div class="reveal is-in relative flex justify-center lg:justify-end" style="--d:150ms">
          <!-- The handoff's photograph (a reflective woman in a warm cream setting) goes behind this scene when one is approved. Nothing of Leah appears on the site. -->
          <div class="hero-scene relative" data-tilt="5">
            <div class="hero-backdrop absolute inset-0 rounded-[40px]" aria-hidden="true"></div>
            <p class="absolute -top-2 right-2 text-right text-[11px] font-semibold uppercase tracking-[0.22em] text-ink/60 leading-[1.9]" aria-hidden="true">Same life.<br />Different way<br />to meet it.</p>
            <div class="relative z-[1] phone-float"><AppPhone screen="home" width={300} alt="Practice on a phone: the Daily Practice Coach, Dare of the Day and Set Up Your Day." eager /></div>
            <div class="float-card absolute -left-6 sm:-left-16 bottom-16 card p-4 w-[220px] z-[2]" aria-hidden="true">
              <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-steel">Proof Log</p>
              <p class="mt-1 text-[13px] font-medium text-ink">Had the conversation I had been circling. It took four minutes.</p>
              <p class="mt-2 text-[11px] text-ink-faint">Tuesday · 3 this week</p>
            </div>
            <div class="float-card-2 hidden sm:block absolute -right-4 sm:-right-12 top-44 card p-4 w-[200px] z-[2]" aria-hidden="true">
              <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-steel">STEAR · Reset</p>
              <p class="mt-1 text-[13px] font-medium text-ink">Where you are now</p>
              <p class="mt-1.5 flex gap-1">{[1,2,3,4,5].map((n) => <span class={`w-6 h-6 rounded-full text-[11px] flex items-center justify-center border border-line ${n === 4 ? "bg-ink text-cream" : "text-ink-faint"}`}>{n}</span>)}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 2. Recognition cards ─────────────────────────────────────────── -->
  <section id="recognize" class="bg-cream-2">
    <div class="wrap py-20 sm:py-28">
      <div class="reveal max-w-[720px]">
        <h2 class="text-[36px] sm:text-[52px] text-ink">On paper, <em>it all looks fine.</em></h2>
      </div>
      <div class="mt-12">
        <FlipCards />
      </div>
    </div>
  </section>

  <!-- ── 3. Practice ──────────────────────────────────────────────────── -->
  <section id="practice" class="bg-cream">
    <div class="wrap py-12 sm:py-20">
      <div class="on-dark relative overflow-hidden rounded-[32px] sm:rounded-[40px] bg-forest text-cream aurora" data-glow>
        <span class="aurora-2"></span>
        <div class="relative px-6 py-14 sm:px-12 sm:py-20 lg:px-16 grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-center">
          <div>
            <div class="reveal">
              <p class="eyebrow">Practice by InnerBoard</p>
              <h2 class="mt-4 text-[34px] sm:text-[46px]">A different way to meet <em>whatever life brings.</em></h2>
              <p class="mt-5 text-[16.5px] leading-relaxed text-on-dark-muted max-w-[520px]">A daily practice coach with personalized insight, real-time support, and tools to help you think differently, feel differently, and choose what's next.</p>
            </div>
            <div class="reveal mt-10 flex justify-center lg:justify-start gap-5" style="--d:120ms">
              <AppPhone screen="dare" width={240} alt="Practice home after the Dare of the Day is checked off: You did your Dare of the Day." />
              <AppPhone screen="stear2" width={240} alt="STEAR step two: What did you make it mean?" class="hidden sm:block" />
            </div>
          </div>
          <div>
            <ul class="divide-y divide-gold/40">
              {features.map((f, i) => (
                <li class="reveal py-5 first:pt-0 grid grid-cols-[44px_1fr] gap-4" style={`--d:${i * 80}ms`}>
                  <span class="mt-0.5 inline-flex w-11 h-11 rounded-full border border-gold/50 items-center justify-center text-gold-2"><FeatureIcon name={f.icon} class="w-5 h-5" /></span>
                  <div>
                    <h3 class="text-[22px] text-cream leading-tight">{f.name}</h3>
                    <p class="mt-1.5 text-[15px] leading-relaxed text-on-dark-muted">{f.body}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="relative border-t border-gold/30 px-6 py-12 sm:px-12 lg:px-16 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
          <div class="reveal">
            <p class="font-display text-[28px] sm:text-[36px] leading-[1.1] text-gold-soft">Start today, <em>as you are.</em></p>
            <p class="mt-3 text-[16px] text-on-dark-muted max-w-[560px]">Bring what's happening in your life right now. We'll help you take the next step.</p>
          </div>
          <div class="reveal flex flex-col sm:flex-row gap-3" style="--d:100ms">
            <a href={LINKS.practice} class="btn btn-gold" data-passthrough data-event="practice_click" data-event-location="practice">Start in Practice <Arrow /></a>
            <a href={LINKS.practicePage} class="btn btn-outline-light">See everything inside</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 4. The subscription quiz ─────────────────────────────────────── -->
  <section id="quiz" class="bg-cream">
    <div class="wrap py-16 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div class="reveal relative flex justify-center">
          <div class="quiz-scene relative w-full max-w-[520px] aspect-[4/5] sm:aspect-square">
            <div class="absolute inset-0 rounded-[32px] bg-gradient-to-br from-cream-2 via-[#f3e3dd] to-gold-soft/70 grain" aria-hidden="true"></div>
            <div class="book-prop absolute left-[4%] bottom-[8%] w-[46%]" aria-hidden="true">
              <div class="relative aspect-[4/3] rounded-[6px] bg-forest shadow-float rotate-[-6deg]">
                <div class="absolute inset-[7%] border border-gold-soft/50 rounded-[3px]"></div>
                <p class="absolute inset-x-[12%] top-[22%] font-display text-cream text-[clamp(16px,2.6vw,24px)] leading-[1.1]">A Different Way <em>to Meet Life</em></p>
                <p class="absolute left-[12%] bottom-[14%] text-[10px] uppercase tracking-[0.18em] text-gold-soft">Leah Roling</p>
              </div>
              <div class="cup absolute -top-10 right-[-6%] w-[34%] aspect-square rounded-full bg-cream-3 border border-line shadow-card">
                <div class="absolute inset-[18%] rounded-full bg-[#3b2a1f]"></div>
                <div class="absolute inset-[18%] rounded-full bg-[radial-gradient(circle_at_40%_35%,rgba(255,255,255,0.18),transparent_55%)]"></div>
                <div class="absolute right-[-18%] top-[36%] w-[26%] h-[30%] rounded-r-full border-[5px] border-cream-3 border-l-0"></div>
              </div>
            </div>
            <div class="absolute right-[4%] top-[6%] scale-[0.66] sm:scale-[0.78] origin-top-right rotate-[4deg]">
              <QuizPhone />
            </div>
          </div>
        </div>
        <div class="reveal" style="--d:120ms">
          <p class="eyebrow">The subscription quiz</p>
          <h2 class="mt-4 text-[34px] sm:text-[46px] text-ink">What's costing you <em class="text-gold-ink">more than you think?</em></h2>
          <div class="mt-5 space-y-3 text-[16.5px] leading-relaxed text-ink-muted max-w-[520px]">
            <p>You know those subscriptions you forgot about, but they're still on auto-renew?</p>
            <p>What if you're doing the same thing in your life?</p>
            <p>Except these subscriptions aren't charging your credit card. They're costing you time, energy, confidence, peace, and connection.</p>
          </div>
          <ul class="mt-7 grid gap-4 sm:grid-cols-2">
            {quizBenefits.map((b) => (
              <li class="flex gap-3">
                <span class="mt-[7px] w-2 h-2 rounded-full bg-gold shrink-0"></span>
                <p class="text-[15px] leading-snug text-ink-muted"><span class="font-semibold text-ink">{b.name}.</span> {b.body}</p>
              </li>
            ))}
          </ul>
          <div class="mt-8 flex flex-col sm:flex-row gap-4 sm:items-center">
            <a href={LINKS.quiz} class="btn btn-dark" data-passthrough data-event="quiz_click" data-event-location="quiz">Take the Quiz <Arrow /></a>
            <p class="font-display italic text-[17px] text-ink-muted">It's time to cancel what's no longer serving you.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 5. Academy ───────────────────────────────────────────────────── -->
  <section id="academy" class="bg-cream-2 relative overflow-hidden">
    <div class="wrap py-20 sm:py-28">
      <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div class="reveal">
          <p class="eyebrow">Academy | Courses to own</p>
          <h2 class="mt-4 text-[34px] sm:text-[48px] text-ink">Go deeper into the skills <em>that change everything.</em></h2>
          <p class="mt-5 text-[16.5px] leading-relaxed text-ink-muted max-w-[560px]">Practical, transformational learning for real life. Buy the courses you want. Keep them forever.</p>
          <p class="mt-2 text-[16.5px] leading-relaxed text-ink-muted max-w-[560px]">Explore courses in thinking, feeling, and leading differently.</p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3 sm:items-center">
            <a href={LINKS.academy} class="btn btn-dark" data-event="academy_click" data-event-location="academy">Explore Academy <Arrow /></a>
            <a href={LINKS.practice} class="btn btn-outline" data-passthrough data-event="practice_click" data-event-location="academy">Explore Practice</a>
          </div>
        </div>
        <div class="reveal" style="--d:120ms">
          <div class="books relative mx-auto max-w-[420px]" aria-hidden="true">
            {["Think Different", "Feel Different", "Lead Different"].map((t, i) => (
              <div class={`book-spine bg-navy text-gold-2 rounded-[4px] shadow-card flex items-center px-6 h-[64px] font-display text-[20px] tracking-[0.08em] uppercase ${i === 0 ? "ml-6 w-[88%]" : i === 1 ? "ml-0 w-[94%]" : "ml-10 w-[84%]"} -mt-[2px]`}>
                <span class="w-2 h-2 rounded-full bg-gold-2 mr-4"></span>{t}
              </div>
            ))}
            <p class="mt-4 text-[12px] text-ink-faint text-center">Three titles, one shelf. The approved book imagery arrives from Leah.</p>
          </div>
          <div class="card mt-8 p-6 sm:p-7">
            <p class="eyebrow">Also included in Practice</p>
            <p class="mt-2 text-[15.5px] leading-relaxed text-ink-muted">Get access to these courses with a paid Practice subscription, alongside your daily coach, live sessions, and tools for the moment.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 6. INQ Certification teaser ──────────────────────────────────── -->
  <section id="inq" class="on-dark bg-navy text-cream relative overflow-hidden aurora" data-glow>
    <span class="aurora-2"></span>
    <div class="absolute inset-0 opacity-70" style="background-image: linear-gradient(to right, rgba(244,239,228,0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(244,239,228,0.05) 1px, transparent 1px); background-size: 64px 64px; mask-image: radial-gradient(ellipse at 80% 50%, black 20%, transparent 70%);" aria-hidden="true"></div>
    <div class="wrap relative py-20 sm:py-28">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
        <div class="reveal">
          <p class="eyebrow">INQ Certification | Lead it</p>
          <h2 class="mt-4 text-[36px] sm:text-[52px]">Coach the change that <em class="text-gold-2">actually changes people.</em></h2>
          <p class="mt-6 text-[16.5px] leading-relaxed text-on-dark-muted max-w-[560px]">A science-informed certification in human behavior, neuroscience, emotional intelligence, and habit change.</p>
          <p class="mt-3 text-[16.5px] leading-relaxed text-on-dark-muted max-w-[560px]">Gain the confidence to create meaningful results for your clients, apply the work to your own life, and build a coaching business around the impact you make.</p>
        </div>
        <div class="reveal flex flex-col sm:flex-row lg:flex-col gap-3 lg:items-start" style="--d:120ms">
          <a href={LINKS.inq} class="btn btn-gold" data-event="inq_click" data-event-location="teaser">Explore INQ Certification <Arrow /></a>
          <a href={LINKS.inqBook} class="btn btn-outline-light" data-event="inq_book_click" data-event-location="teaser">Book a Conversation</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 7. Why InnerBoard exists ─────────────────────────────────────── -->
  <section id="mission" class="bg-cream relative overflow-hidden">
    <div class="watermark w-[640px] h-[640px] -right-40 -top-40" aria-hidden="true"><Mark /></div>
    <div class="wrap relative py-24 sm:py-32">
      <div class="reveal mx-auto max-w-[820px] text-center">
        <p class="eyebrow">Why InnerBoard exists</p>
        <h2 class="mt-5 text-[38px] sm:text-[56px] text-ink">We believe people are capable of more.</h2>
        <p class="mt-3 font-display italic text-[24px] sm:text-[30px] text-gold-ink">Sometimes they just need a different way forward.</p>
        <div class="mt-8 space-y-4 text-[17px] sm:text-[18px] leading-relaxed text-ink-muted">
          <p>InnerBoard was built on a simple belief: the way we think, feel, and respond shapes the way we experience our lives.</p>
          <p>And those aren't things we're stuck with. They're skills we can learn, strengthen, and practice.</p>
          <p>Our mission is to make that kind of growth accessible, practical, and part of everyday life, so more people can become who they're capable of being.</p>
        </div>
        <p class="mt-8 font-display text-[22px] sm:text-[26px] text-ink">Learn it. Live it. Lead it. <em>Practice it.</em></p>
        <p class="mt-8 text-[12px] uppercase tracking-[0.18em] font-semibold text-ink-faint">Founded by Leah Roling</p>
      </div>
    </div>
  </section>

  <!-- ── 8. InnerBoard IOS ────────────────────────────────────────────── -->
  <section id="ios" class="on-dark bg-navy-2 text-cream relative overflow-hidden" data-glow>
    <div class="wrap py-20 sm:py-28">
      <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
        <div class="reveal">
          <p class="eyebrow">InnerBoard IOS | Scale it</p>
          <h2 class="mt-4 text-[34px] sm:text-[48px]">Imagine what happens when <em class="text-gold-2">an entire team grows.</em></h2>
          <p class="mt-6 text-[16.5px] leading-relaxed text-on-dark-muted max-w-[600px]">Personal growth changes how one person shows up. Imagine what becomes possible when an entire organization learns to think differently, lead themselves, and bring their best to work.</p>
          <p class="mt-3 text-[16.5px] leading-relaxed text-on-dark-muted max-w-[600px]">InnerBoard IOS brings a people operating system into organizations, helping build the confidence, capability, and accountability that strengthen culture and drive results.</p>
        </div>
        <div class="reveal lg:justify-self-end" style="--d:100ms">
          <a href={LINKS.ios} class="btn btn-gold" rel="noopener" data-event="ios_click" data-event-location="pathway">Explore InnerBoard IOS <Arrow /></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-scene { width: min(100%, 440px); padding: 28px 0; }
  .hero-backdrop { background: linear-gradient(160deg, var(--color-cream-2), var(--color-gold-soft) 60%, var(--color-cream-2)); transform: rotate(-4deg) scale(1.02); }
  .phone-float { margin-inline: auto; animation: float 7s ease-in-out infinite; }
  .float-card { animation: float 9s ease-in-out infinite 1s; }
  .float-card-2 { animation: float 8s ease-in-out infinite 0.5s; }
  @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  @media (max-width: 420px) { .phone-float { transform: scale(0.9); transform-origin: top center; } .float-card { bottom: 6px; left: 0; } }
  @media (prefers-reduced-motion: reduce) { .phone-float, .float-card, .float-card-2 { animation: none; } }
  .book-spine { transform: rotate(-1deg); }
  .book-spine:nth-child(2) { transform: rotate(1deg); }
  .book-spine:nth-child(3) { transform: rotate(-0.5deg); }
</style>
