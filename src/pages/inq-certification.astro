---
/**
 * innerboardsuite.com/inq-certification
 *
 * Built to the INQ Certification Page Mock-up (D9), the only source for this
 * page. Every line of copy below is the mock-up's, in its order: hero and
 * four value columns, Sound familiar, Why INQ works, What you get, Learn it
 * Live it Lead it, In the room, The certification, Your practice, Who INQ is
 * for, Your investment, How to get started, Questions people ask, the close.
 * The cream and teal system is the Academy page's.
 */
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Accordion from "../components/Accordion.astro";
import { LINKS } from "../config/links";

const title = "INQ Certification · Coach the transformation that actually changes people";
const description =
  "A self-paced, accredited certification for existing and aspiring coaches. Learn the method, live it in your own life, then lead it with the people you serve.";

const values = [
  { name: "Make the impact you came to make.", body: "Help people move past understanding their challenges to changing how they think, feel, and show up in their lives." },
  { name: "Know your next move in the room.", body: "Stop second-guessing which question to ask or which tool to use. When you see what's happening underneath, the next move gets clear." },
  { name: "Experience the transformation yourself.", body: "This isn't only about becoming a better coach. Every tool works on your own life first." },
  { name: "Build a business around your impact.", body: "Communicate your value, create offers that fit you, and grow through clients who tell others what changed." }
];

const outcomes = [
  "See the thinking and patterns keeping someone stuck.",
  "Help people connect their thoughts, emotions, choices, and results.",
  "Stay with hard emotions without rushing to fix or rescue.",
  "Help people build self-trust and take ownership of their lives.",
  "Move people from insight into action they can repeat.",
  "Coach without taking responsibility for someone else's choices.",
  "Communicate the value of your work and build offers around it."
];

const modules = [
  { name: "Radical Awareness", body: "You can't lead what you can't see. Help people notice the thoughts and beliefs running their choices." },
  { name: "Mastering Emotions", body: "Help people feel what they feel without letting it run them, and stop avoiding it with busyness, food, or scrolling." },
  { name: "Identity Design and Reinvention", body: "You don't rise to your goals. You fall to your defaults. Help people choose the identity their next chapter needs." },
  { name: "Relationships as the Mirror", body: "Help people stop waiting for others to change: ownership over expectation, real boundaries, and the conversations they've been avoiding." },
  { name: "Energy as a Leadership Strategy", body: "Help people stop managing the clock and start managing their energy: physical, emotional, mental, and spiritual." },
  { name: "Alignment in Action", body: "Clear what drains you. Design what drives you. Goals that fit who you are, not who you're performing for." },
  { name: "Coaching Others: Becoming the Work", body: "Hold the mirror clean: guide others without rescuing, fixing, or proving." },
  { name: "Integration and Certification: Being the Work", body: "Bring it all into your own coaching approach, and show it in a recorded coaching session." }
];

const business = [
  "Get clear on who you most want to serve.",
  "Say what your coaching does, in words your clients would use.",
  "Build offers around your strengths.",
  "Price your work without flinching.",
  "Lay the groundwork for referrals and relationships."
];

const audiences = [
  { name: "Coaches", body: "You've been coaching a while and want the method underneath your tools." },
  { name: "Future coaches and the career-curious", body: "You feel the pull to this work, and you want a strong place to start." },
  { name: "Leaders and people developers", body: "You've learned strategy isn't the variable. The person carrying it out is." },
  { name: "Therapists, healers, and practitioners", body: "You already hold space for people. INQ adds coaching skills that fit alongside your existing scope of practice." },
  { name: "Teachers and trainers", body: "You've seen that information alone doesn't change anyone." }
];

const included = [
  "The full INQ curriculum, including the Entrepreneurial Path",
  "The Framework Book",
  "The Business Builder",
  "Community, plus weekly office hours",
  "Self-paced: most people finish in two to six months"
];

const steps = [
  { name: "Talk with us", body: "A conversation about your goals, the work you want to do, and whether INQ fits." },
  { name: "Enroll", body: "Right after the conversation, or now." },
  { name: "Begin", body: "Log in and start the same day." }
];

const faq = [
  { q: "I'm not a coach yet. Is INQ for me?", a: "Yes. INQ gives you a full foundation: the method, the tools, practice with real people, and the business side. You don't need any coaching experience to start." },
  { q: "I'm already certified. Why add INQ?", a: "Most certifications teach the conversation. INQ gives you more tools and teaches what's underneath them: why people do what they do, and how they change it for themselves. Your existing training doesn't go away. It lands deeper." },
  { q: "How long does it take, and is it self-paced or live?", a: "It's self-paced. Most people finish in two to six months, depending on how quickly they move through the work. Weekly office hours and the community are there the whole way." },
  { q: "Is it accredited? What credential do I receive?", a: "Yes. INQ is accredited by [ACCREDITING BODY]. Graduates earn [CREDENTIAL NAME]." },
  { q: "Will I use the tools in my own life?", a: "Yes. That's where every module starts." },
  { q: "Does INQ help me build a business?", a: "Yes. The Entrepreneurial Path and the Business Builder cover who you serve, offers, pricing, and how you talk about your work." },
  { q: "What does it cost?", a: "$6,997, with payment options available." },
  { q: "Will INQ guarantee clients or income?", a: "No program can guarantee that, and we won't pretend to. INQ builds your coaching skill and gives you the tools to grow a practice. What you build with them is yours." },
  { q: "How do I know if INQ is right for me?", a: "Book a conversation. We'll learn about your goals and help you decide." }
];
---
<Base title={title} description={description} path="/inq-certification" theme="teal" themeColor="#f7f4ee">
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="bg-ac-cream relative overflow-hidden">
    <div class="absolute -top-32 right-[-10%] w-[640px] h-[640px] rounded-full bg-teal/10 blur-3xl" aria-hidden="true"></div>
    <div class="wrap relative pt-[120px] sm:pt-[160px] pb-16 sm:pb-24">
      <div class="reveal is-in max-w-[860px]">
        <p class="eyebrow">INQ Certification by InnerBoard</p>
        <h1 class="mt-5 text-[42px] sm:text-[60px] lg:text-[72px] leading-[1.0] text-ink" data-words>Coach the transformation that actually <em class="text-teal">changes people.</em></h1>
        <p class="mt-6 max-w-[640px] text-[17px] sm:text-[20px] leading-relaxed text-ink-muted">A self-paced, accredited certification for existing and aspiring coaches. Learn the method, live it in your own life, then lead it with the people you serve.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href={LINKS.inqBook} class="btn btn-teal" data-event="inq_book_click" data-event-location="hero">Book a conversation <Arrow /></a>
          <a href={LINKS.inqEnroll} class="btn btn-outline-teal" data-event="inq_enroll_click" data-event-location="hero">Enroll now</a>
        </div>
        <p class="mt-8 font-display italic text-[19px] text-ink">Learn it. Live it. Lead it.</p>
      </div>
      <ul class="reveal mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 border-t border-ac-line pt-8" style="--d:120ms">
        {values.map((v) => (
          <li class="border-t-2 border-teal pt-4">
            <h2 class="text-[22px] leading-[1.15] text-ink">{v.name}</h2>
            <p class="mt-3 text-[14.5px] leading-relaxed text-ink-muted">{v.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Sound familiar ───────────────────────────────────────────────── -->
  <section class="bg-ac-cream-2">
    <div class="wrap py-20 sm:py-28">
      <div class="reveal max-w-[760px]">
        <p class="eyebrow">Sound familiar?</p>
        <h2 class="mt-4 text-[36px] sm:text-[48px] text-ink">People already bring you what they're <em class="text-teal">carrying.</em></h2>
        <p class="mt-5 text-[16.5px] leading-relaxed text-ink-muted">What you do with it is the difference between a good conversation and real change.</p>
      </div>
      <div class="mt-12 grid gap-4 md:grid-cols-2">
        <div class="reveal card p-8">
          <p class="eyebrow">For existing coaches</p>
          <p class="mt-4 font-display text-[24px] leading-[1.2] text-ink">"Am I really helping them change, or are we just having another great conversation?"</p>
          <ul class="mt-5 divide-y divide-ac-line text-[15px] text-ink-muted">
            <li class="py-2.5">Why does the same client keep bringing back the same problem?</li>
            <li class="py-2.5">Which question do I ask, and which tool do I reach for?</li>
            <li class="py-2.5">How do I build a business that reflects what this work is worth?</li>
          </ul>
        </div>
        <div class="reveal card p-8" style="--d:100ms">
          <p class="eyebrow">For aspiring coaches</p>
          <p class="mt-4 font-display text-[24px] leading-[1.2] text-ink">"People already bring me their problems. Could I really do this for a living?"</p>
          <ul class="mt-5 divide-y divide-ac-line text-[15px] text-ink-muted">
            <li class="py-2.5">You want a method that works before you build a career on it.</li>
            <li class="py-2.5">You want practice with real people, not just theory.</li>
            <li class="py-2.5">You want to know you can create an income from your impact.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Why INQ works ────────────────────────────────────────────────── -->
  <section class="on-dark bg-teal text-white relative overflow-hidden" data-glow>
    <div class="wrap py-20 sm:py-28">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
        <div class="reveal">
          <p class="eyebrow">Why INQ works</p>
          <h2 class="mt-4 text-[36px] sm:text-[52px]">Work the surface and you create a session. Work the source and you create <em class="text-gold-soft">change.</em></h2>
          <p class="mt-6 text-[16.5px] leading-relaxed text-white/80 max-w-[620px]">People don't stay stuck because they don't know what to do. They stay stuck because of the thought they keep thinking, the feeling it creates, and the action that follows, until the result proves the thought right. INQ teaches you to see that loop, help someone see it for themselves, and help them change it.</p>
        </div>
        <p class="reveal font-display text-[26px] sm:text-[30px] leading-[1.25] text-white" style="--d:120ms">More information doesn't change that loop. Neither does motivation.</p>
      </div>
    </div>
  </section>

  <!-- ── What you get ─────────────────────────────────────────────────── -->
  <section class="bg-ac-cream">
    <div class="wrap py-20 sm:py-28">
      <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-start">
        <div class="reveal">
          <p class="eyebrow">What you get</p>
          <h2 class="mt-4 text-[36px] sm:text-[48px] text-ink">The tools, and the method that tells you <em class="text-teal">which one to use.</em></h2>
        </div>
        <div class="reveal space-y-4 text-[16.5px] leading-relaxed text-ink-muted" style="--d:120ms">
          <p>INQ gives you a full set of coaching tools, gathered in The Framework Book, for thoughts, emotions, identity, relationships, energy, and goals.</p>
          <p>Most programs stop there. INQ also teaches you why people do what they do, so you know which tool a moment calls for, and why.</p>
          <p>Already coaching? Your existing training doesn't go away. It gets a foundation, so everything you already use lands deeper. New to coaching? You start with both from day one.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Learn it. Live it. Lead it. ──────────────────────────────────── -->
  <section class="bg-ac-cream-2">
    <div class="wrap py-20 sm:py-28">
      <div class="reveal max-w-[760px]">
        <p class="eyebrow">Learn it. Live it. Lead it.</p>
        <h2 class="mt-4 text-[36px] sm:text-[48px] text-ink">This isn't a certification you collect. It's a method you <em class="text-teal">become.</em></h2>
      </div>
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {[
          ["Learn it.", "Why people do what they do, and the tools that help them change it."],
          ["Live it.", "Every tool goes through your own life first: your thinking, your emotions, your relationships, your goals."],
          ["Lead it.", "Bring it into real coaching conversations. Every module ends with three written questions and a coaching moment you record."]
        ].map(([n, b], i) => (
          <div class="reveal card p-7" style={`--d:${i * 90}ms`}>
            <h3 class="text-[26px] text-ink">{n}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-ink-muted">{b}</p>
          </div>
        ))}
      </div>
      <div class="reveal mt-12 max-w-[760px]">
        <p class="font-display text-[26px] sm:text-[32px] leading-[1.2] text-ink">You can't lead someone into what you haven't practiced <em class="text-teal">yourself.</em></p>
        <p class="mt-3 text-[16px] text-ink-muted">By the time you're certified, the work has already changed one person: you.</p>
      </div>
    </div>
  </section>

  <!-- ── In the room ──────────────────────────────────────────────────── -->
  <section class="bg-ac-cream">
    <div class="wrap py-20 sm:py-28">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
        <div class="reveal">
          <p class="eyebrow">In the room</p>
          <h2 class="mt-4 text-[36px] sm:text-[48px] text-ink">What you'll be able to do</h2>
          <p class="mt-5 font-display italic text-[18px] text-ink-muted">Less guessing. More reps. Coaching you trust because you've done it.</p>
        </div>
        <ul class="reveal divide-y divide-ac-line border-y border-ac-line" style="--d:100ms">
          {outcomes.map((o) => (
            <li class="py-4 text-[16px] leading-relaxed text-ink-muted">{o}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ── The certification ────────────────────────────────────────────── -->
  <section id="modules" class="bg-ac-cream-2">
    <div class="wrap py-20 sm:py-28">
      <div class="reveal max-w-[760px]">
        <p class="eyebrow">The certification</p>
        <h2 class="mt-4 text-[36px] sm:text-[48px] text-ink">One method, built <em class="text-teal">module by module.</em></h2>
      </div>
      <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {modules.map((m, i) => (
          <li class="reveal card p-6 sm:p-7 flex flex-col" style={`--d:${i * 60}ms`}>
            <h3 class="text-[22px] leading-[1.15] text-ink">{m.name}</h3>
            <p class="mt-3 text-[14.5px] leading-relaxed text-ink-muted">{m.body}</p>
          </li>
        ))}
        <li class="reveal rounded-[18px] bg-teal-soft border border-teal/40 p-6 sm:p-7" style="--d:480ms">
          <span class="text-[11px] font-semibold uppercase tracking-[0.16em] text-teal">Bonus</span>
          <h3 class="mt-2 text-[22px] leading-[1.15] text-ink">The Entrepreneurial Path</h3>
          <p class="mt-3 text-[14.5px] leading-relaxed text-ink-muted">Turn the work into a practice: who you serve, your offers, your pricing, and how you talk about what you do.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ── Your practice ────────────────────────────────────────────────── -->
  <section class="bg-ac-cream">
    <div class="wrap py-20 sm:py-28">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div class="reveal">
          <p class="eyebrow">Your practice</p>
          <h2 class="mt-4 text-[36px] sm:text-[48px] text-ink">You can love this work and <em class="text-teal">make a living at it.</em></h2>
          <p class="mt-5 text-[16.5px] leading-relaxed text-ink-muted max-w-[520px]">Whether you're starting a practice from scratch or growing the one you have, the Entrepreneurial Path and the Business Builder help you build it on purpose. People who really change tell people. Over time, that becomes how your business grows.</p>
        </div>
        <ul class="reveal divide-y divide-ac-line border-y border-ac-line" style="--d:120ms">
          {business.map((b) => <li class="py-4 text-[16px] text-ink-muted">{b}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Who INQ is for ───────────────────────────────────────────────── -->
  <section class="bg-ac-cream-2">
    <div class="wrap py-20 sm:py-28">
      <div class="reveal max-w-[760px]">
        <p class="eyebrow">Is INQ right for you?</p>
        <h2 class="mt-4 text-[36px] sm:text-[48px] text-ink">Who INQ is for</h2>
      </div>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {audiences.map((a, i) => (
          <li class="reveal card p-6" style={`--d:${i * 70}ms`}>
            <h3 class="text-[20px] leading-[1.2] text-ink font-sans font-semibold">{a.name}</h3>
            <p class="mt-2 text-[14.5px] leading-relaxed text-ink-muted">{a.body}</p>
          </li>
        ))}
      </ul>
      <p class="reveal mt-10 font-display italic text-[20px] text-ink">Where you're starting matters less than the difference you want to make.</p>
    </div>
  </section>

  <!-- ── Your investment ──────────────────────────────────────────────── -->
  <section id="investment" class="bg-ac-cream">
    <div class="wrap py-20 sm:py-28">
      <div class="reveal card p-8 sm:p-10 lg:p-12 grid gap-10 lg:grid-cols-[1fr_1fr] border-teal/30" style="--d:60ms">
        <div>
          <p class="eyebrow">Your investment</p>
          <h2 class="mt-3 text-[32px] sm:text-[40px] text-ink">INQ Certification</h2>
          <p class="mt-4 font-display text-[56px] sm:text-[64px] leading-none text-ink">$6,997</p>
          <p class="mt-3 text-[15px] text-ink-muted">Payment options available</p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href={LINKS.inqEnroll} class="btn btn-teal" data-event="inq_enroll_click" data-event-location="investment">Enroll now <Arrow /></a>
            <a href={LINKS.inqBook} class="btn btn-outline-teal" data-event="inq_book_click" data-event-location="investment">Book a conversation</a>
          </div>
          <p class="mt-4 text-[13.5px] text-ink-faint">Not sure yet? A conversation is the best next step.</p>
        </div>
        <div>
          <p class="text-[16px] font-semibold text-ink">What's included</p>
          <ul class="mt-3 divide-y divide-ac-line border-y border-ac-line">
            {included.map((x) => <li class="py-3 text-[15px] text-ink-muted">{x}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── How to get started ───────────────────────────────────────────── -->
  <section class="bg-ac-cream-2">
    <div class="wrap py-20 sm:py-28">
      <div class="reveal max-w-[760px]">
        <p class="eyebrow">How to get started</p>
        <h2 class="mt-4 text-[36px] sm:text-[48px] text-ink">Start the same day.</h2>
      </div>
      <ol class="mt-12 grid gap-4 md:grid-cols-3">
        {steps.map((s, i) => (
          <li class="reveal card p-7" style={`--d:${i * 90}ms`}>
            <h3 class="text-[24px] text-ink">{s.name}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-ink-muted">{s.body}</p>
          </li>
        ))}
      </ol>
      <p class="reveal mt-10 text-[15.5px] text-ink-muted max-w-[760px]">Want to try the method first? Start with <a href={LINKS.certifiedMind} class="link-arrow">The Certified Mind Method</a>, the five-tool method behind INQ, in the Academy.</p>
    </div>
  </section>

  <!-- ── Questions people ask ─────────────────────────────────────────── -->
  <section id="faq" class="bg-ac-cream">
    <div class="wrap py-20 sm:py-28">
      <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr]">
        <div class="reveal">
          <h2 class="text-[36px] sm:text-[44px] text-ink">Questions people ask</h2>
        </div>
        <div class="reveal" style="--d:100ms">
          <Accordion items={faq} theme="teal" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── Close ────────────────────────────────────────────────────────── -->
  <section class="on-dark bg-ink text-cream relative overflow-hidden aurora" data-glow>
    <span class="aurora-2"></span>
    <div class="wrap py-24 sm:py-32 text-center">
      <div class="reveal mx-auto max-w-[820px]">
        <h2 class="text-[34px] sm:text-[52px]">You can coach a person's <em>behavior.</em> Or you can coach <em>the person.</em></h2>
        <p class="mt-6 font-display text-[22px] sm:text-[26px] text-cream">One creates a session. The other creates change.</p>
        <p class="mt-3 text-[16px] text-on-dark-muted">INQ is for anyone who's decided which one they're here to do.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
          <a href={LINKS.inqEnroll} class="btn btn-cream" data-event="inq_enroll_click" data-event-location="close">Enroll now <Arrow /></a>
          <a href={LINKS.inqBook} class="btn btn-outline-light" data-event="inq_book_click" data-event-location="close">Book a conversation</a>
        </div>
      </div>
    </div>
  </section>
</Base>
