---
/**
 * innerboardsuite.com/inq-certification
 *
 * Built to the INQ Certification Page Mock-up (D9), the only source for this
 * page, on the system of BUILD_SPEC part 1 (SYSTEM_API.md). Every line of
 * copy below is the mock-up's, in its order: hero and four value columns,
 * Sound familiar, Why INQ works, What you get, Learn it Live it Lead it, In
 * the room, The certification, Your practice, Who INQ is for, Your
 * investment, How to get started, Questions people ask, the close. The cream
 * and teal system is the Academy page's. The page's object with depth is the
 * investment card; its drawn moments are the four rules of the hero, the
 * loop glyph on teal and the three dots on one line. No app captures here.
 * The module and step numerals of the first build are gone: the order is
 * the sequence, as the mock-up draws it.
 */
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Accordion from "../components/Accordion.astro";
import InqLoopGlyph from "../components/InqLoopGlyph.astro";
import InqStepsLine from "../components/InqStepsLine.astro";
import { LINKS } from "../config/links";

const title = "INQ Certification · Coach the change that lasts";
const description =
  "A self-paced, accredited certification for existing and aspiring coaches. Learn the method, live it in your own life, then lead it with the people you serve.";

const values = [
  { name: "Make the impact you came to make.", body: "Help people move past understanding their challenges to changing how they think, feel, and show up in their lives." },
  { name: "Know your next move in the room.", body: "Stop second-guessing which question to ask or which tool to use. When you see what's happening underneath, the next move gets clear." },
  { name: "Experience the transformation yourself.", body: "This isn't only about becoming a better coach. Every tool works on your own life first." },
  { name: "Build a business around your impact.", body: "Communicate your value, create offers that fit you, and grow through clients who tell others what changed." }
];

const outcomes = [
  "See the thinking and patterns keeping someone stuck.",
  "Help people connect their thoughts, emotions, choices, and results.",
  "Stay with hard emotions without rushing to fix or rescue.",
  "Help people build self-trust and take ownership of their lives.",
  "Move people from insight into action they can repeat.",
  "Coach without taking responsibility for someone else's choices.",
  "Communicate the value of your work and build offers around it."
];

const modules = [
  { name: "Radical Awareness", body: "You can't lead what you can't see. Help people notice the thoughts and beliefs running their choices." },
  { name: "Mastering Emotions", body: "Help people feel what they feel without letting it run them, and stop avoiding it with busyness, food, or scrolling." },
  { name: "Identity Design and Reinvention", body: "You don't rise to your goals. You fall to your defaults. Help people choose the identity their next chapter needs." },
  { name: "Relationships as the Mirror", body: "Help people stop waiting for others to change: ownership over expectation, real boundaries, and the conversations they've been avoiding." },
  { name: "Energy as a Leadership Strategy", body: "Help people stop managing the clock and start managing their energy: physical, emotional, mental, and spiritual." },
  { name: "Alignment in Action", body: "Clear what drains you. Design what drives you. Goals that fit who you are, not who you're performing for." },
  { name: "Coaching Others: Becoming the Work", body: "Hold the mirror clean: guide others without rescuing, fixing, or proving." },
  { name: "Integration and Certification: Being the Work", body: "Bring it all into your own coaching approach, and show it in a recorded coaching session." }
];

const business = [
  "Get clear on who you most want to serve.",
  "Say what your coaching does, in words your clients would use.",
  "Build offers around your strengths.",
  "Price your work without flinching.",
  "Lay the groundwork for referrals and relationships."
];

const audiences = [
  { name: "Coaches", body: "You've been coaching a while and want the method underneath your tools." },
  { name: "Future coaches and the career-curious", body: "You feel the pull to this work, and you want a strong place to start." },
  { name: "Leaders and people developers", body: "You've learned strategy isn't the variable. The person carrying it out is." },
  { name: "Therapists, healers, and practitioners", body: "You already hold space for people. INQ adds coaching skills that fit alongside your existing scope of practice." },
  { name: "Teachers and trainers", body: "You've seen that information alone doesn't change anyone." }
];

const included = [
  "The full INQ curriculum, including the Entrepreneurial Path",
  "The Framework Book",
  "The Business Builder",
  "Community, plus weekly office hours",
  "Self-paced: most people finish in two to six months"
];

const steps = [
  { name: "Talk with us", body: "A conversation about your goals, the work you want to do, and whether INQ fits." },
  { name: "Enroll", body: "Right after the conversation, or now." },
  { name: "Begin", body: "Log in and start the same day." }
];

const faq = [
  { q: "I'm not a coach yet. Is INQ for me?", a: "Yes. INQ gives you a full foundation: the method, the tools, practice with real people, and the business side. You don't need any coaching experience to start." },
  { q: "I'm already certified. Why add INQ?", a: "Most certifications teach the conversation. INQ gives you more tools and teaches what's underneath them: why people do what they do, and how they change it for themselves. Your existing training doesn't go away. It lands deeper." },
  { q: "How long does it take, and is it self-paced or live?", a: "It's self-paced. Most people finish in two to six months, depending on how quickly they move through the work. Weekly office hours and the community are there the whole way." },
  // Hidden until Leah supplies the accrediting body and credential name (tracker INQ-14):
  // { q: "Is it accredited? What credential do I receive?", a: "Yes. INQ is accredited by [ACCREDITING BODY]. Graduates earn [CREDENTIAL NAME]." },
  { q: "Will I use the tools in my own life?", a: "Yes. That's where every module starts." },
  { q: "Does INQ help me build a business?", a: "Yes. The Entrepreneurial Path and the Business Builder cover who you serve, offers, pricing, and how you talk about your work." },
  { q: "What does it cost?", a: "$6,997, with payment options available." },
  { q: "Will INQ guarantee clients or income?", a: "No program can guarantee that, and we won't pretend to. INQ builds your coaching skill and gives you the tools to grow a practice. What you build with them is yours." },
  { q: "How do I know if INQ is right for me?", a: "Book a conversation. We'll learn about your goals and help you decide." }
];
---
<Base title={title} description={description} path="/inq-certification" theme="teal" themeColor="#f7f4ee">
  <!-- ── Hero: type and four drawn rules (2.4.1) ───────────────────────── -->
  <section class="inq-hero" data-tone="ac-cream">
    <i class="lamp lamp-cream grain grain-cream" aria-hidden="true" style="--lx:80%;--ly:0%"></i>
    <div class="wrap">
      <div class="grid">
        <div class="inq-hero-copy">
          <p class="eyebrow rise" style="--d:.35s">INQ Certification by InnerBoard</p>
          <h1 class="t-xl inq-h1" data-lines><span class="hl">Coach the transformation that actually</span> <em class="hl">changes people.</em></h1>
          <p class="t-lead inq-lede rise" style="--d:.5s">A self-paced, accredited certification for existing and aspiring coaches. Learn the method, live it in your own life, then lead it with the people you serve.</p>
          <div class="inq-btns rise" style="--d:.6s">
            <a href={LINKS.inqBook} class="btn btn-teal" data-event="inq_book_click" data-event-location="hero">Book a conversation <Arrow /></a>
            <a href={LINKS.inqEnroll} class="btn btn-line-teal" data-event="inq_enroll_click" data-event-location="hero">Enroll now</a>
          </div>
          <p class="t-s-pull inq-motto rise" style="--d:.7s">Learn it. Live it. Lead it.</p>
        </div>
      </div>
      <ul class="inq-values grid" role="list">
        {values.map((v, i) => (
          <li class="inq-value" style={`--d:${i * 120}ms`}>
            <i class="rule-draw inq-rule" aria-hidden="true"></i>
            <p class="t-title rise" style={`--d:${80 + i * 120}ms`}>{v.name}</p>
            <p class="t-body rise" style={`--d:${160 + i * 120}ms`}>{v.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Sound familiar? Two paper panels (2.4.2) ─────────────────────── -->
  <section class="inq-sec sec-alt" data-tone="ac-cream">
    <div class="wrap">
      <div class="grid">
        <div class="inq-head">
          <p class="eyebrow rise">Sound familiar?</p>
          <h2 class="t-l wipe">People already bring you what they're <em>carrying.</em></h2>
          <p class="t-lead inq-head-lead rise" style="--d:.3s">What you do with it is the difference between a good conversation and real change.</p>
        </div>
      </div>
      <div class="grid inq-panels">
        <div class="paper inq-panel rise-obj" style="--d:.2s">
          <p class="eyebrow">For existing coaches</p>
          <p class="t-s-quote quote-hang inq-quote">"Am I really helping them change, or are we just having another great conversation?"</p>
          <ul class="inq-lines" role="list">
            <li>Why does the same client keep bringing back the same problem?</li>
            <li>Which question do I ask, and which tool do I reach for?</li>
            <li>How do I build a business that reflects what this work is worth?</li>
          </ul>
        </div>
        <div class="paper inq-panel rise-obj" style="--d:.3s">
          <p class="eyebrow">For aspiring coaches</p>
          <p class="t-s-quote quote-hang inq-quote">"People already bring me their problems. Could I really do this for a living?"</p>
          <ul class="inq-lines" role="list">
            <li>You want a method that works before you build a career on it.</li>
            <li>You want practice with real people, not just theory.</li>
            <li>You want to know you can create an income from your impact.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Why INQ works: teal bleed, the lit loop and the glyph (2.4.3) ─── -->
  <section class="inq-why" data-tone="teal">
    <i class="lamp lamp-teal grain" aria-hidden="true" style="--lx:85%;--ly:0%;--ga:.2"></i>
    <div class="wrap">
      <div class="grid">
        <div class="inq-why-main">
          <p class="eyebrow rise">Why INQ works</p>
          <h2 class="t-l wipe">Work the surface and you create a session. Work the source and you create <em>change.</em></h2>
          <p class="t-state inq-why-state" data-lit><b class="lb">People don't stay stuck because they don't know what to do.</b> They stay stuck because of the thought they keep thinking, the feeling it creates, and the action that follows, until the result proves the thought right. INQ teaches you to see that loop, help someone see it for themselves, and help them change it.</p>
        </div>
        <div class="inq-why-aside" data-reveal-at="0.6">
          <InqLoopGlyph />
          <p class="t-s-pull inq-why-pull rise" style="--d:2s">More information doesn't change that loop. Neither does motivation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── What you get (2.4.4) ─────────────────────────────────────────── -->
  <section class="inq-sec" data-tone="ac-cream">
    <div class="wrap">
      <div class="grid inq-two">
        <div class="inq-two-head">
          <p class="eyebrow rise">What you get</p>
          <h2 class="t-m wipe">The tools, and the method that tells you <em>which one to use.</em></h2>
        </div>
        <div class="inq-two-body inq-get-body">
          <p class="t-lead rise"><b class="lb">INQ gives you a full set of coaching tools,</b> gathered in The Framework Book, for thoughts, emotions, identity, relationships, energy, and goals.</p>
          <p class="t-lead rise" style="--d:.3s"><b class="lb">Most programs stop there.</b> INQ also teaches you why people do what they do, so you know which tool a moment calls for, and why.</p>
          <p class="t-lead rise" style="--d:.4s"><b class="lb">Already coaching?</b> Your existing training doesn't go away. It gets a foundation, so everything you already use lands deeper. New to coaching? You start with both from day one.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Learn it. Live it. Lead it. (2.4.5) ──────────────────────────── -->
  <section class="inq-sec sec-alt" data-tone="ac-cream">
    <div class="wrap">
      <div class="grid">
        <div class="inq-head">
          <p class="eyebrow rise">Learn it. Live it. Lead it.</p>
          <h2 class="t-l wipe">This isn't a certification you collect. It's a method you <em>become.</em></h2>
        </div>
      </div>
      <ul class="grid inq-method" role="list">
        {[
          ["Learn it.", "Why people do what they do, and the tools that help them change it."],
          ["Live it.", "Every tool goes through your own life first: your thinking, your emotions, your relationships, your goals."],
          ["Lead it.", "Bring it into real coaching conversations. Every module ends with three written questions and a coaching moment you record."]
        ].map(([n, b], i) => (
          <li class="inq-method-col rise" style={`--d:${200 + i * 90}ms`}>
            <h3 class="t-m inq-method-name">{n}</h3>
            <i class="rule-draw inq-rule-2" aria-hidden="true"></i>
            <p class="t-body inq-method-body">{b}</p>
          </li>
        ))}
      </ul>
      <div class="grid inq-method-close">
        <div class="inq-head">
          <p class="t-s-quote inq-statement rise">You can't lead someone into what you haven't practiced <em>yourself.</em></p>
          <p class="t-lead inq-statement-line rise" style="--d:.3s">By the time you're certified, the work has already changed one person: you.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── In the room (2.4.6) ──────────────────────────────────────────── -->
  <section class="inq-sec" data-tone="ac-cream">
    <div class="wrap">
      <div class="grid inq-two">
        <div class="inq-two-head">
          <p class="eyebrow rise">In the room</p>
          <h2 class="t-m wipe">What you'll be able to do</h2>
          <p class="t-s-pull inq-room-pull rise" style="--d:.3s">Less guessing. More reps. Coaching you trust because you've done it.</p>
        </div>
        <ul class="inq-two-body inq-outcomes" role="list">
          <i class="rule-draw-v inq-outcomes-edge" aria-hidden="true"></i>
          {outcomes.map((o, i) => (
            <li class="rise" style={`--d:${200 + i * 60}ms`}><i class="rule-draw inq-hair" aria-hidden="true"></i>{o}</li>
          ))}
          <i class="rule-draw inq-hair inq-hair-last" aria-hidden="true" style="--d:620ms"></i>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── The certification: the mock-up's three by three grid (2.4.7) ──── -->
  <section id="modules" class="inq-sec sec-alt" data-tone="ac-cream">
    <div class="wrap">
      <div class="grid">
        <div class="inq-head">
          <p class="eyebrow rise">The certification</p>
          <h2 class="t-l wipe">One method, built <em>module by module.</em></h2>
        </div>
      </div>
      <ol class="inq-modules" role="list">
        {modules.map((m, i) => (
          <li class="rise-obj" style={`--d:${200 + i * 50}ms`}>
            <div class="paper inq-module">
              <h3 class="t-title inq-module-name">{m.name}</h3>
              <p class="t-body inq-module-body">{m.body}</p>
            </div>
          </li>
        ))}
        <li class="rise-obj" style="--d:600ms">
          <div class="paper-teal inq-module inq-module-bonus">
            <p class="eyebrow">Bonus</p>
            <h3 class="t-title inq-module-name">The Entrepreneurial Path</h3>
            <p class="t-body inq-module-body">Turn the work into a practice: who you serve, your offers, your pricing, and how you talk about what you do.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ── Your practice (2.4.8) ────────────────────────────────────────── -->
  <section class="inq-sec" data-tone="ac-cream">
    <div class="wrap">
      <div class="grid inq-two">
        <div class="inq-two-head inq-practice-head">
          <p class="eyebrow rise">Your practice</p>
          <h2 class="t-m wipe">You can love this work and <em>make a living at it.</em></h2>
          <p class="t-lead inq-practice-lead rise" style="--d:.3s">Whether you're starting a practice from scratch or growing the one you have, the Entrepreneurial Path and the Business Builder help you build it on purpose. People who really change tell people. Over time, that becomes how your business grows.</p>
        </div>
        <ul class="inq-two-body inq-practice-list" role="list">
          {business.map((b, i) => <li class="rise" style={`--d:${200 + i * 60}ms`}>{b}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Is INQ right for you? (2.4.9) ────────────────────────────────── -->
  <section class="inq-sec sec-alt" data-tone="ac-cream">
    <div class="wrap">
      <div class="grid">
        <div class="inq-head">
          <p class="eyebrow rise">Is INQ right for you?</p>
          <h2 class="t-l wipe">Who INQ is for</h2>
        </div>
      </div>
      <ul class="inq-who" role="list">
        {audiences.map((a, i) => (
          <li class="inq-who-col" style={`--d:${i * 100}ms`}>
            <i class="rule-draw inq-rule-2" aria-hidden="true"></i>
            <p class="t-title rise" style={`--d:${150 + i * 70}ms`}>{a.name}</p>
            <p class="t-body rise" style={`--d:${220 + i * 70}ms`}>{a.body}</p>
          </li>
        ))}
      </ul>
      <div class="grid inq-who-close">
        <p class="t-s-pull inq-who-line rise">Where you're starting matters less than the difference you want to make.</p>
      </div>
    </div>
  </section>

  <!-- ── Your investment: the one object with depth (2.4.10) ──────────── -->
  <section id="investment" class="inq-sec" data-tone="ac-cream">
    <div class="wrap">
      <div class="paper-teal paper-white inq-invest rise-obj" data-tilt="1.5">
        <div class="inq-invest-grid">
          <div class="inq-invest-l">
            <p class="eyebrow">Your investment</p>
            <h2 class="t-m inq-invest-name">INQ Certification</h2>
            <p class="t-price inq-price wipe" style="--d:.6s"><span class="cur">$</span>6,997</p>
            <p class="t-body inq-invest-pay">Payment options available</p>
            <div class="inq-btns inq-invest-btns">
              <a href={LINKS.inqEnroll} class="btn btn-teal" data-event="inq_enroll_click" data-event-location="investment">Enroll now <Arrow /></a>
              <a href={LINKS.inqBook} class="btn btn-line-teal" data-event="inq_book_click" data-event-location="investment">Book a conversation</a>
            </div>
            <p class="t-cap inq-invest-note">Not sure yet? A conversation is the best next step.</p>
          </div>
          <div class="inq-invest-r">
            <p class="t-title">What's included</p>
            <ul class="inq-lines inq-included" role="list">
              {included.map((x) => <li>{x}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── How to get started: three dots on one line (2.4.11) ──────────── -->
  <section class="inq-sec sec-alt" data-tone="ac-cream">
    <div class="wrap">
      <div class="grid">
        <div class="inq-head">
          <p class="eyebrow rise">How to get started</p>
          <h2 class="t-l wipe">Start the same day.</h2>
        </div>
      </div>
      <div class="inq-steps">
        <InqStepsLine />
        <ol class="grid inq-steps-list" role="list">
          {steps.map((s, i) => (
            <li class="inq-step rise" style={`--d:${i * 90}ms`}>
              <svg class="inq-dot" viewBox="0 0 10 10" width="10" height="10" aria-hidden="true" focusable="false"><circle class="draw-pop" cx="5" cy="5" r="5" fill="#1e5b57" style={`--d:${i * 300}ms`}></circle></svg>
              {i < steps.length - 1 && <i class="rule-draw-v inq-step-v" aria-hidden="true"></i>}
              <h3 class="t-s inq-step-name">{s.name}</h3>
              <p class="t-body inq-step-body">{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="grid inq-steps-close">
        <p class="t-lead inq-steps-line rise">Want to try the method first? Start with <a href={LINKS.certifiedMind} class="link inq-link">The Certified Mind Method</a>, the five-tool method behind INQ, in the Academy.</p>
      </div>
    </div>
  </section>

  <!-- ── Questions people ask (2.4.12) ────────────────────────────────── -->
  <section id="faq" class="inq-sec" data-tone="ac-cream">
    <div class="wrap">
      <div class="grid inq-faq">
        <div class="inq-faq-head">
          <h2 class="t-m wipe">Questions people ask</h2>
        </div>
        <div class="inq-faq-list rise" style="--d:.25s">
          <Accordion items={faq} theme="teal" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── The close: ink bleed (2.4.13) ────────────────────────────────── -->
  <section class="inq-close" data-tone="ink">
    <i class="lamp grain" aria-hidden="true" style="--lx:50%;--ly:100%;--la:.1"></i>
    <div class="wrap">
      <div class="grid">
        <div class="inq-close-in">
          <h2 class="t-l wipe inq-close-h2">You can coach a person's <em>behavior.</em> Or you can coach <em>the person.</em></h2>
          <p class="t-s-quote inq-close-line rise">One creates a session. The other creates change.</p>
          <p class="t-lead inq-close-lead rise" style="--d:.3s">INQ is for anyone who's decided which one they're here to do.</p>
          <div class="inq-btns inq-close-btns rise" style="--d:.4s">
            <a href={LINKS.inqEnroll} class="btn btn-cream" data-event="inq_enroll_click" data-event-location="close">Enroll now <Arrow /></a>
            <a href={LINKS.inqBook} class="btn btn-line" data-event="inq_book_click" data-event-location="close">Book a conversation</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* INQ page layout. Every value is from BUILD_SPEC 2.4; the system's classes
   * do the type, colour, surfaces and motion. Prefixed inq- throughout. */
  .inq-sec { padding-block: var(--sec); }
  .inq-head { grid-column: 1 / span 8; }
  .inq-head-lead { margin-top: var(--lead-gap); color: var(--fg-2); }
  .inq-btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: var(--btn-gap); }
  .inq-btns .btn { flex: none; }
  .theme-teal b.lb { font-weight: inherit; }

  /* 2.4.1 Hero */
  /* The h1 is four lines at every desktop width ("Coach the transformation"
   * alone is 11.5em), so the copy starts 14 px above the spec's y 162, the
   * motto sits 20 px under the buttons and the values row --head-gap + 8
   * under it: at 1440 x 900 the four rules draw and the names rise inside
   * the first screen; at 1280 x 800 the rules do. The rule's box reaches
   * 47 px above its line so the row's entrance is observed while the line is
   * still at the bottom edge of the viewport. */
  .inq-hero { padding-top: calc(var(--nav-h) + 76px); padding-bottom: var(--sec); }
  .inq-hero > .lamp { z-index: 0; }
  .inq-hero-copy { grid-column: 1 / span 9; }
  .inq-h1 { max-width: 10em; margin: 0; }
  .inq-lede { margin-top: var(--lead-gap); color: var(--fg-2); }
  .inq-motto { margin-top: 20px; color: var(--fg); }
  .inq-values { list-style: none; margin: calc(var(--head-gap) + 8px) 0 0; padding: 0; row-gap: 40px; }
  .inq-value { grid-column: span 3; position: relative; }
  .inq-rule { display: block; position: absolute; left: 0; right: 0; top: -47px; height: 48px; border-bottom: 1px solid #1e5b57; pointer-events: none; }
  .inq-rule-2 { display: block; height: 2px; background: #1e5b57; }
  /* The 22 px under the rule belongs to the name, and the name's box reaches
