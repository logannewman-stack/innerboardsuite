---
/**
 * The page Vercel serves for any address that is not on the site (a static build's 404.html). Not indexed, not in
 * the sitemap.
 */
import Layout from "../layouts/Practice.astro";
import { ROUTES } from "../config/links";
---
<Layout title="This page isn’t here · The Practice" description="This page isn’t here. You can lead the life you want. It just takes practice." path="/404" noindex>
  <section class="view">
    <div class="phero nf">
      <div class="wrap center stack">
        <p class="eyebrow">Life takes reps.</p>
        <h1>This page isn’t here.</h1>
        <div class="ctas" style="justify-content:center"><a class="btn btn-solid" href={ROUTES.app}>Start Practicing <span class="arr">→</span></a><a class="btn btn-line" href={ROUTES.home}>Go to the homepage</a></div>
      </div>
    </div>
  </section>
</Layout>
