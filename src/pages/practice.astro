---
/**
 * innerboardsuite.com/practice
 *
 * The Practice page is a demonstration. Every screen on it is a real
 * capture of the app as built on October 19, 2026, taken as a visitor with
 * no account: the Coach home, a Dare checked off, Set Up Your Day filled in,
 * a STEAR run from "What happened?" to "What else might be true?", RAP, the
 * subscription quiz from its welcome to its result, the Journal, and the
 * Company OS Score. The copy on the screens is the app's own. The page
 * walks a visitor through one day, then through one tool, then the quiz.
 */
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import AppPhone from "../components/AppPhone.astro";
import AppDesktop from "../components/AppDesktop.astro";
import Accordion from "../components/Accordion.astro";
import { LINKS } from "../config/links";

const title = "Practice by InnerBoard · See how it works";
const description =
  "A walk through Practice, screen by screen: the Daily Practice Coach, the Dare of the Day, Set Up Your Day, the STEAR tool, the subscription quiz and the Journal. A web app for the home screen of any phone. Start as you are.";

/* One day, in the order it goes. Each step names the real screen it shows. */
const day = [
  { n: "01", when: "Morning, 7:10", screen: "home", name: "Open the app. The Coach is first.", body: "Home shows four things: the Coach's prompt, Set Up Your Day, the Dare of the Day, and your calendar. Nothing to configure. The Coach is trained on the InnerBoard method and says, on screen, that it is not a person." },
  { n: "02", when: "Morning, 7:12", screen: "today", name: "Set up your day in a minute.", body: "How are you arriving? One thing you are grateful for. How you want to approach today. What would make today a win. Four fields, one line each, and the day has a shape." },
  { n: "03", when: "Midday, 1:40", screen: "stear2", name: "Something lands. You run STEAR.", body: "A business partner goes quiet after you send the numbers. Instead of rereading your message for an hour, you open STEAR: what happened, what you made it mean, what that thought created. Two minutes, and the story is separated from the fact." },
  { n: "04", when: "Afternoon, 4:05", screen: "dare", name: "Do the Dare. Check it off.", body: "One small thing before the day ends, new every day. When you tap I did it, the app marks it with a star, asks how it went in one line, and never asks twice." },
  { n: "05", when: "Evening", screen: "journal", name: "Everything you did is in the Journal.", body: "Every tool you ran, every check-in, every quiz result, dated and yours. Saved on the device as a visitor. Kept in your account the moment you make one." }
];

/* The STEAR run, as the app asks it. Frames are real captures of each step. */
const stear = [
  { screen: "stear1", step: "1 / 8", q: "What happened?", note: "Facts only. What a camera would record." },
  { screen: "stear2", step: "2 / 8", q: "What did you make it mean?", note: "One sentence. Where did you inherit this one?" },
  { screen: "stear3", step: "3 / 8", q: "What did that thought create?", note: "One word. The thought created it, not the situation." },
  { screen: "stear4", step: "4 / 8", q: "What did you do, or avoid?", note: "Defend? Stall? Retaliate? Ruminate?" },
  { screen: "stear5", step: "5 / 8", q: "What did that create?", note: "Notice how the result proves the original thought right." },
  { screen: "stear6", step: "6 / 8", q: "What else might be true?", note: "How could you be wrong about this? What would your highest self see?" }
];

const faq = [
  { q: "Is it an app I download?", a: "Practice is a web app. Open it in your browser, add it to the home screen on iPhone or Android, and it opens like any other app. There is nothing to find in the App Store or Google Play." },
  { q: "Do I need an account to start?", a: "No. The quiz, the book assessments, the quick tools and a first conversation with the Coach work without one. Every screen on this page was captured as a visitor with no account. Saving your results is the moment an account is created, and nothing asks for a card to do it." },
  { q: "Is the Coach a person?", a: "No. The Daily Practice Coach is trained on the InnerBoard method and the material behind it. It is coaching, not therapy, and it says so before your first message." },
  { q: "Who can see what I write?", a: "Nobody. Every entry belongs to the person who wrote it. Inside InnerBoard OS, a leader sees how much of a module a team has completed, never what anyone answered." },
  { q: "How much time does it take?", a: "Set Up Your Day is about a minute. A tool is about two. Sunday Set is six, once a week. The point is a practice you keep, not a program you finish." },
  { q: "What does a subscription include?", a: `Everything in the app, including the Academy and the Wisdom Collective. The current plans and prices are shown inside Practice under Membership. <a class="link-arrow" href="${LINKS.practice}">Open Practice</a>` }
];
---
<Base title={title} description={description} path="/practice">
  <!-- ── Hero: one statement, the real app ─────────────────────────────── -->
  <section class="relative overflow-hidden bg-cream">
    <div class="wrap relative pt-[120px] sm:pt-[150px]">
      <div class="reveal is-in mx-auto max-w-[920px] text-center">
        <p class="eyebrow">Practice by InnerBoard</p>
        <h1 class="mt-5 text-[46px] sm:text-[66px] lg:text-[84px] leading-[0.96] text-ink tracking-[-0.025em]" data-words>People don't do what they know. <em class="text-gold-ink">They do who they are.</em></h1>
        <p class="mt-7 mx-auto max-w-[640px] text-[17px] sm:text-[20px] leading-relaxed text-ink-muted">Practice is the daily app that closes the gap between the two. Here is how it works, screen by screen, as it looks today.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
          <a href={LINKS.practice} class="btn btn-gold" data-passthrough data-event="practice_click" data-event-location="practice-hero">Start in Practice <Arrow /></a>
          <a href="#day" class="btn btn-outline">Walk through a day</a>
        </div>
      </div>
    </div>
    <div class="reveal is-in relative mt-14 sm:mt-20" style="--d:150ms">
      <div class="wrap">
        <div class="relative mx-auto max-w-[1120px]">
          <div class="hidden lg:block absolute left-0 bottom-0 z-[2]"><AppPhone screen="stear2" width={230} alt="STEAR, step two of eight: What did you make it mean? with a sentence typed in." /></div>
          <div class="hidden lg:block absolute right-0 bottom-0 z-[2]"><AppPhone screen="quiz-results" width={230} alt="The subscription quiz result: Approval, what you're paying for, what it's costing you, and your first step." /></div>
          <div class="relative z-[1] lg:mx-[150px]" data-tilt="2"><AppDesktop screen="desk-home" alt="Practice on a desktop: the Daily Practice Coach prompt, the Dare of the Day, Set Up Your Day and the October calendar." eager /></div>
        </div>
      </div>
      <div class="absolute inset-x-0 bottom-0 h-[40%] bg-cream-2" aria-hidden="true"></div>
    </div>
    <div class="relative bg-cream-2 border-b border-line">
      <div class="wrap py-4 text-center text-[12.5px] text-ink-faint">Every screen on this page is a capture of the app as built, taken as a visitor with no account. Nothing is drawn.</div>
    </div>
  </section>

  <!-- ── Section one · The loop ─────────────────────────────────────────── -->
  <section id="loop" class="on-dark bg-charcoal text-cream relative overflow-hidden aurora" data-glow>
    <span class="aurora-2"></span>
    <div class="wrap py-24 sm:py-36 text-center">
      <p class="eyebrow">Section one · The loop</p>
      <h2 class="reveal mt-6 mx-auto max-w-[900px] text-[36px] sm:text-[54px] lg:text-[64px] leading-[1.02]">A situation is neutral until you put a sentence on it. <em>Everything after that is downstream.</em></h2>
      <ol class="reveal mt-14 mx-auto max-w-[520px] space-y-0 font-display text-[26px] sm:text-[34px] leading-[1.1]" style="--d:120ms">
        {[["Situation", "What a camera would record."], ["Thought", "The sentence you added."], ["Emotion", "What the thought creates."], ["Action", "What that state makes available."], ["Result", "Which proves the thought right."]].map(([w, d], i) => (
          <li class="py-4">
            {i > 0 && <span class="block mx-auto w-px h-6 bg-gold-2/40 mb-4" aria-hidden="true"></span>}
            <span class="text-cream">{w}</span> <em class="text-gold-2">{d}</em>
          </li>
        ))}
      </ol>
      <p class="reveal mt-12 mx-auto max-w-[560px] text-[17px] leading-relaxed text-on-dark-muted" style="--d:200ms">Most people try to change the result. It almost never lasts. Every tool in Practice is a way of changing the sentence, in the moment it is being written.</p>
    </div>
  </section>

  <!-- ── Section two · A day in Practice (sticky story, real screens) ────── -->
  <section id="day" class="bg-cream">
    <div class="wrap py-20 sm:py-28">
      <div class="reveal max-w-[760px]">
        <p class="eyebrow">Section two · A day in Practice</p>
        <h2 class="mt-5 text-[36px] sm:text-[52px] text-ink">One day, <em>as it actually goes.</em></h2>
        <p class="mt-5 text-[16.5px] leading-relaxed text-ink-muted">Scroll, and the phone follows the day. Each screen is the app, not a picture of it.</p>
      </div>
      <div data-story class="mt-14 grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-20">
        <div class="hidden lg:block">
          <div class="sticky top-[104px] flex justify-center">
            <div class="screens w-[320px] aspect-[600/1299]">
              {day.map((d, i) => (
                <div data-screen={d.screen + i} class={i === 0 ? "is-active" : ""}><AppPhone screen={d.screen} width={320} alt="" /></div>
              ))}
            </div>
          </div>
        </div>
        <ol>
          {day.map((item, i) => (
            <li data-step={String(i)} data-step-screen={item.screen + i} class="lg:min-h-[70vh] flex items-center py-6 lg:py-0">
              <div class="w-full">
                <div class="flex items-baseline gap-4">
                  <span class="font-display text-[44px] sm:text-[56px] leading-none text-gold">{item.n}</span>
                  <span class="eyebrow">{item.when}</span>
                </div>
                <h3 class="mt-4 text-[28px] sm:text-[36px] leading-[1.08] text-ink">{item.name}</h3>
                <p class="mt-4 text-[16px] sm:text-[17px] leading-relaxed text-ink-muted max-w-[520px]">{item.body}</p>
                <div class="lg:hidden mt-7 flex justify-center">
                  <AppPhone screen={item.screen} width={250} alt={item.name} />
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ── Section three · One tool, start to finish ───────────────────────── -->
  <section id="stear" class="bg-cream-2 overflow-hidden">
    <div class="wrap py-20 sm:py-28">
      <div class="reveal grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-end">
        <div>
          <p class="eyebrow">Section three · One tool, start to finish</p>
          <h2 class="mt-5 text-[36px] sm:text-[52px] text-ink">STEAR, <em>as the app asks it.</em></h2>
        </div>
        <p class="text-[16.5px] leading-relaxed text-ink-muted lg:pb-2">Eight questions, one at a time, each with a line of help under it. The example is a real run: a business partner went quiet after the numbers were sent. By question six, the person is writing what else might be true.</p>
      </div>
      <ol class="rail mt-12 flex gap-6 overflow-x-auto snap-x snap-mandatory pb-6 -mx-5 px-5 sm:-mx-8 sm:px-8" aria-label="The STEAR steps">
        {stear.map((s) => (
          <li class="snap-start shrink-0 w-[250px] sm:w-[270px]">
            <AppPhone screen={s.screen} width={250} alt={`STEAR ${s.step}: ${s.q}`} class="mx-auto" />
            <p class="mt-5 eyebrow">{s.step}</p>
            <p class="mt-1 font-display text-[20px] leading-[1.15] text-ink">{s.q}</p>
            <p class="mt-1.5 text-[13.5px] text-ink-muted leading-snug">{s.note}</p>
          </li>
        ))}
        <li class="snap-start shrink-0 w-[250px] sm:w-[270px] flex items-center">
          <div class="card p-6">
            <p class="eyebrow">Then</p>
            <p class="mt-2 font-display text-[20px] leading-[1.15] text-ink">A new thought, and the next move.</p>
            <p class="mt-2 text-[13.5px] text-ink-muted leading-snug">Questions seven and eight. The run is saved to your Journal, and the Coach can talk it through.</p>
            <a href={LINKS.practice} class="link-arrow mt-4 text-[14px]" data-passthrough>Run it yourself <Arrow /></a>
          </div>
        </li>
      </ol>
      <div class="reveal mt-6 grid gap-6 md:grid-cols-3 text-[14.5px] text-ink-muted">
        <p><span class="font-semibold text-ink">RAP</span> when a feeling has you: name it in one word, find it in the body, and let it pass. Five steps.</p>
        <p><span class="font-semibold text-ink">Pause + Redirect</span> when you are about to lose control. The ten-second read when you want to know how you are arriving.</p>
        <p><span class="font-semibold text-ink">Sixteen tools</span> in all, each named for the moment it is for, with the method's name beside it. Run them without an account; a membership keeps them.</p>
      </div>
    </div>
  </section>

  <!-- ── Section four · The quiz ─────────────────────────────────────────── -->
  <section id="quiz" class="bg-cream">
    <div class="wrap py-20 sm:py-28">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-center">
        <div class="reveal">
          <p class="eyebrow">Section four · Where most people start</p>
          <h2 class="mt-5 text-[36px] sm:text-[52px] text-ink">What are you <em class="text-gold-ink">subscribing to?</em></h2>
          <p class="mt-5 text-[16.5px] leading-relaxed text-ink-muted max-w-[520px]">Eighteen questions about the last thirty days, the way it actually went. No sign-in. The result names the pattern you are paying for most, what it is costing you, where, and one first step. The run on the right came back Approval.</p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href={LINKS.quiz} class="btn btn-dark" data-passthrough data-event="quiz_click" data-event-location="practice-quiz">Take the quiz <Arrow /></a>
          </div>
          <p class="mt-4 text-[13px] text-ink-faint">A reflection tool, not a clinical assessment. Four minutes.</p>
        </div>
        <div class="reveal flex justify-center gap-4 sm:gap-6 items-end" style="--d:120ms">
          <AppPhone screen="quiz-q1" width={210} alt="Quiz question one of eighteen: When I get less done than I planned, I'm disappointed in myself. Never to Almost always." class="hidden sm:block" />
          <AppPhone screen="quiz-results" width={250} alt="Quiz result: Approval. What you're paying for, what it's actually costing you, where you're paying, and your first step." />
        </div>
      </div>
    </div>
  </section>

  <!-- ── Section five · Yours ────────────────────────────────────────────── -->
  <section id="private" class="on-dark bg-navy text-cream relative overflow-hidden aurora" data-glow>
    <span class="aurora-2"></span>
    <div class="wrap py-24 sm:py-36">
      <p class="eyebrow">Section five · Yours</p>
      <p class="mt-6 font-display text-[28px] sm:text-[40px] lg:text-[48px] leading-[1.15] tracking-[-0.015em] max-w-[1000px]" data-scrollwords>
        Everything you write in Practice belongs to you. It is kept under your own account, nobody at InnerBoard reads it, and inside InnerBoard OS a leader sees module completion, never your answers. There is nothing to install. Practice runs in your browser, sits on the home screen of iPhone and Android, keeps working when the signal drops, and picks up where you left off.
      </p>
    </div>
  </section>

  <!-- ── Section six · Everything inside ─────────────────────────────────── -->
  <section id="inside" class="bg-cream-2">
    <div class="wrap py-20 sm:py-28">
      <div class="reveal max-w-[760px]">
        <p class="eyebrow">Section six · Everything inside</p>
        <h2 class="mt-5 text-[36px] sm:text-[52px] text-ink">One account. <em>One place.</em></h2>
        <p class="mt-5 text-[16.5px] leading-relaxed text-ink-muted">The Coach, the tools, the Academy, Inner Lab, the book and InnerBoard OS share one left rail on a desk, and one bottom bar on a phone.</p>
      </div>
      <div class="reveal mt-12 grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-start">
        <div data-tilt="2"><AppDesktop screen="desk-score" alt="The Company OS Score inside Practice: ten statements scored one to ten." /></div>
        <ul class="divide-y divide-line">
          {[
            ["The Academy", "Every collection, read and practiced in the same place.", LINKS.academy, false],
            ["Inner Lab", "Live sessions each month, the masterclass open to anybody, and a community.", LINKS.innerlab, true],
            ["The Book", "Replaceable: the book, the audiobook, its assessments and worksheets, with each chapter's door into the practice.", LINKS.book, true],
            ["InnerBoard OS", "The Company OS Score, the Team OS Score and the Gap Audit, and the curriculum a team works through.", LINKS.ios, false]
          ].map(([n, b, href, pass]) => (
            <li class="py-5 first:pt-0">
              <a href={href as string} class="group flex items-baseline justify-between gap-4" data-passthrough={pass ? true : undefined} rel={(href as string).startsWith("http") ? "noopener" : undefined}>
                <span><span class="font-display text-[24px] text-ink group-hover:text-gold-ink transition-colors">{n}</span><span class="block mt-1 text-[14.5px] text-ink-muted">{b}</span></span>
                <span class="text-gold-ink"><Arrow /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Section seven · Levels and questions ────────────────────────────── -->
  <section id="levels" class="bg-cream">
    <div class="wrap py-20 sm:py-28">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr]">
        <div class="reveal">
          <p class="eyebrow">Section seven · Start as a visitor</p>
          <h2 class="mt-5 text-[36px] sm:text-[48px] text-ink">Three levels. <em>No card to start.</em></h2>
          <ol class="mt-8 divide-y divide-line">
            {[["Visit", "Open the quiz, take a book assessment, run a quick tool, have a first conversation with the Coach. No sign-in. Your work stays on your device."], ["Account", "Saving your results is the moment an account exists. Everything on the device moves into it, and it is there next time, on any phone."], ["Subscribe", "Everything in the app: the full tools, the Coach without limits, the Academy, Inner Lab, and the Wisdom Collective. Plans and prices are inside the app, under Membership."]].map(([n, b], i) => (
              <li class="py-5 grid grid-cols-[48px_1fr] gap-3">
                <span class="font-display text-[32px] leading-none text-gold">{i + 1}</span>
                <div><p class="font-display text-[22px] text-ink">{n}</p><p class="mt-1 text-[15px] leading-relaxed text-ink-muted">{b}</p></div>
              </li>
            ))}
          </ol>
        </div>
        <div class="reveal" style="--d:100ms">
          <p class="eyebrow">Questions</p>
          <div class="mt-4"><Accordion items={faq} /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Final ───────────────────────────────────────────────────────────── -->
  <section class="on-dark bg-forest text-cream relative overflow-hidden aurora" data-glow>
    <span class="aurora-2"></span>
    <div class="wrap py-24 sm:py-32 text-center">
      <div class="reveal mx-auto max-w-[820px]">
        <h2 class="text-[40px] sm:text-[60px]">Start today, <em>as you are.</em></h2>
        <p class="mt-5 text-[17px] leading-relaxed text-on-dark-muted">Open the app, take the quiz, or bring the Coach the thing that is on your mind. Nothing is asked of you first.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
          <a href={LINKS.practice} class="btn btn-gold" data-passthrough data-event="practice_click" data-event-location="final">Start in Practice <Arrow /></a>
          <a href={LINKS.quiz} class="btn btn-outline-light" data-passthrough data-event="quiz_click" data-event-location="final">What's Holding You Back?</a>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .rail { scrollbar-width: none; }
  .rail::-webkit-scrollbar { display: none; }
</style>
