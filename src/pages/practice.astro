---
/**
 * innerboardsuite.com/practice
 *
 * The Practice page is a demonstration. Every screen on it is a real
 * capture of the app as built on October 19, 2026, taken as a visitor with
 * no account: the Coach home, a Dare checked off, Set Up Your Day filled in,
 * a STEAR run from "What happened?" to "What else might be true?", RAP, the
 * subscription quiz from its welcome to its result, the Journal, and the
 * Company OS Score. The copy on the screens is the app's own. The page
 * walks a visitor through one day, then through one tool, then the quiz.
 *
 * Every app demonstration is a scroll story (SCROLL_SPEC section 2, S4 to S8;
 * SYSTEM_API sections 10 and 12) on the step layout (STORY_V2 part 1 and 3.1
 * to 3.5): as the reader scrolls, the device stays pinned on one side with the
 * segmented rail and its "01 / 05" counter beside it, and the other side shows
 * one step at a time (an eyebrow, a headline, a body, the section's button
 * where it has one); the copy and the screen change together at each step,
 * then the page continues. Scrolling back plays it backwards; nothing moves on
 * a timer. Sides alternate down the page.
 * - The hero scene (S4, left): on laptops the desk window with the Close the
 *   day phone at its lower right, three steps (the Coach leaned in, the cursor
 *   opens Tools, Close the day scrolls); on tablets and phones a phone, two
 *   steps (the Tools hub, Close the day). The headlines are its captions.
 * - A day in Practice (S5, right): DayStage, five steps, morning to evening.
 * - STEAR (S6, left): the phone on the linen mat, question by question; the
 *   app's own folio is the eyebrow, so the rail has no counter.
 * - The quiz pair (S7, right): the paragraph's two halves as two steps, with
 *   "Take the quiz" pinned under them.
 * - Everything inside (S8, left): PracticeInside, the desk window (a phone on
 *   tablets and phones) one rail item at a time, each row's link the step.
 * - The final's floor (S11) drifts with the scroll only.
 * Without the script, under reduced motion and on short or landscape screens
 * every story is static: every step stacked with its own figure (the hero and
 * the quiz keep their devices on the rest frame), no rail, no counter.
 */
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import PhoneFrame from "../components/PhoneFrame.astro";
import WindowFrame from "../components/WindowFrame.astro";
import StoryMarks from "../components/StoryMarks.astro";
import DayStage from "../components/DayStage.astro";
import Geo from "../components/Geo.astro";
import Accordion from "../components/Accordion.astro";
import PracticeLoopLine from "../components/PracticeLoopLine.astro";
import PracticeInside from "../components/PracticeInside.astro";
import PracticeFloor from "../components/PracticeFloor.astro";
import { LINKS } from "../config/links";

const title = "Practice by InnerBoard · See how it works";
const description =
  "A walk through Practice, screen by screen: the Coach, the Dare of the Day, Set Up Your Day, STEAR, the quiz and the Journal. A web app for any phone. Start as you are.";

/* The loop, five rows. */
const loopRows: [string, string][] = [
  ["Situation", "What a camera would record."],
  ["Thought", "The sentence you added."],
  ["Emotion", "What the thought creates."],
  ["Action", "What that state makes available."],
  ["Result", "Which proves the thought right."]
];

/* S4 (STORY_V2 3.1): the hero scene on the step layout. The window's two frames; the Close the day phone tucked in
 * front of its lower right (laptops); the phone that takes the window's place on tablets and phones. Three steps
 * on laptops, two on tablets and phones (the first is the desk's own). The steps' headlines are the scene's own
 * captions; they have no body. */
const heroWin = [
  { name: "desk-coach-draft", alt: "Practice on a desk: the Daily Practice Coach with a sentence typed, the Dare of the Day, Set Up Your Day and the October calendar.", x2: true },
  { name: "desk-tools-home", alt: "The Tools hub on a desk: start with the moment you're in, Set Up Your Day and the Right now prompts.", x2: true }
];
const heroTools = { name: "tools-home", alt: "The Tools hub on a phone, with Tools active in the bottom bar.", w: 780 as const, h: 1688 as const };
const heroClose = { name: "close-day", alt: "Close the day on a phone, with both fields filled and Coach active in the bottom bar.", w: 780 as const, h: 1688 as const, strip: { next: "close-day-2", at: 132.56, head: 6.2, foot: 91.2 } };
const heroSteps = [
  { step: 0, only: "wide", w: 1, eyebrow: "Coach", name: "The Coach home, on a desk, with a sentence typed.",
    act: '{"win":{"f":0,"cam":[[.14,1,50,50],[.4,1.1,58,22],[.7,1.1,58,22],[.88,1,50,50]]}}' },
  { step: 1, only: undefined, w: 1, eyebrow: "Tools", name: "The Tools hub.",
    act: '{"win":{"cur":[[.06,40,60],[.34,5,33.3]],"click":.42,"next":[.46,1]},"pn":{"f":0}}' },
  { step: 2, only: undefined, w: 1.2, eyebrow: "Tools", name: "Close the day.",
    act: '{"win":{"cur":[[.1,5,33.3],[.36,78,23.1]]},"close":{"lift":[.06,.16],"scroll":[.24,.84,0,132.56]},"pn":{"f":1,"scroll":[.24,.84,0,132.56]}}' }
];

/* S5: one day, in the order it goes. The phone's frames (the acts' indices refer to them): `today` is a group
 * (type: []) so the page's crop transform sits inside it and the wipe starts at the ring's y. */
const dayFrames = [
  { name: "home", alt: "The Coach home as a visitor: the Daily Practice Coach, the Dare of the Day and Set Up Your Day.", w: 600 as const, h: 1298 as const },
  { name: "today", alt: "Set Up Your Day, with the ten-second read and two fields filled.", w: 600 as const, h: 1298 as const, type: [] },
  { name: "stear1", alt: "STEAR, question one, with the fact written.", w: 600 as const, h: 1298 as const },
  { name: "stear2", alt: "STEAR, question two, with the thought written.", w: 600 as const, h: 1298 as const },
  { name: "dare", alt: "The home after the Dare is checked, with the star line.", w: 600 as const, h: 1298 as const },
  { name: "journal", alt: "The Journal, with one entry on this device.", w: 600 as const, h: 1298 as const }
];
const daySteps = [
  { label: "Morning", name: "Open the app. The Coach is first.", body: "Home shows four things: the Coach's prompt, Set Up Your Day, the Dare of the Day, and your calendar. Nothing to configure. The Coach is trained on the InnerBoard method and says, on screen, that it is not a person.", caption: "The Coach home.",
    act: '{"day":{"f":0,"cam":[[.14,1,50,50],[.4,1.04,50,14],[.7,1.04,50,14],[.88,1,50,50]]}}' },
  { label: "Morning", name: "Set up your day in a minute.", body: "How are you arriving? One thing you are grateful for. How you want to approach today. What would make today a win. Four fields, one line each, and the day has a shape.", caption: "Set Up Your Day.",
    act: '{"day":{"f":1,"in":[80,78.3]}}' },
  { label: "Midday", name: "Something lands. You run STEAR.", body: "A business partner goes quiet after you send the numbers. Instead of rereading your message for an hour, you open STEAR: what happened, what you made it mean, what that thought created. Two minutes, and the story is separated from the fact.", caption: "STEAR, question one, then question two.",
    act: '{"day":{"f":2,"tap":[50,95.1,.55],"next":[.59,3]}}' },
  { label: "Afternoon", name: "Do the Dare. Check it off.", body: "One small thing before the day ends, new every day. When you tap I did it, the app marks it with a star, asks how it went in one line, and never asks twice.", caption: "The Dare, done.",
    act: '{"day":{"f":0,"cam":[[.12,1,50,50],[.32,1.04,50,64],[.74,1.04,50,64],[.88,1,50,50]],"tap":[19,69.2,.5],"next":[.54,4]}}' },
  { label: "Evening", name: "Everything you did is in the Journal.", body: "Every tool you ran, every check-in, every quiz result, dated and yours. Saved on the device as a visitor. Kept in your account the moment you make one.", caption: "The Journal.",
    act: '{"day":{"f":5}}' }
];

/* S6: the STEAR run, as the app asks it. Frames are real captures of each step. Continue is pressed into
 * questions two and three; questions four to six arrive from the top (their Continue is disabled in the
 * captures, so no ring presses it). The Then row holds question six: no capture shows seven, eight or the run in
 * the Journal. The lean is 1.04 about the centre (SCROLL_SPEC writes 1.06, which crops the app's Back chevron and
 * its header icon on these captures; 1.04 keeps both whole, as the day's leans do). */
const stear = [
  { screen: "stear1", step: "1 / 8", w: 1, q: "What happened?", note: "Facts only. What a camera would record.",
    act: '{"stear":{"f":0,"cam":[[.14,1,50,50],[.38,1.04,50,24],[.66,1.04,50,24],[.86,1,50,50]]}}' },
  { screen: "stear2", step: "2 / 8", w: 1, q: "What did you make it mean?", note: "One sentence. Where did you inherit this one?",
    act: '{"stear":{"f":1,"in":[50,95.1],"cam":[[.14,1,50,50],[.38,1.04,50,24],[.66,1.04,50,24],[.86,1,50,50]]}}' },
  { screen: "stear3", step: "3 / 8", w: 1, q: "What did that thought create?", note: "One word. The thought created it, not the situation.",
    act: '{"stear":{"f":2,"in":[50,95.1]}}' },
  { screen: "stear4", step: "4 / 8", w: .85, q: "What did you do, or avoid?", note: "Defend? Stall? Retaliate? Ruminate?",
    act: '{"stear":{"f":3}}' },
  { screen: "stear5", step: "5 / 8", w: .85, q: "What did that create?", note: "Notice how the result proves the original thought right.",
    act: '{"stear":{"f":4}}' },
  { screen: "stear6", step: "6 / 8", w: .85, q: "What else might be true?", note: "How could you be wrong about this? What would your highest self see?",
    act: '{"stear":{"f":5}}' }
];
const stearFrames = stear.map((s) => ({ name: s.screen, alt: `STEAR, ${s.q}`, w: 600 as const, h: 1298 as const }));
const thenName = "A new thought, and the next move.";
/* The Then step holds question six (no capture shows seven, eight or the run in the Journal): the lean reads its
 * written answer, as questions one and two do (STORY_V2 3.3). */
const thenAct = '{"stear":{"cam":[[.12,1,50,50],[.36,1.04,50,24],[.74,1.04,50,24],[.88,1,50,50]]}}';
const stearW = stear.reduce((t, s) => t + s.w, 0) + 1;

/* The three notes under STEAR, each with its tile. */
const notes = [
  { lead: "RAP", rest: " when a feeling has you: name it in one word, find it in the body, and let it pass. Five steps.", caption: "RAP, step one of five.", screen: "rap1", alt: "RAP, step one of five: what are you feeling, with frustrated chosen.", w: 600, h: 1298 },
  { lead: "Pause + Redirect", rest: " when you are about to lose control. The ten-second read when you want to know how you are arriving.", caption: "Pause + Redirect, one breath.", screen: "pause-breath", alt: "Pause + Redirect, one breath: the ring counting down.", w: 780, h: 1688 },
  { lead: "Sixteen tools", rest: " in all, each named for the moment it is for, with the method's name beside it. Run them without an account; a membership keeps them.", caption: "The ten-second read.", screen: "arriving-quadrant", alt: "The ten-second read: how are you arriving, with a quadrant chosen.", w: 780, h: 1688 }
];

/* S7: the quiz pair. Two steps: the ring presses Often on question one (no answered capture exists, so the tap
 * changes nothing on that phone), then the light moves to the result and the result phone leans on Approval. */
const quizActs = [
  '{"q":{"f":0,"tap":[50,52.1,.55]}}',
  '{"r":{"f":0,"cam":[[.14,1,50,50],[.4,1.04,50,34],[.7,1.04,50,34],[.88,1,50,50]]}}'
];
/* The paragraph's two halves (STORY_V2 3.4), each split at its sentence boundary into a headline and a body; in the
 * static layout the spans read as today's one paragraph. */
const quizSteps = [
  { h: "Eighteen questions about the last thirty days, the way it actually went.", b: "No sign-in.", act: quizActs[0] },
  { h: "The result names the pattern you are paying for most, what it is costing you, where, and one first step.", b: "The run on the right came back Approval.", act: quizActs[1] }
];

const levels = [
  ["Visit", "Open the quiz, take a book assessment, run a quick tool, have a first conversation with the Coach. No <span class=\"nb\">sign-in</span>. Your work stays on your device."],
  ["Account", "Saving your results is the moment an account exists. Everything on the device moves into it, and it is there next time, on any phone."],
  ["Subscribe", "Everything in the app: the full tools, the Coach without limits, the Academy, Inner Lab, and the Wisdom Collective. Plans and prices are inside the app, under Membership."]
];

const faq = [
  { q: "Is it an app I download?", a: "Practice is a web app. Open it in your browser, add it to the home screen on iPhone or Android, and it opens like any other app. There is nothing to find in the App Store or Google Play." },
  { q: "Do I need an account to start?", a: "No. The quiz, the book assessments, the quick tools and a first conversation with the Coach work without one. Every screen on this page was captured as a visitor with no account. Saving your results is the moment an account is created, and nothing asks for a card to do it." },
  { q: "Is the Coach a person?", a: "No. The Daily Practice Coach is trained on the InnerBoard method and the material behind it. It is coaching, not therapy, and it says so before your first message." },
  { q: "Who can see what I write?", a: "Nobody. Every entry belongs to the person who wrote it. Inside InnerBoard OS, a leader sees how much of a module a team has completed, never what anyone answered." },
  { q: "How much time does it take?", a: "Set Up Your Day is about a minute. A tool is about two. Sunday Set is six, once a week. The point is a practice you keep, not a program you finish." },
  { q: "What does a subscription include?", a: `Everything in the app, including the Academy and the Wisdom Collective. The current plans and prices are shown inside Practice under Membership. <a href="${LINKS.practice}" data-passthrough>Open Practice</a>` }
];
---
<Base title={title} description={description} path="/practice">
  <!-- Hero: the copy scrolls away first; then the scene is a scroll story (S4) -->
  <section class="pr-hero grain grain-cream" data-tone="cream">
    <i class="lamp lamp-cream" aria-hidden="true" style="--lx:50%;--ly:0%"></i>
    <div class="wrap pr-hero-wrap">
      <div class="grid">
        <div class="pr-hero-copy">
          <p class="eyebrow rise" style="--d:.45s">Practice by InnerBoard</p>
          <h1 class="t-xl pr-h1" data-lines><span class="hl">People don't do what they know.</span> <em class="hl">They do who they are.</em></h1>
          <p class="t-lead pr-lead rise" style="--d:.52s">Practice is the daily app that closes the gap between the two. Here is how it works, screen by screen, as it looks today.</p>
          <div class="pr-btns rise" style="--d:.6s">
            <a href={LINKS.practice} class="btn btn-gold" data-passthrough data-event="practice_click" data-event-location="practice-hero">Start in Practice <Arrow /></a>
            <a href="#day" class="btn btn-line">Walk through a day</a>
          </div>
        </div>
      </div>
    </div>
    <!-- The strap line follows the buttons in the document (the page's promise is read before the captions); the flex order places it under the scene. -->
    <div class="wrap pr-strap rise" style="--d:.9s">
      <div class="grid">
        <i class="pr-strap-rule" aria-hidden="true"></i>
        <p class="t-cap pr-strap-line">Every screen on this page is a capture of the app as built, taken as a visitor with no account. Nothing is drawn.</p>
      </div>
    </div>
    <div class="story wrap pr-scene" data-story="practice-hero" data-story-ui="steps" data-side="left" data-kind="win" data-story-static="device" data-warm style="--story-w:3.2;--story-w-n:2.2;--step-l:60svh;--step-l-n:58svh">
      <div class="story-track">
        <div class="story-stage">
          <div class="story-device-col">
            <StoryMarks variant="rail" labels={heroSteps.map((s) => s.name)} steps={heroSteps.map((s) => s.step)} only={heroSteps.map((s) => s.only)} label="Practice on a desk, then on a phone" />
            <div class="story-device-box pr-scene-box">
              <!-- Laptops: the desk window; static: the window with its caption and a phone at each lower corner. -->
              <div class="story-win pr-scene-win rise-obj" style="--d:.3s">
                <WindowFrame id="hero-win" device="win" ww={1320} eager tilt={2} label="Practice on a desk." screens={heroWin} />
                <!-- The caption follows the frame (the scene syncs .win-cap[data-cap] beside the window). -->
                <div class="win-caps pr-scene-caps rise" style="--d:.7s">
                  <p class="win-cap t-cap-i on" data-cap="0">The Coach home, on a desk, with a sentence typed.</p>
                  <p class="win-cap t-cap-i" data-cap="1">The Tools hub.</p>
                </div>
                <div class="pr-scene-phones">
                  <div class="pr-scene-phone pr-scene-l rise-obj floor-on" style="--d:.48s">
                    <PhoneFrame device="tools" width={212} style="--pw:inherit" caption="The Tools hub." screens={[heroTools]} />
                  </div>
                  <div class="pr-scene-phone pr-scene-r rise-obj floor-on" style="--d:.6s">
                    <PhoneFrame device="close" width={224} style="--pw:inherit" caption="Close the day." screens={[heroClose]} />
                  </div>
                </div>
              </div>
              <!-- Tablets and phones, while pinned: one phone, the Tools hub, then Close the day. -->
              <div class="story-phone pr-scene-pn floor-on" style="--pw-max-n:240px">
                <PhoneFrame device="pn" width={240} style="--pw:inherit" screens={[heroTools, heroClose]} />
              </div>
            </div>
          </div>
          <!-- The copy column exists for the pinned layout only: its headlines are the scene's own captions, which the
               static composition already shows under its figures. -->
          <div class="story-copy pr-scene-copy">
            <ol class="story-steps story-only" aria-hidden="true" role="list">
              {heroSteps.map((s) => (
                <li class="story-step" data-step={s.step} data-only={s.only} data-w={s.w} data-act={s.act}>
                  <p class="eyebrow story-eyebrow story-only">{s.eyebrow}</p>
                  <p class="t-title story-h">{s.name}</p>
                </li>
              ))}
            </ol>
          </div>
        </div>
        <div class="story-run" aria-hidden="true"></div>
      </div>
      <!-- Tablets and phones, while the phone pair pins: the desk follows the story, still (a desk capture at phone width is not a step). -->
      <div class="pr-scene-desk-n">
        <WindowFrame ww={1320} screens={[heroWin[0]]} />
        <p class="t-cap-i pr-scene-desk-cap">The Coach home, on a desk, with a sentence typed.</p>
      </div>
    </div>
  </section>

  <!-- The loop: a charcoal bleed, the line drawn down the words and back to Thought (2.2.2) -->
  <section id="loop" class="pr-loop" data-tone="charcoal">
    <i class="lamp grain" aria-hidden="true" style="--lx:80%;--ly:72%;--la:.1"></i>
    <div class="wrap">
      <div class="grid">
        <div class="pr-loop-head">
          <p class="eyebrow rise">The loop</p>
          <h2 class="t-l wipe">A situation is neutral until you put a sentence on it. <em>Everything after that is downstream.</em></h2>
        </div>
        <div class="pr-loop-body">
          <PracticeLoopLine rows={loopRows} id="loop-rows" />
        </div>
        <p class="t-lead pr-loop-para rise" style="--d:.3s">Most people try to change the result. It almost never lasts. Every tool in Practice is a way of changing the sentence, in the moment it is being written.</p>
      </div>
    </div>
  </section>

  <!-- A day in Practice: the sky stage as a scroll story (S5) -->
  <section id="day" class="pr-day" data-tone="cream">
    <i class="lamp grain pr-day-lamp" aria-hidden="true" style="--lx:50%;--ly:72%;--la:.1"></i>
    <div class="wrap">
      <div class="grid">
        <div class="pr-day-head">
          <p class="eyebrow rise">A day in Practice</p>
          <h2 class="t-l wipe">One day, <em>as it actually goes.</em></h2>
          <p class="t-lead pr-lead rise" style="--d:.3s">Scroll, and the phone follows the day. Each screen is the app, not a picture of it.</p>
        </div>
      </div>
      <div class="pr-day-stage">
        <DayStage steps={daySteps} frames={dayFrames} width={230} id="day-stage" />
      </div>
    </div>
  </section>

  <!-- One tool, start to finish: STEAR as a scroll story, one phone beside the seven rows (S6) -->
  <section id="stear" class="pr-stear" data-tone="cream">
    <div class="wrap">
      <div class="grid pr-stear-head">
        <div class="pr-stear-title">
          <p class="eyebrow rise">One tool, start to finish</p>
          <h2 class="t-l wipe">STEAR, <em>as the app asks it.</em></h2>
        </div>
        <p class="t-lead pr-stear-intro rise" style="--d:.3s">Eight questions, one at a time, each with a line of help under it. The example is a real run: a business partner went quiet after the numbers were sent. By question six, the person is writing what else might be true.</p>
      </div>
      <div class="story pr-stear-story" data-story="stear" data-story-ui="steps" data-side="left" data-kind="mat" data-warm style={`--story-w:${stearW};--step-l:58svh;--step-l-n:54svh`}>
        <div class="story-track">
          <div class="story-stage">
            <div class="story-device-col">
              <StoryMarks variant="rail" count={false} labels={[...stear.map((s) => s.q), thenName]} label="STEAR, question by question" />
              <div class="story-device-box mat pr-stear-mat">
                <div class="story-phone pr-stear-phone">
                  <PhoneFrame device="stear" width={300} style="--pw:inherit" label="STEAR on a phone, question by question." screens={stearFrames} />
                </div>
              </div>
            </div>
            <div class="story-copy">
              <ol class="story-steps pr-stear-steps" role="list">
                {stear.map((s, i) => (
                  <li class="story-step pr-stear-row" data-step={i} data-w={s.w} data-act={s.act}>
                    <p class="pr-stear-line"><span class="t-folio pr-folio story-eyebrow">{s.step}</span> <span class="t-title pr-stear-q story-h">{s.q}</span></p>
                    <p class="t-cap pr-stear-help story-body">{s.note}</p>
                    <span class="sr-only story-alt">{stearFrames[i].alt}</span>
                    <div class="story-static"><PhoneFrame width={200} screens={[stearFrames[i]]} /></div>
                  </li>
                ))}
                <li class="story-step pr-stear-then" data-step={stear.length} data-act={thenAct}>
                  <div class="paper pr-then-card">
                    <p class="eyebrow story-eyebrow">Then</p>
                    <p class="t-title story-h">{thenName}</p>
                    <p class="t-body pr-then-body story-body">Questions seven and eight. The run is saved to your Journal, and the Coach can talk it through.</p>
                    <a href={LINKS.practice} class="link pr-then-link" data-passthrough>Run it yourself <Arrow /></a>
                  </div>
                  <span class="sr-only story-alt">{stearFrames[5].alt}</span>
                </li>
              </ol>
            </div>
          </div>
          <div class="story-run" aria-hidden="true"></div>
        </div>
      </div>
      <div class="pr-notes" data-warm>
        {notes.map((n, i) => (
          <div class="pr-note">
            <p class="t-body pr-note-text rise" style={`--d:${i * 90}ms`}><b class="lb">{n.lead}</b>{n.rest}</p>
            <figure class="paper tile pr-tile rise" style={`--d:${120 + i * 90}ms`}>
              <figcaption class="t-cap-i">{n.caption}</figcaption>
              <div class="tile-media tile-media-ct">
                <img class="screen" src={`/app/${n.screen}.webp`} alt={n.alt} width={n.w} height={n.h} loading="lazy" decoding="async" />
              </div>
            </figure>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The quiz: two phones on linen, a scroll story of two steps (S7) -->
  <section id="quiz" class="pr-quiz" data-tone="cream">
    <div class="wrap pr-quiz-wrap">
      <div class="pr-quiz-head">
        <p class="eyebrow rise">Where most people start</p>
        <h2 class="t-m wipe">What are you <em>subscribing to?</em></h2>
      </div>
      <div class="story pr-quiz-story" data-story="practice-quiz" data-story-ui="steps" data-side="right" data-kind="mat" data-story-static="device" data-story-h="s" data-warm style="--story-w:2;--step-l:64svh;--step-l-n:58svh">
        <div class="story-track">
          <div class="story-stage">
            <div class="story-device-col">
              <StoryMarks variant="rail" labels={quizSteps.map((s) => s.h)} label="The quiz, from a question to the result" />
              <div class="story-device-box mat pr-quiz-mat">
                <div class="pr-quiz-q rise-obj floor-on" style="--d:.3s">
                  <PhoneFrame device="q" width={212} style="--pw:inherit" screens={[{ name: "quiz-q1", alt: "The quiz, question one of eighteen: when I get less done than I planned, I'm disappointed in myself, from Never to Almost always.", w: 600, h: 1298 }]} />
                </div>
                <div class="pr-quiz-r rise-obj floor-on" style="--d:.42s">
                  <PhoneFrame device="r" width={244} style="--pw:inherit" screens={[{ name: "quiz-results", alt: "The quiz result: Approval, with what you're paying for, what it's actually costing you, where you're paying, and your first step.", w: 600, h: 1298 }]} />
                </div>
              </div>
            </div>
            <div class="story-copy pr-quiz-copy">
              <p class="t-lead pr-lead pr-quiz-body story-steps">{quizSteps.map((s, i) => (
                <Fragment>{i > 0 && " "}<span class="story-step" data-step={i} data-act={s.act}><span class="eyebrow story-eyebrow story-only story-repeat" aria-hidden="true">The Subscription Quiz</span><span class="story-h">{s.h}</span> <span class="story-body">{s.b}</span></span></Fragment>
              ))}</p>
              <div class="story-cta pr-quiz-cta">
                <a href={LINKS.quiz} class="btn btn-gold" data-passthrough data-event="quiz_click" data-event-location="practice-quiz">Take the quiz <Arrow /></a>
              </div>
            </div>
          </div>
          <div class="story-run" aria-hidden="true"></div>
        </div>
      </div>
      <p class="t-cap pr-quiz-note rise" style="--d:.3s">A reflection tool, not a clinical assessment. Four minutes.</p>
    </div>
  </section>

  <!-- Yours: a navy bleed, the lit statement (2.2.6) -->
  <section id="private" class="pr-private" data-tone="navy">
    <i class="lamp grain" aria-hidden="true" style="--lx:10%;--ly:0%;--la:.14"></i>
    <div class="wrap">
      <div class="grid">
        <div class="pr-private-copy">
          <p class="eyebrow">Yours</p>
          <p class="t-state" data-lit><b class="lb">Everything you write in Practice belongs to you.</b> It is kept under your own account, nobody at InnerBoard reads it, and inside InnerBoard OS a leader sees module completion, never your answers. There is nothing to install. Practice runs in your browser, sits on the home screen of iPhone and Android, keeps working when the signal drops, and picks up where you left off.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Everything inside: a scroll story, one rail item (or tab) at a time (S8) -->
  <section id="inside" class="pr-inside-sec" data-tone="cream">
    <div class="wrap">
      <div class="grid">
        <div class="pr-inside-head">
          <p class="eyebrow rise">Everything inside</p>
          <h2 class="t-l wipe">One account. <em>One place.</em></h2>
          <p class="t-lead pr-lead rise" style="--d:.3s">The Coach, the tools, the Academy, Inner Lab, the book and InnerBoard OS share one left rail on a desk, and one bottom bar on a phone.</p>
        </div>
      </div>
      <div class="pr-inside-body">
        <PracticeInside />
      </div>
    </div>
  </section>

  <!-- Levels and questions (2.2.8) -->
  <section id="levels" class="pr-levels" data-tone="cream">
    <div class="wrap">
      <i class="pr-rule-top" aria-hidden="true"></i>
      <div class="grid pr-levels-grid">
        <div class="pr-levels-copy">
          <p class="eyebrow rise">Start as a visitor</p>
          <h2 class="t-m wipe">Three levels. <em>No card to start.</em></h2>
          <ol class="pr-levels-cols">
            {levels.map(([name, body], i) => (
              <li class="rise" style={`--d:${.25 + i * .09}s`}>
                <p class="t-s pr-level-name">{name}</p>
                <p class="t-body pr-level-body" set:html={body}></p>
              </li>
            ))}
          </ol>
        </div>
        <div class="pr-faq rise" style="--d:.2s">
          <p class="eyebrow">Questions</p>
          <Accordion items={faq} />
        </div>
      </div>
    </div>
  </section>

  <!-- Final: a forest bleed, the floor that drifts with the scroll (S11) -->
  <section class="pr-final" data-tone="forest" data-warm>
    <PracticeFloor />
    <Geo class="pr-geo" color="#f4efe4" opacity={0.06} />
    <div class="wrap pr-final-wrap">
      <div class="grid">
        <div class="pr-final-copy">
          <h2 class="t-l wipe pr-final-h2">Start today, <em>as you are.</em></h2>
          <p class="t-lead pr-final-lead rise" style="--d:.3s">Open the app, take the quiz, or bring the Coach the thing that is on your mind. Nothing is asked of you first.</p>
          <div class="pr-btns pr-final-btns rise" style="--d:.4s">
            <a href={LINKS.practice} class="btn btn-gold" data-passthrough data-event="practice_click" data-event-location="final">Start in Practice <Arrow /></a>
            <a href={LINKS.quiz} class="btn btn-line" data-passthrough data-event="quiz_click" data-event-location="final">What's Holding You Back?</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* ── Practice page layout. Every number is from BUILD_SPEC 2.2 and SCROLL_SPEC section 2 (S4 to S8, S11); the
   * components, classes and attributes are the system's (SYSTEM_API). Each story's static layout comes first
   * (no script, reduced motion, short and landscape screens); its pinned layout follows inside the two STORY_MQ
   * queries, scoped `.js .story-class:not(.static)`, so nothing is hidden without the script. ── */

  /* 2.2.1 Hero */
  .pr-hero { position: relative; display: flex; flex-direction: column; padding-top: var(--nav-h); padding-bottom: var(--sec); overflow-x: clip; }
  .pr-hero > .wrap, .pr-hero > .wrap-wide { flex: none; }
  .pr-hero > .lamp { z-index: 0; }
  /* The cream lamp and grain belong to the cream page: once the page turns charcoal under #loop they fade with
   * the body (the shared mask already feathers their bottom edge). */
  .pr-hero > .lamp-cream, .pr-hero.grain-cream::after { transition: opacity .5s var(--ease); }
  html:not([data-theme="cream"]) .pr-hero > .lamp-cream, html:not([data-theme="cream"]) .pr-hero.grain-cream::after { opacity: 0; }
  .pr-hero-wrap { position: relative; z-index: 2; }
  .pr-hero-copy { grid-column: 1 / span 9; padding-top: 90px; }
  .pr-h1 { max-width: 11em; margin: 0; }
  .pr-lead { margin-top: var(--lead-gap); color: var(--fg-2); }
  .pr-btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: var(--btn-gap); }
  /* S4, static: the window with its caption, the two phones standing 64 px below its corners. The left one covers
   * the rail's footer line in the capture; the right one stands clear of the capture's "Close the day" link. The
   * root is .wrap (the step layout's grid, STORY_V2 3.1); the static composition keeps the wide container it had,
   * written at zero specificity so the pinned layout's rules always win over it. The phone that takes the window's
   * place while pinned on tablets and phones is not part of it. */
  .pr-scene { position: relative; z-index: 1; order: 1; margin-top: clamp(48px, 6vh, 96px); padding-bottom: 72px; }
  :where(.pr-scene) { width: min(100% - 2 * max(20px, 2.8vw, env(safe-area-inset-left, 0px), env(safe-area-inset-right, 0px)), var(--max-wide)); }
  :where(.pr-scene .pr-scene-pn) { display: none; }
  .pr-scene-win { position: relative; z-index: 1; }
  .pr-scene-caps { margin-top: 14px; }
  .pr-scene-caps .win-cap { left: 0; right: 0; text-align: center; max-width: none; }
  .pr-scene-phones { position: absolute; left: 0; right: 0; top: 0; aspect-ratio: 1000 / 657; z-index: 2; pointer-events: none; }
  .pr-scene-phone { --pw: 212px; position: absolute; bottom: -64px; pointer-events: auto; }
  .pr-scene-l { left: 8px; }
  .pr-scene-r { right: -4px; }
  .pr-scene-desk-n { display: none; }
  .pr-scene-desk-cap { margin: 14px auto 0; text-align: center; }
  /* The rise uses the translate property (the device itself carries the story's lift), so it is named in the transition list. */
  .js .pr-scene-phone.rise-obj { translate: 0 80px; transition-property: opacity, transform, translate; transition-duration: 1.3s; }
  .js .pr-scene-phone.rise-obj.in { translate: 0 0; }
  .js .pr-scene-phone .phone figcaption { opacity: 0; transition: opacity .9s var(--slow) 1.25s; }
  .js .pr-scene-phone.in .phone figcaption { opacity: 1; }
  .pr-strap { position: relative; z-index: 1; order: 2; margin-top: 40px; }
  .pr-strap-rule { grid-column: 3 / span 8; display: block; height: 1px; background: var(--line); }
  .pr-strap-line { grid-column: 1 / -1; text-align: center; margin: 20px auto 0; max-width: none; }

  /* 2.2.2 The loop */
  .pr-loop { padding-block: var(--sec-l); }
  .pr-loop-head { grid-column: 1 / span 9; }
  /* Columns 1 to 8 rather than 7, so "What that state makes available." stays on one line at every width and the rows keep their 88 px rhythm. */
  .pr-loop-body { grid-column: 1 / span 8; margin-top: var(--head-gap); }
  .pr-loop-para { grid-column: 9 / span 4; align-self: end; color: var(--fg-2); margin-top: var(--head-gap); }
  .pr-loop-list { position: relative; display: grid; grid-template-columns: 56px 1fr; }
  .pr-loop-gutter { position: relative; }
  .pr-loop-svg { position: absolute; left: 0; width: 100%; display: block; overflow: visible; }
  .pr-loop-down { top: 0; height: 100%; }
  .pr-loop-back { top: 100%; height: 45%; }
  .pr-loop-rows { list-style: none; margin: 0; padding: 0; display: grid; grid-auto-rows: 1fr; }
  .pr-loop-rows > li { display: grid; grid-template-columns: 200px 1fr; column-gap: var(--gap); align-items: baseline; min-height: 88px; padding-block: 26px; box-sizing: border-box; border-top: 1px solid var(--line); }
  .pr-loop-rows > li:last-child { border-bottom: 1px solid var(--line); }
  .pr-loop-word { max-width: none; }
  .pr-loop-def { color: var(--fg-2); max-width: none; transition: color .4s var(--ease); }
  .js .pr-loop-rows > li:not(.on) .pr-loop-def { color: inherit; }
  /* The dim follows the page tone, so the words never vanish while the tone is still cross fading. */
  .js .pr-loop .pr-loop-rows > li:not(.on) { color: color-mix(in srgb, var(--fg) 40%, transparent); }
  /* The arrowhead is part of the drawn return path (PracticeLoopLine); the engine's `.done` is sticky,
   * so `.draw-head` is only the one time pulse over it and ends invisible. */
  .js svg.pr-loop-back .draw-head { opacity: 0; }
  .js svg.pr-loop-back.done .draw-head { opacity: 0; animation: pr-head-pulse 600ms var(--ease); }
  @keyframes pr-head-pulse { 0% { opacity: 1; transform: scale(1); } 50% { opacity: 1; transform: scale(1.3); } 100% { opacity: 0; transform: scale(1); } }

  /* 2.2.3 A day in Practice (S5: DayStage owns the story layout) */
  .pr-day { padding-block: var(--sec); }
  .pr-day > .lamp { opacity: 0; }
  .pr-day-head { grid-column: 1 / span 8; }
  .pr-day-stage { margin-top: var(--head-gap); }
  /* The Morning step: the today capture was taken in the afternoon, so its greeting sits above the crop.
   * This is a crop of the real capture (moved up 18.4% and set at 1.04, inside the capture's side padding);
   * nothing is drawn or covered, and its lower edge fades out before the app's bottom bar. The frame is a
   * group (type: []), so the crop sits inside it and the wipe clips the untransformed frame box. */
  #day .ds-group img[src$="/today.jpg"], #day .ds-group img[src$="/today.webp"] { transform-origin: 50% 0; transform: translateY(-18.4%) scale(1.04);
    -webkit-mask-image: linear-gradient(to bottom, #000 88%, transparent 91.5%); mask-image: linear-gradient(to bottom, #000 88%, transparent 91.5%); }
  /* The page's phones lean at most 1.06 about the centre, so a crop takes under 3% from each side and the
   * capture's own padding (about 4%) still clears every word: the camera's edge feather is 3 px here, not 14,
   * so it never lies over the first glyph of a line. */
  .pr-day .day-stage .phone-screen::after, .pr-stear-mat .phone-screen::after, .pr-quiz-r .phone-screen::after { background: linear-gradient(90deg, #f2ece0 0, rgba(242,236,224,0) 3px, rgba(242,236,224,0) calc(100% - 3px), #f2ece0 100%); }
  /* The Journal holds one entry, so on the evening step the phone fades into the night below the list
   * instead of showing three quarters of an empty screen. */
  .pr-day .day-stage.is-night .phone { -webkit-mask-image: linear-gradient(to bottom, #000 40%, transparent 74%); mask-image: linear-gradient(to bottom, #000 40%, transparent 74%); }

  /* 2.2.4 STEAR (S6). Static: the seven rows in order, each with its phone (the Then row with its card). */
  .pr-stear { padding-block: var(--sec) calc(var(--sec) * .7); }
  .pr-stear-head { align-items: end; }
  .pr-stear-title { grid-column: 1 / span 6; }
  .pr-stear-intro { grid-column: 8 / span 5; color: var(--fg-2); max-width: none; padding-bottom: .15em; }
  .pr-stear-story { margin-top: var(--head-gap); }
  .pr-stear-steps { display: grid; grid-template-columns: repeat(auto-fill, minmax(232px, 1fr)); column-gap: var(--gap); row-gap: 48px; }
  .pr-stear-row, .pr-stear-then { padding-top: 20px; border-top: 1px solid var(--line); }
  .pr-stear-line { display: flex; align-items: baseline; gap: 12px; margin: 0; }
  .pr-folio { flex: none; color: var(--fg-3); }
  .pr-stear-q { max-width: none; }
  .pr-stear-help { margin: 6px 0 0; }
  .pr-stear-row .story-static { margin-top: 24px; }
  .pr-then-card { padding: 28px; display: flex; flex-direction: column; justify-content: center; }
  .pr-then-card .eyebrow { margin-bottom: 14px; }
  .pr-then-body { margin-top: 10px; }
  .pr-then-link { margin-top: 18px; align-self: flex-start; position: relative; }
  .pr-then-link::after { content: ""; position: absolute; inset: -14px -8px; }
  .pr-notes { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: var(--gap); margin-top: 64px; padding-top: 28px; border-top: 1px solid var(--line); }
  .pr-note { display: contents; }
  .pr-note-text { grid-row: 1; color: var(--fg-2); max-width: 24em; }
  .pr-note-text b { font-weight: inherit; }
  /* Each tile takes its note's full measure, so the notes and the tiles share one column edge. */
  .pr-tile { grid-row: 2; width: 100%; min-height: 360px; margin-top: 24px; }
  .pr-tile .tile-media-ct { --screen-w: 62%; }
  .pr-tile figcaption { margin: 0; }

  /* 2.2.5 The quiz (S7, STORY_V2 3.4). Static (and without the script): today's section, the copy column beside
   * the mat: the story's own boxes are laid out as if they were not there (display: contents, at zero specificity so
   * the pinned layout's rules win over it), so the paragraph, the button and the note read as one column centred
   * on the mat. */
  .pr-quiz { padding-block: var(--sec); }
  .pr-rule-top { display: block; height: 1px; background: var(--line); }
  .pr-quiz-wrap { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: 1fr auto auto auto auto 1fr; column-gap: var(--gap); }
  :where(.pr-quiz-story, .pr-quiz-story > .story-track, .pr-quiz-story > .story-track > .story-stage, .pr-quiz-story .story-device-col, .pr-quiz-story .story-copy) { display: contents; }
  .pr-quiz-head { grid-column: 1 / span 5; grid-row: 2; }
  .pr-quiz-body { grid-column: 1 / span 5; grid-row: 3; max-width: 28em; }
  .pr-quiz-cta { grid-column: 1 / span 5; grid-row: 4; }
  .pr-quiz-note { grid-column: 1 / span 5; grid-row: 5; margin-top: 16px; }
  /* The mat has room around both phones: the results phone's top sits 81 px under the mat's edge. */
  :where(.pr-quiz-mat) { grid-column: 6 / span 7; grid-row: 1 / -1; align-self: center; height: 664px; }
  .pr-quiz-q { --pw: 212px; position: absolute; left: 76px; bottom: 64px; z-index: 1; }
  .pr-quiz-r { --pw: 244px; position: absolute; right: 60px; bottom: 40px; z-index: 2; }
  /* The light moves between the phones on the step (a 350 ms opacity on the device, never a capture over a capture). */
  .pr-quiz-mat .phone { transition: opacity .35s var(--ease); }

  /* 2.2.6 Yours */
  .pr-private { padding-block: var(--sec-l); }
  .pr-private-copy { grid-column: 1 / span 10; }

  /* 2.2.7 Everything inside (S8). Static: the four rows in order, each followed by its own figure. */
  .pr-inside-sec { padding-block: var(--sec); }
  .pr-inside-head { grid-column: 1 / span 8; }
  .pr-inside-body { margin-top: var(--head-gap); }
  .pr-inside-ladder { max-width: 720px; }
  .pr-inside-ladder > li { grid-template-columns: 1fr; padding-block: 24px; }
  .pr-inside-ladder a { display: grid; grid-template-columns: 1fr 16px; column-gap: 16px; align-items: start; }
  .pr-inside-ladder .ladder-name { display: block; font-size: var(--fs-s); letter-spacing: -.012em; line-height: 1.12; text-wrap: balance; }
  .pr-inside-ladder .ladder-body { display: block; margin-top: 8px; }
  .pr-inside-ladder .pr-arrow { color: var(--accent); margin-top: .4em; transition: transform 200ms var(--hover); }
  .pr-inside-ladder .pr-arrow svg { width: 16px; height: 16px; }
  .pr-inside-ladder a:hover .pr-arrow, .pr-inside-ladder a:focus-visible .pr-arrow { transform: translateX(3px); }
  .pr-inside .story-static { margin-bottom: 8px; }
  .pr-static-cap { margin-top: 12px; }
  .pr-inside-win .win-caps { margin-top: 14px; }

  /* 2.2.8 Levels and questions */
  .pr-levels { padding-block: var(--sec); }
  .pr-levels-grid { margin-top: var(--sec); }
  .pr-levels-copy { grid-column: 1 / span 6; }
  .pr-faq { grid-column: 8 / span 5; }
  /* The three levels as three rows under one hairline: the name in a 150 px column, the body beside it. */
  .pr-levels-cols { list-style: none; margin: var(--head-gap) 0 0; padding: 0; border-top: 1px solid var(--line); }
  .pr-levels-cols > li { display: grid; grid-template-columns: 150px minmax(0, 1fr); column-gap: 24px; align-items: baseline; padding-block: 22px 24px; border-bottom: 1px solid var(--line); }
  .pr-level-name { max-width: none; margin: 0; }
  .pr-level-body { color: var(--fg-2); margin: 0; max-width: 30em; }
  .nb { white-space: nowrap; }

  /* 2.2.9 Final */
  .pr-final { position: relative; height: max(640px, 92svh); overflow: clip; isolation: isolate; display: flex; align-items: flex-start; }
  /* The floor and the glow fade in with the forest tone, so the page never hard cuts at the section's top edge. */
  .pr-final .floor { z-index: 0; opacity: 0; transition: opacity .5s var(--ease); }
  html[data-theme="forest"] .pr-final .floor, .no-js .pr-final .floor { opacity: 1; }
  /* The floor's grain starts under the section's top edge, so it never draws a line across the forest page there. */
  .pr-final .floor-fade.grain::after { -webkit-mask-image: linear-gradient(to bottom, transparent, #000 200px); mask-image: linear-gradient(to bottom, transparent, #000 200px); }
  .pr-geo { right: -260px; bottom: -420px; z-index: 0; }
  .pr-final-wrap { position: relative; z-index: 2; margin-top: 14vh; }
  .pr-final-copy { grid-column: 3 / span 8; position: relative; text-align: center; }
  .pr-final-copy::before { content: ""; position: absolute; inset: -80px -120px; background: radial-gradient(50% 60% at 50% 40%, rgba(31,61,46,.85), transparent 75%); z-index: -1; pointer-events: none; opacity: 0; transition: opacity .5s var(--ease); }
  html[data-theme="forest"] .pr-final-copy::before, .no-js .pr-final-copy::before { opacity: 1; }
  .pr-final-h2 { margin-inline: auto; }
  .pr-final-lead { color: var(--fg-2); margin: var(--lead-gap) auto 0; }
  /* The tone floor of this closing bleed starts under the copy (at 58%, which is below the fold for as long
   * as the page is still cream), so the copy is never read in the cream ink on a forest ground, and the
   * section's lower part is forest whatever the theme. */
  main .pr-final[data-tone] { background-image: linear-gradient(to bottom, transparent 0, transparent 58%, var(--tone-floor, transparent) calc(58% + 120px)); }
  .pr-final-btns { justify-content: center; }
  /* The outline button stands on a solid forest ground, so no capture of the floor runs through its label (audit 2). */
  html[data-theme="forest"] .pr-final .btn-line, .no-js .pr-final .btn-line { background-color: rgba(31,61,46,.92); }
  @media (hover: hover) and (pointer: fine) { html[data-theme="forest"] .pr-final .btn-line:hover { background-color: #2b4a3b; } }

  @media (max-width: 1068px) {
    .pr-hero-copy { grid-column: 1 / -1; padding-top: 64px; }
    .pr-scene { padding-bottom: 0; }
    .pr-scene-phones { position: static; aspect-ratio: auto; display: flex; justify-content: center; gap: 24px; margin-top: 32px; padding-bottom: 44px; pointer-events: auto; }
    .pr-scene-phone { --pw: 190px; position: static; }
    .js .pr-scene-phone.rise-obj { translate: 0 28px; transition-duration: 1.2s; }
    .pr-strap { margin-top: 24px; }
    .pr-loop-head, .pr-loop-para, .pr-day-head, .pr-stear-title, .pr-stear-intro, .pr-private-copy, .pr-inside-head, .pr-levels-copy, .pr-faq { grid-column: 1 / -1; }
    .pr-loop-body { grid-column: 1 / span 8; }
    .pr-loop-para { margin-top: 40px; }
    .pr-stear-intro { margin-top: 24px; padding-bottom: 0; }
    /* The quiz, static: the copy, the button and the note, then the mat. */
    .pr-quiz-wrap { display: flex; flex-direction: column; }
    .pr-quiz-head { order: 1; }
    .pr-quiz-body { order: 2; }
    .pr-quiz-cta { order: 3; }
    .pr-quiz-note { order: 4; }
    :where(.pr-quiz-mat) { order: 5; align-self: stretch; margin-top: 48px; }
    .pr-faq { margin-top: 56px; }
    .pr-final-copy { grid-column: 2 / span 10; }
    .pr-notes { grid-template-columns: repeat(2, 1fr); row-gap: 48px; }
    .pr-note { display: block; }
    .pr-note-text, .pr-tile { grid-row: auto; }
  }

  @media (max-width: 734px) {
    .pr-hero { padding-bottom: var(--sec-s); }
    .pr-hero-copy { padding-top: 40px; }
    .pr-btns { flex-direction: column; }
    .pr-btns .btn { width: 100%; }
    /* The hero leads with the two phones at a readable size: Close the day in front at 224, the Tools hub
     * behind it to the left at 196, tilted; then the window with its caption. */
    .pr-scene { margin-top: 36px; }
    .pr-scene-win { display: flex; flex-direction: column; }
