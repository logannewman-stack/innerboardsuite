  .sd-scene-r { right: 24px; }
  .sd-scene-cap { text-align: center; margin: 14px auto 0; }
  .sd-loop { display: grid; grid-template-columns: 56px 1fr; column-gap: 0; margin-top: var(--head-gap); max-width: 690px; }
  .sd-loop-rows { list-style: none; margin: 0; padding: 0; }
  .sd-loop-rows li { display: grid; grid-template-columns: 200px 1fr; align-items: baseline; min-height: 88px; padding-block: 26px; border-top: 1px solid var(--line); box-sizing: border-box; }
