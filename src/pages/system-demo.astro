  .sd-quiz-phone { position: absolute; left: 50%; bottom: 22px; transform: translateX(-50%); z-index: 2; }
  .sd-tcard { position: absolute; left: calc(50% - 142px - 110px); bottom: 48px; z-index: 1; transform: rotate(-5deg); box-shadow: var(--sh-paper), 0 18px 30px -18px rgba(31,29,26,.35); }
  .sd-quiz-2 { top: 179.4em; clip-path: inset(6.2% 0 0 0); mask-image: linear-gradient(to bottom, transparent 6.2%, #000 calc(6.2% + 2em)); -webkit-mask-image: linear-gradient(to bottom, transparent 6.2%, #000 calc(6.2% + 2em)); }
  .sd-stack p + p { margin-top: 1em; }
