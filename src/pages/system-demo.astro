  .sd-deck .rule-draw { display: block; height: 1px; background: var(--line); }
  .sd-note { grid-column: 7 / span 4; padding: 28px; }
  .sd-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .sd-card { padding: 32px; min-height: 220px; }
  .sd-quotes { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: var(--gap); margin-top: var(--head-gap); }
  .sd-quote { border-top: 1px solid var(--line); padding-top: 28px; }
  .sd-final { position: relative; height: max(640px, 92svh); overflow: clip; isolation: isolate; display: flex; align-items: flex-start; }
  .sd-final-copy { position: relative; z-index: 2; text-align: center; max-width: 792px; margin: 14vh auto 0; }
  .sd-final-copy::before { content: ""; position: absolute; inset: -80px -120px; background: radial-gradient(50% 60% at 50% 40%, rgba(31,61,46,.85), transparent 75%); z-index: -1; }
  .sd-final .floor { z-index: 0; }
  @media (max-width: 1068px) {
    .sd-panel { padding: 56px 40px; }
    .sd-panel-left, .sd-ladder { grid-column: 1 / -1; }
    .sd-quiz-still, .sd-quiz-copy, .sd-span8, .sd-span5, .sd-span6, .sd-inside-win, .sd-inside-ladder { grid-column: 1 / -1; }
    .sd-span-btns { grid-column: 1 / -1; flex-direction: row; margin-top: 32px; }
    .sd-flips > li { grid-column: span 6 !important; margin-top: 0 !important; }
    .sd-tiles > .tile { grid-column: span 6; }
  }
  @media (max-width: 734px) {
    .sd-hero { min-height: 0; padding-bottom: 56px; overflow-x: clip; position: relative; }
    .sd-hero-copy { grid-column: 1 / -1; padding-top: 40px; }
    .sd-btns { flex-direction: column; }
    .sd-btns .btn { width: 100%; }
    .sd-plate { position: relative; top: auto; left: auto; right: auto; bottom: auto; margin: 24px calc(-1 * var(--gutter)) 0; height: 496px; border-radius: 0; }
    .sd-hero-phone { position: absolute; top: auto; left: 50%; transform: translateX(-50%); bottom: 0; }
    .sd-panel-phone { margin-left: 0; display: flex; justify-content: center; margin-block: 40px; }
    .sd-panel-phone .phone { --pw: 220px !important; }
    .sd-span-btns { flex-direction: column; }
