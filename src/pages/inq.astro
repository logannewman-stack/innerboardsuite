---
/** INQ Certification (the inq view of the client's design): who it is for, the journey, the credential, two steps to start. */
import Layout from "../layouts/Practice.astro";
import { MODULES } from "../data/practice";
import { LINKS } from "../config/links";
/* A module name in lines of at most n characters (the journey drawing's labels). */
const wrap = (t: string, n: number) => t.split(" ").reduce((l: string[], w) => { const last = l[l.length - 1]; if ((last + " " + w).trim().length > n) l.push(w); else l[l.length - 1] = (last + " " + w).trim(); return l; }, [""]);
---
<Layout title="INQ Certification · The Practice" description="Master the methodology. Lead the transformation. A professional certification for coaches, leaders, and practitioners who bring the InnerBoard methodology to the people they serve." path="/inq" nav="learn">
<section class="view" id="inq">
  <div class="phero">
    <div class="wrap split">
      <div class="stack">
        <img loading="lazy" decoding="async" width="196" height="231" class="inq-mark" src="/images/practice/inq-mark.png" alt="InnerBoard Certify INQ logo">
        <p class="eyebrow">INQ Certification · Lead it</p>
        <h1>Master the methodology. <em class="lead-it">Lead the transformation.</em></h1>
        <p class="lede">A professional certification for coaches, leaders, and practitioners who want to bring the InnerBoard methodology to the people they serve.</p>
        <div class="ctas"><a class="btn btn-solid" href="#inq-curriculum">Explore Certification <span class="arr">→</span></a><a class="btn btn-line" href="#inq-apply">Start a conversation</a></div>
      </div>
<div class="ph photo hero-gfx"><img loading="lazy" decoding="async" width="1000" height="800" src="/images/practice/inq-hero.webp" alt="An INQ coach teaching Notice, Choose, Practice at a whiteboard to a small group"></div>
    </div>
  </div>

  <div class="band">
    <div class="wrap">
      <p class="eyebrow">Who it’s for</p>
      <h2 class="h2">For people who want to coach the transformation that actually changes people.</h2>
      <p class="lede" style="margin-top:14px">If you already help people grow, INQ gives you a proven methodology, a shared language, and a credential behind your work.</p>
      <div class="audience"><span>Coaches</span><span>Business and team leaders</span><span>People and HR leaders</span><span>Consultants</span><span>Therapeutic and wellness practitioners</span><span>Educators and facilitators</span></div>
    </div>
  </div>

  <div class="band paper" id="inq-curriculum">
    <div class="wrap">
      <p class="eyebrow">The INQ journey</p>
      <h2 class="h2">Built from the inside out, one module at a time.</h2>
      <p class="lede" style="margin-top:14px">Each module builds on the one before it. You start with your own awareness, emotions, and identity. Then you take the work into your relationships, your energy, and your choices. Only then do you learn to coach it, so by certification you’re leading others through work you’ve already done yourself.</p>
      <div class="journey" id="journey">
        <svg viewBox="0 0 1000 580" role="img" aria-label="INQ journey: Modules 0 through 8 and a bonus module along a winding path">
          <path d="M50 80 H880 A95 95 0 0 1 880 270 H130 A95 95 0 0 0 130 460 H950" fill="none" style="stroke:var(--band)" stroke-width="16" stroke-linecap="round"></path>
          {MODULES.map((m) => (
            <g>
              <circle cx={m.x} cy={m.y} r="30" style="fill:var(--surface);stroke:var(--gold)" stroke-width="1.5"></circle>
              <text x={m.x} y={m.y + 8} text-anchor="middle" font-family="Fraunces,Georgia,serif" font-size="22" style="fill:var(--gold)">{m.n}</text>
              <text text-anchor="middle" font-family="Fraunces,Georgia,serif" font-size="17" style="fill:var(--ink)">{wrap(m.name, 24).map((line, k) => <tspan x={m.x} y={m.y + 58 + k * 20}>{line}</tspan>)}</text>
              <text x={m.x} y={m.y + 58 + wrap(m.name, 24).length * 20 + 2} text-anchor="middle" font-family="Instrument Sans,Arial,sans-serif" font-size="12.5" style="fill:var(--muted)">{m.lessons} lessons</text>
            </g>
          ))}
        </svg>
      </div>
      <ol class="journey-list" id="journeyList">{MODULES.map((m) => <li data-n={m.n}><b>{m.name}</b><small>{m.lessons} lessons</small></li>)}</ol>
    </div>
  </div>

  <div class="band">
    <div class="wrap split" style="align-items:start">
      <div class="stack">
        <p class="eyebrow">Delivery, assessment, credential</p>
        <h2>Built to be earned, not just completed.</h2>
        <p class="lede">The credential reflects what you can actually do with the methodology. You finish ready to use it with clients, teams, and groups.</p>
      </div>
      <ul class="facts">
        <li><span>Delivery</span><strong>Live sessions plus self paced learning</strong></li>
        <li><span>Practice</span><strong>Real application with feedback</strong></li>
        <li><span>Assessment</span><strong>Demonstrated competency</strong></li>
        <li><span>Credential</span><strong>INQ certified practitioner</strong></li>
        <li><span>After</span><strong>Practitioner network and ongoing support</strong></li>
      </ul>
    </div>
  </div>

  <div class="band navy on-navy" id="inq-apply">
    <div class="wrap">
      <p class="eyebrow">Getting started</p>
      <h2 class="h2">Two steps to start.</h2>
      <ol class="steps">
        <li><b>1</b><h4>Start a conversation (if you’d like)</h4><p>Talk with the InnerBoard team about the work you do, or want to do, and make sure INQ fits what you want.</p></li>
        <li><b>2</b><h4>Enroll and begin</h4><p>Everything is ready the day you enroll, so you can start right away.</p></li>
      </ol>
      <p class="lede" style="margin-top:28px">Already know it’s for you? Go straight to enrolling.</p>
      <div class="ctas" style="margin-top:28px"><a class="btn btn-solid" href={LINKS.inqEnroll}>Enroll now <span class="arr">→</span></a><a class="btn btn-line" href={LINKS.inqTalk}>Start a conversation</a></div>
    </div>
  </div>
</section>
</Layout>
