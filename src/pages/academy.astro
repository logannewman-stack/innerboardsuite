---
/**
 * innerboardsuite.com/academy
 *
 * Built to "Academy Page Rebuild: Copy and Build Directions" (D1 in the
 * tracker). Copy as written there, section by section, in the cream and teal
 * system it specifies. Nothing here paraphrases the approved copy.
 */
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import { LINKS } from "../config/links";

const title = "InnerBoard Academy · The curriculum school never offered";
const description =
  "Self-paced courses in the skills nobody taught you: what to do with a racing mind, a big feeling, a hard conversation. Start at the beginning, or start where you are.";

const levels = [
  { name: "Foundations", body: "Where you start seeing what's actually driving you. The starting place in every collection. Your thoughts, your reactions, and why you keep doing what you do." },
  { name: "Practicum", body: "You get it. You still do it. This is where that changes. Real situations, honest questions, and practice that holds up when life pushes back." },
  { name: "Graduate", body: "For the moments with the most at stake. The hardest conversations, the oldest habits, and the places you still lose yourself." }
];

const core = [
  { name: "Human Foundations", body: "Thought, emotion, identity, belief, and the daily practice of self-leadership.", href: LINKS.academyApp },
  { name: "The Wisdom Collective", body: "48 books. 7 research-grounded frameworks. The science underneath why this work works.", href: LINKS.academyApp },
  { name: "The Certified Mind Method", body: "The complete method behind INQ Certification: five tools that create real follow-through in your own life and with anyone you lead. One course, purchased as one.", href: LINKS.certifiedMind }
];
const lifeStage = [
  { name: "Teens", body: "Identity, big emotions, confidence, and the early practice of self-leadership. Built for ages 14 to 18." },
  { name: "Young Adult Life", body: "Self-trust, direction, and building stability while building a life. For ages 18 to 25." },
  { name: "Life Transitions & Midlife", body: "For the season when everything is shifting and you're finding your footing." },
  { name: "Parenting & Family Life", body: "How what's going on inside you shapes your family, and how to lead your home from the inside out." }
];
const domain = [
  { name: "Relationships & Connection", body: "How you communicate, what you keep repeating, where your boundaries are, and building real connection." },
  { name: "Work, Career & Professional Life", body: "Who you are at work, how you hold steady under pressure, and owning your part." },
  { name: "Purpose & Life Design", body: "From drifting to directing. Built on design, not motivation." },
  { name: "Spiritual Growth & Inner Expansion", body: "Presence, stillness, trust, and the parts of life you feel more than you can explain." },
  { name: "Money & Financial Life", body: "The beliefs driving what you do with money. The part underneath every budget and strategy." },
  { name: "Grief & Loss", body: "Death, divorce, the loss of who you were. How to meet an ending, and what becomes possible after it." }
];
const testimonials = [
  "I thought I just was not a patient person. Turns out I had no idea what was driving my reactions. Now I do.",
  "I have tried every productivity system. None of it lasted. This was the first time I understood why, and what to actually do about it.",
  "I came in looking for a tool. I walked out with a different way of seeing."
];
---
<Base title={title} description={description} path="/academy" theme="teal" themeColor="#f7f4ee">
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="bg-ac-cream relative overflow-hidden">
    <div class="absolute -top-32 right-[-10%] w-[640px] h-[640px] rounded-full bg-teal/10 blur-3xl" aria-hidden="true"></div>
    <div class="wrap relative pt-[120px] sm:pt-[160px] pb-20 sm:pb-28">
      <div class="reveal is-in max-w-[820px]">
        <p class="eyebrow">InnerBoard Academy · Learn</p>
        <h1 class="mt-5 text-[44px] sm:text-[64px] lg:text-[76px] leading-[1.0] text-ink">The curriculum school <em>never</em> offered.</h1>
        <p class="mt-6 max-w-[640px] text-[17px] sm:text-[20px] leading-relaxed text-ink-muted">
          Self-paced courses in the skills nobody taught you: what to do with a racing mind, a big feeling, a hard conversation. Start at the beginning, or start where you are.
        </p>
        <div class="mt-8">
          <a href="#library" class="btn btn-teal">Browse the collections <Arrow /></a>
        </div>
        <p class="mt-4 text-[15px] italic text-ink-faint font-display">For the moment you're done reacting the same way and getting the same result.</p>
      </div>
    </div>
  </section>

  <!-- ── The gap ──────────────────────────────────────────────────────── -->
  <section class="bg-ac-cream-2">
    <div class="wrap py-20 sm:py-28">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
        <div class="reveal">
          <p class="eyebrow">The gap</p>
          <ul class="mt-5 space-y-2 text-[17px] text-ink-muted">
            <li>You learned the dates.</li>
            <li>You learned where the appendix sits.</li>
            <li>You learned how to diagram a sentence.</li>
          </ul>
        </div>
        <div class="reveal" style="--d:120ms">
          <h2 class="text-[36px] sm:text-[52px] text-ink">Nobody taught you how to <em>lead yourself.</em></h2>
          <p class="mt-5 text-[18px] sm:text-[20px] text-ink-muted font-display">The most important skill of your life, <em>left for you to figure out on your own.</em></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── How it works ─────────────────────────────────────────────────── -->
  <section class="bg-ac-cream">
    <div class="wrap py-20 sm:py-28">
      <div class="reveal max-w-[720px]">
        <p class="eyebrow">How it works</p>
        <h2 class="mt-4 text-[36px] sm:text-[52px] text-ink">Twelve collections. One <em>direction.</em></h2>
        <p class="mt-5 text-[16.5px] leading-relaxed text-ink-muted">Every collection stands on its own. There's no required order. Start with what's hardest right now and go as deep as you want.</p>
      </div>
      <ul class="mt-12 grid gap-4 md:grid-cols-3">
        {levels.map((level, i) => (
          <li class="reveal card p-7 sm:p-8" style={`--d:${i * 90}ms`}>
            <p class="eyebrow">{level.name}</p>
            <p class="mt-3 text-[15.5px] leading-relaxed text-ink-muted">{level.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── The library ──────────────────────────────────────────────────── -->
  <section id="library" class="bg-ac-cream-2">
    <div class="wrap py-20 sm:py-28">
      <div class="reveal max-w-[720px]">
        <p class="eyebrow">The library</p>
        <h2 class="mt-4 text-[36px] sm:text-[52px] text-ink">Find your <em>door in.</em></h2>
        <p class="mt-5 text-[16.5px] leading-relaxed text-ink-muted">Most people start with Human Foundations. Start anywhere else if you already know where you want to begin.</p>
      </div>

      <h3 class="reveal mt-14 text-[24px] text-ink">Core curriculum</h3>
      <ul class="mt-5 grid gap-4 md:grid-cols-3">
        {core.map((c, i) => (
          <li class="reveal card p-7 flex flex-col" style={`--d:${i * 80}ms`}>
            <span class="self-start rounded-full bg-teal-soft text-teal text-[11px] font-semibold uppercase tracking-[0.12em] px-3 py-1">Available now</span>
            <h4 class="mt-4 font-display text-[24px] leading-[1.15] text-ink">{c.name}</h4>
            <p class="mt-2 text-[15px] leading-relaxed text-ink-muted flex-1">{c.body}</p>
            <a href={c.href} class="link-arrow mt-5 text-[14.5px]" data-passthrough>Open the collection <Arrow /></a>
          </li>
        ))}
      </ul>

      <h3 class="reveal mt-14 text-[24px] text-ink">Life stage collections</h3>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {lifeStage.map((c, i) => (
          <li class="reveal card p-6 flex flex-col" style={`--d:${i * 70}ms`}>
            <span class="self-start rounded-full border border-ac-line text-ink-faint text-[11px] font-semibold uppercase tracking-[0.12em] px-3 py-1">Coming soon</span>
            <h4 class="mt-4 font-display text-[21px] leading-[1.15] text-ink">{c.name}</h4>
            <p class="mt-2 text-[14.5px] leading-relaxed text-ink-muted">{c.body}</p>
          </li>
        ))}
      </ul>

      <h3 class="reveal mt-14 text-[24px] text-ink">Domain collections</h3>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {domain.map((c, i) => (
          <li class="reveal card p-6 flex flex-col" style={`--d:${i * 60}ms`}>
            <span class="self-start rounded-full border border-ac-line text-ink-faint text-[11px] font-semibold uppercase tracking-[0.12em] px-3 py-1">Coming soon</span>
            <h4 class="mt-4 font-display text-[21px] leading-[1.15] text-ink">{c.name}</h4>
            <p class="mt-2 text-[14.5px] leading-relaxed text-ink-muted">{c.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Why it works ─────────────────────────────────────────────────── -->
  <section class="bg-ac-cream">
    <div class="wrap py-20 sm:py-28">
      <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-center">
        <div class="reveal">
          <p class="eyebrow">Why it works</p>
          <h2 class="mt-4 text-[36px] sm:text-[48px] text-ink">Most courses teach you something <em>new.</em> InnerBoard <em>names</em> something true.</h2>
        </div>
        <p class="reveal text-[17px] sm:text-[19px] leading-relaxed text-ink-muted" style="--d:120ms">
          The frameworks are not ideas to memorize. They are <em class="font-display text-ink">mirrors.</em> You read them and recognize yourself: what has been running, what it has been costing you, what has been possible the whole time. That is the moment a course stops being content and becomes change.
        </p>
      </div>
    </div>
  </section>

  <!-- ── What becomes possible ────────────────────────────────────────── -->
  <section class="on-dark bg-teal text-white">
    <div class="wrap py-20 sm:py-28">
      <div class="reveal max-w-[720px]">
        <p class="eyebrow">What becomes possible</p>
        <h2 class="mt-4 text-[36px] sm:text-[52px]">Real shifts. Real <em>lives.</em></h2>
      </div>
      <ul class="mt-12 grid gap-4 md:grid-cols-3">
        {testimonials.map((t, i) => (
          <li class="reveal rounded-[18px] bg-teal-2 p-7 flex flex-col" style={`--d:${i * 90}ms`}>
            <p class="font-display text-[20px] leading-[1.3] flex-1">"{t}"</p>
            <p class="mt-6 text-[13px] font-semibold uppercase tracking-[0.12em] text-white/70">Academy student</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Go further ───────────────────────────────────────────────────── -->
  <section class="bg-ac-cream-2">
    <div class="wrap py-20 sm:py-28">
      <div class="reveal max-w-[720px]">
        <p class="eyebrow">Want to go further?</p>
        <h2 class="mt-4 text-[36px] sm:text-[52px] text-ink">The Academy is where it <em>starts.</em></h2>
        <p class="mt-4 text-[17px] text-ink-muted">It doesn't have to be where it ends.</p>
      </div>
      <div class="mt-12 grid gap-4 md:grid-cols-2">
        <div class="reveal card p-8">
          <p class="eyebrow">Live</p>
          <h3 class="mt-3 text-[30px] text-ink"><em>Inner</em>Lab.</h3>
          <p class="mt-3 text-[15.5px] leading-relaxed text-ink-muted">Put the frameworks into daily practice. Live coaching. Community. Real accountability.</p>
          <a href={LINKS.innerlab} class="link-arrow mt-5 text-[14.5px]" data-passthrough>Explore InnerLab <Arrow /></a>
        </div>
        <div class="reveal card p-8" style="--d:100ms">
          <p class="eyebrow">Lead</p>
          <h3 class="mt-3 text-[30px] text-ink">INQ <em>Certify</em>.</h3>
          <p class="mt-3 text-[15.5px] leading-relaxed text-ink-muted">If the Graduate work lights you up, INQ is what comes next.</p>
          <a href={LINKS.inq} class="link-arrow mt-5 text-[14.5px]">Explore Certify <Arrow /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── The filter ───────────────────────────────────────────────────── -->
  <section class="on-dark bg-ink text-cream">
    <div class="wrap py-24 sm:py-32">
      <div class="reveal max-w-[820px]">
        <p class="eyebrow">The filter</p>
        <h2 class="mt-4 text-[38px] sm:text-[56px]">There is what you have <em>learned.</em> And what you were <em>never taught.</em></h2>
        <p class="mt-5 text-[18px] text-on-dark-muted">This is the curriculum.</p>
        <a href={LINKS.academyApp} class="btn btn-teal mt-8" data-passthrough data-event="academy_start_click" data-event-location="filter">Start with Human Foundations <Arrow /></a>
      </div>
    </div>
  </section>
</Base>
