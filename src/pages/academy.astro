---
/**
 * Academy, as Leah's Academy page mockup (November 6) has it, in the site's own type, colors and buttons: the hero
 * (own it, practice it), the library in its three groups (the core curriculum open now, the life stage and domain
 * collections coming soon), the closing line, and a view of its own for each open collection.
 *
 * A collection's view is this page at /academy#<collection>, as in the mockup: every view is in the page, and the
 * one the address names is shown (CSS :target), so it opens, goes back and shares without the script. Each Buy is
 * a link to the app's checkout for that course, collection or single course (`academyBuy`).
 *
 * The logos are the Drive's "Academy Logos / USE THESE LOGOS", files 14 to 26 (the icon with its name under it),
 * re-inked onto the light card and the dark-mode card. Parenting & Family Life has none yet, so a quiet tile
 * holds its place.
 */
import Layout from "../layouts/Practice.astro";
import { GROUPS, OPEN, dollars, type OpenCollection, type SoonCollection } from "../data/practice";
import { academyBuy } from "../config/links";

const isOpen = (c: OpenCollection | SoonCollection): c is OpenCollection => "id" in c;
---
<Layout title="Academy · The Practice" description="The curriculum school never offered. Self-paced courses in the skills nobody taught you: what to do with a racing mind, a big feeling, a hard conversation." path="/academy" nav="learn">
<section class="view aca" id="academy">
  <div class="alib">
    <div class="phero aca-hero">
      <div class="wrap">
        <p class="eyebrow">Learn it · The Academy</p>
        <h1>The curriculum school <em>never</em> offered.</h1>
        <p class="lede">Self-paced courses in the skills nobody taught you: what to do with a racing mind, a big feeling, a hard conversation. Start at the beginning, or start where you are.</p>
        <div class="ways">
          <div><h2>Own it</h2><p>Buy a course here and it’s yours as a PDF to print and return to.</p></div>
          <div><h2>Practice it</h2><p>Practice Club members use every Academy course inside the Practice.</p></div>
        </div>
      </div>
    </div>

    <div class="band" id="library">
      <div class="wrap">
        <p class="eyebrow">The library</p>
        <h2 class="h2">Find your <em>door in.</em></h2>
        <p class="lede" style="margin-top:14px">Most people start with Human Foundations, the complete inner-world curriculum. Start anywhere else if you already know exactly where the work is calling.</p>
        {GROUPS.map((g) => (
          <>
            <h3 class="lib-group">{g.label}</h3>
            <div class:list={["lib-grid", { four: g.cards.length === 4 }]}>
              {g.cards.map((c) => {
                const icon = c.image ? (
                  <picture><source srcset={c.dark} media="(prefers-color-scheme: dark)" /><img src={c.image} alt="" width="1280" height="800" loading="lazy" decoding="async" /></picture>
                ) : (
                  <span class="lib-ph" aria-hidden="true"></span>
                );
                return isOpen(c) ? (
                  <a class="lib-card" href={`#${c.id}`}>
                    <div class="lib-icon">{icon}</div>
                    <div class="lib-body">
                      <h4>{c.name}</h4>
                      <p>{c.blurb}</p>
                      <div class="lib-foot"><span class="status">Available now</span><span class="go">Open the collection <span class="arr">→</span></span></div>
                    </div>
                  </a>
                ) : (
                  <div class="lib-card soon">
                    <div class="lib-icon">{icon}</div>
                    <div class="lib-body">
                      <h4>{c.name}</h4>
                      <p>{c.blurb}</p>
                      <div class="lib-foot"><span class="status">Coming soon</span></div>
                    </div>
                  </div>
                );
              })}
            </div>
          </>
        ))}
      </div>
    </div>

    <div class="band navy on-navy">
      <div class="wrap closer"><h2>There is what you have <em>learned.</em> And what you were <em>never taught.</em></h2><a class="btn btn-solid" href="#human-foundations">Start with Human Foundations <span class="arr">→</span></a></div>
    </div>
  </div>

  {OPEN.map((c) => (
    <div class="band acoll" id={c.id}>
      <div class="wrap">
        <a class="back" href="#library"><span aria-hidden="true">←</span> All collections</a>
        <div class="col-hero">
          <div class="col-icon"><picture><source srcset={c.dark} media="(prefers-color-scheme: dark)" /><img src={c.image} alt="" width="1280" height="800" loading="lazy" decoding="async" /></picture></div>
          <div class="stack" style="gap:12px">
            <p class="eyebrow">The Academy</p>
            <h1>{c.name}</h1>
            <p class="lede">{c.blurb}</p>
          </div>
        </div>
        <p class="access"><span><b>Own it:</b> buy here and receive the PDF.</span><span><b>Practice it:</b> included for Practice Club members in the Practice.</span></p>

        {c.tiers && c.bundle && (
          <>
            {c.tiers.map((t) => (
              <div class="tier">
                <div class="tier-head">
                  <div><h2>{t.tier}</h2><p>{t.what}</p></div>
                  <span class="price">{dollars(t.courses[0].price)} each</span>
                </div>
                <ul class="rows">
                  {t.courses.map((k) => (
                    <li>
                      <div><h3>{k.title}</h3><p>{k.line}</p></div>
                      <a class="btn btn-line buy" href={academyBuy(k.id)} aria-label={`Buy ${k.title}, ${dollars(k.price)}`}>Buy</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <div class="bundle on-navy">
              <div><h2>{c.bundle.title}</h2><p>{c.bundle.text}</p></div>
              <div class="bundle-buy"><span class="price">{dollars(c.price)}</span><a class="btn btn-solid" href={academyBuy(c.id)} aria-label={`Buy the ${c.name} collection, ${dollars(c.price)}`}>Buy the collection <span class="arr">→</span></a></div>
            </div>
          </>
        )}

        {c.single && (
          <>
            <div class="tier">
              <div class="tier-head">
                <div><h2>{c.single.label}</h2><p>{c.single.note}</p></div>
                <span class="price">{dollars(c.price)}</span>
              </div>
              <ul class="rows">
                {c.single.modules.map((m) => <li><div><h3>{m.title}</h3>{m.line && <p>{m.line}</p>}</div></li>)}
              </ul>
            </div>
            <div class="bundle on-navy">
              <div><h2>{c.name}</h2><p>{c.single.label}. Yours as a PDF to print and return to.</p></div>
              <div class="bundle-buy"><span class="price">{dollars(c.price)}</span><a class="btn btn-solid" href={academyBuy(c.id)} aria-label={`Buy ${c.name}, ${dollars(c.price)}`}>Buy the course <span class="arr">→</span></a></div>
            </div>
          </>
        )}
      </div>
    </div>
  ))}
</section>
</Layout>
