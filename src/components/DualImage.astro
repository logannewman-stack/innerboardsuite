---
/**
 * A logo or mark drawn in the design's navy for light screens, with its cream cut for dark mode
 * (prefers-color-scheme: dark), so it never disappears into a dark header or band.
 */
interface Props { src: string; dark: string; alt: string; width: number; height: number; class?: string; eager?: boolean }
const { src, dark, alt, width, height, class: className, eager = false } = Astro.props;
---
<picture><source srcset={dark} media="(prefers-color-scheme: dark)" /><img class={className} src={src} alt={alt} width={width} height={height} loading={eager ? "eager" : "lazy"} decoding="async" /></picture>
