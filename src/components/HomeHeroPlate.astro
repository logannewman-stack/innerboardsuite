---
/**
 * The home hero's object (STORY_V2 2.2): the phone alone on the cream, large,
 * with its own floor shadow, resting on the Coach home. It is not a scroll
 * story any more: the hero never pins, so the first notch of scroll moves the
 * page. The ring on the composer and the draft typing in now open the forest
 * panel's story right under it, on the same screen, under the headline
 * "Daily Practice Coach".
 *
 * The entrance slide lives on the inner wrapper; the section's CSS
 * (index.astro) places the outer one: on laptops at the right of the first
 * screen, centred between the header line and the hero's bottom, on tablets
 * and phones under the copy.
 */
import PhoneFrame from "./PhoneFrame.astro";
---
<div class="hm-hero-phone">
  <div class="hm-hero-device rise-obj floor-on" style="--d:.3s">
    <PhoneFrame
      id="hero-phone"
      width={400}
      style="--pw:inherit"
      eager
      shadow="light"
      tilt={3}
      label="Practice on a phone: the Daily Practice Coach."
      screens={[
        { name: "home", alt: "Practice on a phone: the Daily Practice Coach, the Dare of the Day and Set Up Your Day.", w: 600, h: 1298 }
      ]}
    />
  </div>
</div>
