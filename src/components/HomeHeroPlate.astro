---
/**
 * The home hero's object: the phone alone on the cream, large, in a soft
 * warm halo with its own floor shadow, playing the Coach scene (the ring
 * presses the composer, the draft appears, the home returns). The navy plate
 * that stood behind it is gone by the client's direction (it sat where a
 * photograph used to be). It is a sibling of the copy inside the hero
 * section, which positions it; the section's CSS lives in index.astro.
 */
import PhoneFrame from "./PhoneFrame.astro";
---
<div class="hm-hero-phone rise-obj floor-on" style="--d:.3s">
  <i class="hm-halo" aria-hidden="true"></i>
  <PhoneFrame
    id="hero-phone"
    width={380}
    style="--pw:inherit"
    eager
    shadow="light"
    tilt={3}
    parallax={-36}
    loop={1400}
    flow='[["hold",1000],["tap",50,27],["state",1,320],["hold",6200],["state",0,320],["end"]]'
    screens={[
      { name: "home", alt: "Practice on a phone: the Daily Practice Coach, the Dare of the Day and Set Up Your Day.", w: 600, h: 1298 },
      { name: "coach-draft", alt: "The Daily Practice Coach with a sentence typed in the composer.", w: 780, h: 1688 }
    ]}
  />
</div>
