---
/**
 * Everything inside (SCROLL_SPEC S8, STORY_V2 3.5) as a scroll story on the
 * step layout: four steps, one per ladder row, one row at a time beside the
 * device (its name the headline, its line the body, both inside the row's
 * link). On laptops the desk window pins at the left with the rail: the
 * cursor goes to that row's item in the app's own rail, and it clicks only
 * where the next capture shows that item open (The Book, InnerBoard OS). The
 * window never leans in: the Company OS Score frame carries a sample score,
 * so no camera ever makes it the focus. On tablets and phones a phone takes
 * the window's place, with the app's own bottom bar: each step rings that
 * row's tab (the Academy, Inner Lab, the header's book icon, InnerBoard OS),
 * then the Track wipes in. The caption follows the window's frame; the rail
 * and its counter replace the old marks. Nothing moves until the reader
 * scrolls.
 *
 * Static (no script, reduced motion, short screens): the four rows in order,
 * each followed by its own figure where it has one (a 640 window above 734,
 * the phone at 734 and below).
 */
import WindowFrame from "./WindowFrame.astro";
import PhoneFrame from "./PhoneFrame.astro";
import StoryMarks from "./StoryMarks.astro";
import Arrow from "./Arrow.astro";
import { LINKS } from "../config/links";

const caps = [
  "The Coach home, on a desk.",
  "A Company OS Score result, with The Book open in the rail.",
  "The Track page, on a desk."
];
const win = [
  { name: "desk-coach-draft", alt: "Practice on a desk: the Daily Practice Coach with a sentence typed, the Dare of the Day, Set Up Your Day and the October calendar." },
  { name: "desk-score-upstream-result", alt: "A Company OS Score result on a desk, with The Book open in the rail." },
  { name: "desk-track-home", alt: "The Track page on a desk, with InnerBoard OS open in the rail." }
];
const phone = [
  { name: "coach-draft", alt: "The Daily Practice Coach on a phone, with the app's bottom bar.", w: 780 as const, h: 1688 as const },
  { name: "track-home", alt: "The Track on a phone: the module assessments under Personal leadership and Social leadership.", w: 780 as const, h: 1688 as const }
];
/* Acts are SCROLL_SPEC S8 as written. Rail items of the desk captures (% of the capture): Academy 5, 13.8;
 * Inner Lab 5, 18.7; InnerBoard OS 5, 23.6; The Book 5, 38.2. Halos on the phone: the Academy tab, the Inner Lab
 * tab, the header's book icon, the InnerBoard OS tab. */
const rows = [
  { name: "The Academy", body: "Every collection, read and practiced in the same place.", href: LINKS.academy, pass: false, external: false, w: undefined, win: 0, phone: 0,
    alt: win[0].alt, altN: phone[0].alt,
    act: '{"win":{"f":0,"cur":[[.1,40,60],[.4,5,13.8]]},"phone":{"f":0,"halo":0}}' },
  { name: "Inner Lab", body: "Live sessions each month, the masterclass open to anybody, and a community.", href: LINKS.innerlab, pass: true, external: false, w: undefined, win: null, phone: null,
    alt: win[0].alt, altN: phone[0].alt,
    act: '{"win":{"cur":[[.12,5,13.8],[.38,5,18.7]]},"phone":{"halo":1}}' },
  { name: "The Book", body: "Replaceable: the book, the audiobook, its assessments and worksheets, with each chapter's door into the practice.", href: LINKS.book, pass: true, external: false, w: 1.2, win: 1, phone: null,
    alt: win[1].alt, altN: phone[0].alt,
    act: '{"win":{"cur":[[.1,5,18.7],[.36,5,38.2]],"click":.44,"next":[.48,1]},"phone":{"halo":2}}' },
  { name: "InnerBoard OS", body: "The Company OS Score, the Team OS Score and the Gap Audit, and the curriculum a team works through.", href: LINKS.ios, pass: false, external: true, w: 1.2, win: 2, phone: 1,
    alt: win[2].alt, altN: phone[1].alt,
    act: '{"win":{"cur":[[.1,5,38.2],[.36,5,23.6]],"click":.44,"next":[.48,2]},"phone":{"halo":3,"haloEnd":.42,"next":[.5,1]}}' }
];
const W = rows.reduce((t, r) => t + (r.w ?? 1), 0);
---
<div class="story pr-inside" data-story="inside" data-story-ui="steps" data-side="left" data-kind="win" data-warm style={`--story-w:${W};--step-l:64svh;--step-l-n:58svh`}>
  <div class="story-track">
    <div class="story-stage">
      <div class="story-device-col">
        <StoryMarks variant="rail" labels={rows.map((r) => r.name)} label="Everything inside, row by row" />
        <div class="story-device-box pr-inside-box">
          <!-- Laptops: the desk window and its caption. -->
          <div class="story-win pr-inside-win">
            <WindowFrame id="inside-win" device="win" ww={900} label="Practice on a desk, one rail item at a time." screens={win} />
            <div class="win-caps">
              {caps.map((c, i) => <p class={`win-cap t-cap-i${i === 0 ? " on" : ""}`} data-cap={i}>{c}</p>)}
            </div>
          </div>
          <!-- Tablets and phones: the phone with the app's own bottom bar. -->
          <div class="story-phone pr-inside-phone" style="--pw-max-n:240px">
            <PhoneFrame device="phone" width={240} style="--pw:inherit" label="Practice on a phone, one tab at a time."
              halos={[{ x: 26.7, y: 95 }, { x: 42, y: 95 }, { x: 77, y: 3.4 }, { x: 57.7, y: 95 }]} screens={phone} />
          </div>
        </div>
      </div>
      <div class="story-copy">
        <ul class="story-steps ladder pr-inside-ladder" role="list">
          {rows.map((r, i) => (
            <li class="story-step" data-step={i} data-w={r.w} data-act={r.act}>
              <p class="eyebrow story-eyebrow story-only story-repeat" aria-hidden="true">Everything inside</p>
              <a href={r.href} data-passthrough={r.pass ? true : undefined} rel={r.external ? "noopener" : undefined}>
                <span class="pr-row">
                  <span class="ladder-name story-h">{r.name}</span>
                  <span class="ladder-body story-body">{r.body}</span>
                </span>
                <span class="pr-arrow" aria-hidden="true"><Arrow /></span>
              </a>
              <span class="sr-only story-alt pr-alt-w">{r.alt}</span>
              <span class="sr-only story-alt pr-alt-n">{r.altN}</span>
              {(r.win !== null || r.phone !== null) && (
                <div class="story-static">
                  {r.win !== null && (
                    <div class="static-desk">
                      <WindowFrame ww={640} screens={[win[r.win]]} />
                      <p class="t-cap-i pr-static-cap">{caps[r.win]}</p>
                    </div>
                  )}
                  {r.phone !== null && <div class="static-phone"><PhoneFrame width={180} screens={[phone[r.phone]]} /></div>}
                </div>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="story-run" aria-hidden="true"></div>
  </div>
</div>
