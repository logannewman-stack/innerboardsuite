---
/**
 * A day in Practice (SCROLL_SPEC S5) on the scroll story contract (1.3): the
 * slot of step text beside (wide) or under (narrow) the sky mat, which is the
 * device box: four sky layers, one phone holding every frame of the day, the
 * running caption and the progress marks. The story engine pins it under the
 * header; the scroll alone decides the step, the frame, every tap, swap and
 * lean (each step's `act`), and blends the sky with the day; the section's
 * data-tone turns navy on the last step.
 *
 * Without the script, under reduced motion or on a short screen it is static:
 * each step in order with its own phone (its `static` frame, by default the
 * frame the step ends on) and its caption, the evening step on navy.
 *
 * `frames` is the phone's frame list (index order is what the acts refer to).
 * Without it the frames are collected from each step's `frames`, in order of
 * first appearance, and a step without an `act` simply shows its first frame
 * from its start (the shape /practice passes today).
 */
import PhoneFrame from "./PhoneFrame.astro";
import StoryMarks from "./StoryMarks.astro";
interface TypeLine { x: number; y: number; w: number; h: number; fill: string }
interface Frame { name: string; alt: string; w: 600 | 780; h: 1298 | 1688; type?: TypeLine[]; strip?: { next: string; at: number; head?: number; foot?: number } }
interface Step { label: string; name: string; body: string; caption: string; act?: string; w?: number; static?: number | [number, number] | null; alt?: string; frames?: Frame[]; flow?: string }
interface Props { steps: Step[]; frames?: Frame[]; width: number; id?: string; class?: string; stepL?: string; stepLN?: string; label?: string; marksLabel?: string }
const { steps, width, id, class: className = "", stepL = "80svh", stepLN = "68svh", label = "The day in Practice, screen by screen.", marksLabel = "A day in Practice" } = Astro.props;

/* The phone's frames: given, or every distinct frame of the steps once, in order of first appearance. */
let frames: Frame[] = Astro.props.frames || [];
const index = new Map<string, number>();
if (Astro.props.frames) frames.forEach((f, i) => index.set(f.name, i));
else {
  for (const s of steps) for (const f of s.frames || []) if (!index.has(f.name)) { index.set(f.name, frames.length); frames.push(f); }
}
/* Each step's act (JSON for data-act), and the frame (and strip offset) it ends on, for its static figure. */
let cur = 0;
const plan = steps.map((s) => {
  const act = s.act ?? JSON.stringify({ day: { f: index.get(s.frames?.[0]?.name || "") ?? 0 } });
  let a: { f?: number; next?: [number, number]; scroll?: [number, number, number, number] } = {};
  /* Acts may write numbers with a leading point (.42), as SCROLL_SPEC does; the engine reads them the same way. */
  try { a = (JSON.parse(act.replace(/([[,:]\s*-?)\.(\d)/g, "$10.$2")).day || {}); } catch { /* the engine reports a bad act and stays static */ }
  if (a.f !== undefined) cur = a.f;
  if (a.next) cur = a.next[1];
  const end = a.scroll ? [cur, a.scroll[3]] as [number, number] : cur;
  const st = s.static === undefined ? end : s.static;
  const frame = st === null ? null : Array.isArray(st) ? frames[st[0]] : frames[st];
  const off = Array.isArray(st) ? st[1] : undefined;
  return { act, frame, off, alt: s.alt ?? frame?.alt ?? "" };
});
const W = steps.reduce((t, s) => t + (s.w ?? 1), 0);
const skies = ["morning", "midday", "afternoon", "evening"];
---
<div class={`story day ${className}`.trim()} data-story="day" data-warm id={id} style={`--story-w:${W};--step-l:${stepL};--step-l-n:${stepLN};--day-pw:${width}px`}>
  <div class="story-track">
    <div class="story-stage">
      <ol class="story-steps day-list" data-story-text="slot">
        {steps.map((s, i) => (
          <li class={`story-step day-item${i === steps.length - 1 ? " is-evening" : ""}`} data-step={i} data-act={plan[i].act} data-w={s.w}>
            <div class="day-item-in">
              <span class="eyebrow">{s.label}</span>
              <h3 class="t-s">{s.name}</h3>
              <p class="t-body">{s.body}</p>
              <span class="sr-only story-alt">{plan[i].alt}</span>
              {plan[i].frame && (
                <div class="story-static">
                  <PhoneFrame screens={[plan[i].frame!]} width={200} caption={s.caption} off={plan[i].off} />
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
      <div class="story-device-box day-stage">
        {skies.map((k) => <i class="sky" data-sky={k} aria-hidden="true"></i>)}
        <PhoneFrame class="floor-on" device="day" screens={frames} width={width} style="--pw:inherit" label={label} />
        <div class="day-caps" aria-hidden="true">
          {steps.map((s, i) => <p class={`day-cap${i === 0 ? " on" : ""}`} data-cap={i}>{s.caption}</p>)}
        </div>
        <StoryMarks labels={steps.map((s) => s.name)} label={marksLabel} />
      </div>
    </div>
    <div class="story-run" aria-hidden="true"></div>
  </div>
</div>
