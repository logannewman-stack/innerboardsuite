---
/**
 * The colophon (1.9). Painted linen on the Suite pages, the alternate cream on
 * the Academy and INQ pages. It paints its own colour, so the page tone engine
 * skips it and the last section's tone holds to the end of the page (it keeps
 * data-tone for the no JS fallback and older selectors). The locked blurb with
 * the one founder mention on the site under it in columns 1 to 6, the three
 * link columns beside it in columns 7 to 12, the gold rule, the legal row.
 */
import Wordmark from "./Wordmark.astro";
import { LINKS, SITE } from "../config/links";
interface Props { theme?: "cream" | "teal" }
const { theme = "cream" } = Astro.props;
const year = new Date().getFullYear();
---
<footer class={`site-footer ${theme === "teal" ? "theme-teal" : ""}`.trim()} data-tone={theme === "teal" ? "ac-cream" : "cream"}>
  <div class="wrap">
    <div class="ftr-top rise">
      <div class="ftr-blurb-col">
        <Wordmark size="footer" />
        <p class="ftr-blurb">Self-leadership from the inside out. The framework, the practice ground, and the community for the work of becoming yourself.</p>
        <p class="ftr-founder">Founded by {SITE.founder}.</p>
      </div>
      <div class="ftr-cols">
        <nav class="ftr-col" aria-label="Footer, InnerBoard">
          <p class="eyebrow">InnerBoard</p>
          <ul>
            <li><a href={LINKS.academy}>Academy</a></li>
            <li><a href={LINKS.inq}>INQ Certification</a></li>
            <li><a href={LINKS.ios} rel="noopener">InnerBoard IOS</a></li>
            <li><a href={LINKS.contact}>Contact</a></li>
          </ul>
        </nav>
        <nav class="ftr-col" aria-label="Footer, Practice">
          <p class="eyebrow">Practice</p>
          <ul>
            <li><a href={LINKS.practicePage}>How it works</a></li>
            <li><a href={LINKS.practice} data-passthrough>Start in Practice</a></li>
            <li><a href={LINKS.quiz} data-passthrough>Take the quiz</a></li>
            <li><a href={LINKS.login}>Log in</a></li>
          </ul>
        </nav>
        <div class="ftr-col ftr-col-wide">
          <p class="eyebrow">Write to us</p>
          <ul>
            <li><a href={`mailto:${LINKS.contactEmail}`}>{LINKS.contactEmail}</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="ftr-rule rule-draw" aria-hidden="true"></div>
    <div class="ftr-legal">
      <p>&copy; {year} InnerBoard. All rights reserved.</p>
      <nav aria-label="Legal">
        <a href={LINKS.privacy}>Privacy policy</a>
        <a href={LINKS.terms}>Terms</a>
      </nav>
    </div>
  </div>
</footer>
