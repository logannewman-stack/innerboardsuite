---
/** A real screen from Practice on a desktop, inside a browser window. Taken at 1440 by 900 on a 2x display. */
interface Props { screen: string; alt: string; class?: string; eager?: boolean }
const { screen, alt, class: className = "", eager = false } = Astro.props;
---
<figure class={`browser ${className}`} style="margin:0">
  <div class="browser-screen">
    <picture>
      <source type="image/webp" srcset={`/app/${screen}.webp`} />
      <img src={`/app/${screen}.jpg`} alt={alt} width="1600" height="1000" loading={eager ? "eager" : "lazy"} decoding="async" fetchpriority={eager ? "high" : undefined} class="block w-full h-auto" />
    </picture>
  </div>
</figure>
