---
/**
 * The four recognition cards (1.6). Flip on click, tap, Enter and Space;
 * never on their own. Paper fronts, Practice navy backs with a lamp and grain, both
 * faces in one grid cell so the card takes the taller face. The quotes and
 * reframes are locked copy; our labels are the four cues and the sr sentence.
 * The closing statement renders after the list, as before.
 */
import Arrow from "./Arrow.astro";
const cards = [
  { front: "The conversation ended hours ago. You're still having it.", back: "You can't change what was said. But you can change what you keep telling yourself about it.", lead: "You can't change what was said." },
  { front: "On paper, it's a good life. So why doesn't it feel like one?", back: "Maybe your life doesn't need to change. Maybe the way you're experiencing it can.", lead: "Maybe your life doesn't need to change." },
  { front: "Everyone counts on you. You'd never let on what it costs.", back: "There's another way to show up for everyone without losing yourself in the process.", lead: "There's another way to show up for everyone without losing yourself in the process." },
  { front: "Nothing about you needs fixing. How you meet life is a skill, and nobody ever taught it to you.", back: "The way you think, feel, and respond isn't fixed. It's something you can learn and practice.", lead: "The way you think, feel, and respond isn't fixed." }
];
const split = (c: (typeof cards)[number]) => c.back.startsWith(c.lead) ? [c.lead, c.back.slice(c.lead.length)] : ["", c.back];
interface Props { class?: string }
const { class: className = "" } = Astro.props;
---
<ul class={`flips ${className}`.trim()} role="list">
  {cards.map((card, i) => {
    const [lead, rest] = split(card);
    return (
      <li class={`flip-item rise ${i % 2 === 0 ? "slide-l" : "slide-r"}`} style={`--d:${i * 90}ms`}>
        <button type="button" class="flip" aria-pressed="false">
          <span class="flip-inner">
            <span class="flip-face flip-front paper">
              <span class="eyebrow">Sound familiar?</span>
              <span class="flip-quote">"{card.front}"</span>
              <span class="flip-cue">Flip it <Arrow /></span><span class="sr-only">Press to flip the card.</span>
            </span>
            <span class="flip-face flip-back grain">
              <i class="lamp" aria-hidden="true"></i>
              <span class="eyebrow">Another way</span>
              <span class="flip-reframe">{lead && <b>{lead}</b>}{rest}</span>
              <span class="flip-cue">Flip it back</span>
            </span>
          </span>
          <i class="sheen" aria-hidden="true"></i>
        </button>
      </li>
    );
  })}
</ul>
<p class="flip-close t-s-quote rise">Same life. <em>A different way to meet whatever life brings.</em></p>
