---
/**
 * The quiz still life (BUILD_SPEC 2.1.4, SCROLL_SPEC S3): a linen mat with a
 * whisper of blush (the only blush on the site), the quiz phone standing on
 * it and the drawn toggle card leaning behind the phone's lower left. It is
 * the device box of the home quiz's scroll story: as the reader scrolls, the
 * phone shows question one, then the result, then the result scrolls inside
 * the phone to the other five patterns while the card's Approval switch turns
 * off (the mat carries data-story-g, so the switch reads the story's --g; the
 * page's CSS scrubs it). In the static layout (no script, reduced motion, a
 * short or landscape screen) the mat is not shown and each benefit carries
 * its own figure. The page passes the phone's frames (the benefits' static
 * figures use the same ones) and sizes the mat and the phone.
 */
import ToggleCard from "./ToggleCard.astro";
import PhoneFrame from "./PhoneFrame.astro";
interface Strip { next: string; at: number; head?: number; foot?: number }
interface Screen { name: string; alt: string; w: 600 | 780; h: 1298 | 1688; strip?: Strip }
interface Props { screens: Screen[] }
const { screens } = Astro.props;
---
<div class="mat mat-blush hm-mat story-device-box floor-on" data-story-g>
  <ToggleCard class="hm-tcard tcard-in" />
  <PhoneFrame
    class="hm-quiz-phone"
    device="quiz"
    width={268}
    style="--pw:inherit"
    label="The subscription quiz on a phone, from a question to the result."
    screens={screens}
  />
</div>
