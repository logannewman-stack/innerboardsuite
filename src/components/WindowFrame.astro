---
/**
 * A browser window for desktop captures, drawn in em of its width (1.6).
 * `ww` is the cap; the script writes the rendered width back to --ww on
 * measure so the chrome stays exact. `x2` on a screen adds the 2880 px file
 * to a width described srcset (1600w and 2880w) with sizes of the cap, so a
 * 1x screen loads the 1600 file and a 2x screen the 2880 one; phones load the
 * 1600 file at any pixel ratio. Nothing here moves on its own: inside a
 * scroll story (SCROLL_SPEC 1.3, `device` set) the story engine shows the
 * frames, moves the camera and the drawn cursor (.cur) and presses it.
 * `label` makes the figure role="img" with that name, and its frames alt="".
 * `fade` on a screen is a CSS mask image for that capture: the frame becomes a
 * group (div.ds.ds-group) painted the app's own ivory, #f2ece0, under the masked
 * capture, so a part of a screen the site must not show fades out to the app's
 * ground (as PhoneFrame's `fade`). Nothing is drawn over the capture.
 */
interface Screen { name: string; alt: string; x2?: boolean; fade?: string }
interface Props {
  screens: Screen[];
  ww: number;
  eager?: boolean;
  rest?: number;
  chrome?: "light" | "dark";
  class?: string;
  id?: string;
  parallax?: number;
  tilt?: number;
  style?: string;
  device?: string;
  label?: string;
}
const { screens, ww, eager = false, rest = 0, chrome = "light", class: className = "", id, parallax, tilt, style = "", device, label } = Astro.props;
const restIdx = Math.min(Math.max(0, rest), screens.length - 1);
---
<figure
  class={`win ${chrome === "dark" ? "win-dark" : ""} ${className}`.trim()}
  id={id}
  style={`--ww:${ww}px;${style}`}
  data-ww={ww}
  data-frames
  data-device={device}
  data-rest={restIdx || undefined}
  data-parallax={parallax}
  data-tilt={tilt}
  role={label ? "img" : undefined}
  aria-label={label}
>
  <div class="win-bar" aria-hidden="true">
    <span class="win-dots"><i></i><i></i><i></i></span>
    <span class="win-url"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><rect x="2.5" y="5.5" width="7" height="5" rx="1.2"/><path d="M4 5.5V4a2 2 0 0 1 4 0v1.5"/></svg>practiceinnerboard.com</span>
    <span></span>
  </div>
  <div class="win-screen">
    <span class="slot" aria-hidden="true"></span>
    <div class="cam">
      {screens.map((s, i) => {
        const img = (cls: string | undefined, style: string | undefined) => (
          <img
            class={cls}
            src={`/app/${s.name}.webp`}
            srcset={s.x2 ? `/app/${s.name}.webp 1600w, /app/${s.name}-2x.webp 2880w` : undefined}
            sizes={s.x2 ? `(max-width: 734px) 100vw, ${ww}px` : undefined}
            alt={label ? "" : s.alt}
            width="1600"
            height="1000"
            style={style}
            decoding="async"
            loading={eager && i === restIdx ? "eager" : "lazy"}
            fetchpriority={eager && i === restIdx ? "high" : undefined}
          />
        );
        if (!s.fade) return img(`ds${i === restIdx ? " on" : ""}`, undefined);
        return (
          <div class={`ds ds-group${i === restIdx ? " on" : ""}`} style="background:#f2ece0">
            {img(undefined, `-webkit-mask-image:${s.fade};mask-image:${s.fade}`)}
          </div>
        );
      })}
    </div>
    <span class="cur" aria-hidden="true"><svg viewBox="0 0 22 28" aria-hidden="true"><path d="M4 2.5v20.2l5.1-4.6 3.3 7.6 3.6-1.6-3.3-7.4h7Z" fill="#fff" stroke="#1b1916" stroke-width="1.4" stroke-linejoin="round"/></svg></span>
  </div>
</figure>
