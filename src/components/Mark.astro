---
/** The InnerBoard mark: a ring, a crosshair run a little past it, a point at the centre. Takes currentColor. */
interface Props { class?: string }
const { class: className = "w-6 h-6" } = Astro.props;
---
<svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" aria-hidden="true" focusable="false">
  <circle cx="12" cy="12" r="8.2" stroke-width="2"></circle>
  <path d="M12 1.6v20.8M1.6 12h20.8" stroke-width="1.5"></path>
  <circle cx="12" cy="12" r="2.4" fill="currentColor" stroke="none"></circle>
</svg>
