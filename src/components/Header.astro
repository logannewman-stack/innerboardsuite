---
/**
 * The header (1.8): fixed, transparent at the top, frosted after 24 px, dark
 * over dark sections (1.7.6), hidden on scroll down. The three locked links
 * with their sub labels, the gold pill. Below 1069 px the links collapse to
 * the burger and a full screen sheet (rendered after the header so neither
 * the blur nor the hide transform contains it).
 */
import Wordmark from "./Wordmark.astro";
import Arrow from "./Arrow.astro";
import { LINKS } from "../config/links";
interface Props { theme?: "cream" | "teal" }
const { theme = "cream" } = Astro.props;
const nav = [
  { href: LINKS.academy, label: "Academy", sub: "Learn It", external: true },
  { href: "/inq-certification", label: "INQ Certification", sub: "Lead It" },
  { href: LINKS.ios, label: "InnerBoard IOS", sub: "Scaling for Teams", external: true }
];
const current = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
---
<header data-header class={`site-header ${theme === "teal" ? "theme-teal" : ""}`.trim()}>
  <div class="wrap">
    <div class="hdr-row">
      <Wordmark />
      <nav aria-label="Primary" class="hdr-links">
        {nav.map((item) => (
          <a href={item.href} class="hdr-link" aria-current={current === item.href ? "page" : undefined} rel={item.external ? "noopener" : undefined}>
            {item.label}<span class="sub">{item.sub}</span>
          </a>
        ))}
        <a href={LINKS.practice} class="btn btn-sm btn-gold hdr-cta" data-passthrough data-event="practice_click" data-event-location="header">Start in Practice <Arrow /></a>
      </nav>
      <button type="button" class="hdr-burger" data-menu-button aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu"><i></i><i></i></button>
    </div>
  </div>
</header>
<div id="mobile-menu" data-menu-panel class="menu-panel">
  <nav aria-label="Primary, mobile" class="wrap menu-nav">
    {nav.map((item, i) => (
      <a href={item.href} class="menu-link" style={`--i:${i}`} rel={item.external ? "noopener" : undefined}>
        {item.label}<span class="sub">{item.sub}</span>
      </a>
    ))}
    <div class="menu-cta menu-link" style="--i:3">
      <a href={LINKS.practice} class="btn btn-gold" data-passthrough data-event="practice_click" data-event-location="mobile-menu">Start in Practice <Arrow /></a>
    </div>
  </nav>
</div>
