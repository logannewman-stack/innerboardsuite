---
/**
 * The header: the wordmark, the InnerBoard menu (Academy, the Lab, INQ), The Practice, For Organizations, The Club,
 * and Start Practicing. `nav` marks the section the page belongs to (aria-current). The menu and the InnerBoard
 * submenu open with the script; without it the noscript styles in the layout show them open.
 */
import { ROUTES } from "../config/links";
import DualImage from "./DualImage.astro";
interface Props { nav?: "learn" | "app" | "ios" | "club" }
const { nav } = Astro.props;
const cur = (n: string) => (nav === n ? "page" : undefined);
---
<header class="site">
  <div class="wrap nav">
    <a class="brand" href={ROUTES.home} aria-label="The Practice home">
      <DualImage class="wm-img" src="/images/practice/logo-practice.webp" dark="/images/practice/logo-practice-light.webp" alt="Practice by InnerBoard" width={560} height={140} eager />
    </a>
    <button class="menu-btn" id="menuBtn" type="button" aria-expanded="false" aria-controls="navlinks">Menu</button>
    <ul class="navlinks" id="navlinks">
      <li>
        <button class="drop-btn" id="learnBtn" type="button" aria-expanded="false" aria-controls="learnMenu" data-nav="learn" aria-current={cur("learn")}>InnerBoard</button>
        <ul class="submenu" id="learnMenu" hidden>
          <li><a href={ROUTES.academy}><b>Academy · Learn it</b><small>Lessons on real life skills.</small></a></li>
          <li><a href={ROUTES.lab}><b>The Lab · Live it</b><small>The Coaching Lab, the Masterclass, community.</small></a></li>
          <li><a href={ROUTES.inq}><b>INQ · Lead it</b><small>Certification for coaches and leaders.</small></a></li>
        </ul>
      </li>
      <li><a href={ROUTES.app} data-nav="app" aria-current={cur("app")}>The Practice</a></li>
      <li><a href={ROUTES.ios} data-nav="ios" aria-current={cur("ios")}>For Organizations</a></li>
      <li><a href={ROUTES.club} data-nav="club" aria-current={cur("club")}>The Club</a></li>
      <li class="mobile-cta"><a class="btn btn-solid" href={ROUTES.app} style="border:0;padding:14px 20px">Start Practicing <span class="arr">→</span></a></li>
    </ul>
    <a class="btn btn-solid" href={ROUTES.app}>Start Practicing <span class="arr">→</span></a>
  </div>
</header>
