---
/**
 * The sixteen tools, in the words the Tools tab uses for them (the October
 * 17 simplification: each label keeps its wording and carries the tool's
 * name as a tag). A row that scrolls sideways and snaps, with arrows.
 */
const tools = [
  ["I'm upset", "RAP"], ["I'm about to lose control", "Pause + Redirect"], ["What if I make the wrong decision?", "Capacity Edge"],
  ["I'm procrastinating again", "Discomfort Recognition"], ["How are you arriving?", "ten-second read"], ["I can't stop thinking about this", "STEAR"],
  ["Am I reading too much into that?", "Facts vs Story"], ["I don't think I can do that", "Belief Ladder"], ["What can I do about this?", "Ownership Statement"],
  ["Help me sort this out", "Integration Questions"], ["I keep doing the same thing", "Pattern Interrupt"], ["I know what I want. Where do I start?", "Reverse STEAR"],
  ["I'm nervous about this conversation", "Pre-Interaction Standard"], ["How do I say this?", "SPARK"], ["This is hard to hear", "HEAR"], ["They're upset. What do I say?", "Power Question"]
];
---
<div class="rail-wrap relative" data-rail>
  <ul class="rail flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4 -mx-5 px-5 sm:-mx-8 sm:px-8" role="list" tabindex="0" aria-label="The sixteen tools">
    {tools.map(([label, name], i) => (
      <li class="snap-start shrink-0 w-[260px] sm:w-[300px]">
        <div class="card h-full p-5 flex flex-col">
          <span class="text-[11px] font-semibold text-ink-faint tabular-nums">{String(i + 1).padStart(2, "0")}</span>
          <p class="mt-6 font-display text-[22px] leading-[1.15] text-ink flex-1">{label}</p>
          <p class="mt-5 inline-flex self-start rounded-full bg-steel-soft text-steel text-[11.5px] font-semibold px-3 py-1">{name}</p>
        </div>
      </li>
    ))}
  </ul>
  <div class="mt-2 flex items-center justify-between">
    <p class="text-[13px] text-ink-faint">Scroll, or use the arrows. Each one opens in the app with a tap.</p>
    <div class="flex gap-2">
      <button type="button" class="w-10 h-10 rounded-full border border-line-strong text-ink hover:bg-cream-2 inline-flex items-center justify-center" data-rail-prev aria-label="Previous tools"><svg viewBox="0 0 16 16" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 8H3M7 4 3 8l4 4"/></svg></button>
      <button type="button" class="w-10 h-10 rounded-full border border-line-strong text-ink hover:bg-cream-2 inline-flex items-center justify-center" data-rail-next aria-label="Next tools"><svg viewBox="0 0 16 16" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg></button>
    </div>
  </div>
</div>
<script>
  // The arrows scroll the rail by one card. Bound on every page load so the
  // transitions keep them working.
  const bind = () => {
    document.querySelectorAll<HTMLElement>("[data-rail]").forEach((wrap) => {
      if (wrap.dataset.bound) return;
      wrap.dataset.bound = "1";
      const rail = wrap.querySelector<HTMLElement>(".rail");
      const step = () => (rail?.querySelector<HTMLElement>("li")?.getBoundingClientRect().width || 300) + 16;
      wrap.querySelector("[data-rail-prev]")?.addEventListener("click", () => rail?.scrollBy({ left: -step(), behavior: "smooth" }));
      wrap.querySelector("[data-rail-next]")?.addEventListener("click", () => rail?.scrollBy({ left: step(), behavior: "smooth" }));
    });
  };
  bind();
  document.addEventListener("astro:page-load", bind);
</script>
<style>
  .rail { scrollbar-width: none; }
  .rail::-webkit-scrollbar { display: none; }
</style>
