---
/**
 * Legacy (deleted in stage three): the first build's drawn quiz phone with six
 * auto renew toggles. Image only, not functional. Its styles are scoped here
 * so the old homepage still renders while the system no longer carries them.
 */
const patterns = ["Proving", "Approval", "Control", "Pressure", "Certainty", "Old identity"];
---
<div class="qphone" aria-hidden="true">
  <div class="qphone-screen">
    <div class="qphone-notch"></div>
    <div class="px-5 pt-14 pb-6 text-[12px]">
      <p class="text-[9.5px] font-semibold uppercase tracking-[0.16em] text-steel">Your results</p>
      <p class="mt-1 font-display text-[21px] leading-[1.1] tracking-[-0.02em]">Here's what's on auto-renew.</p>
      <p class="mt-1 text-[11px] text-app-muted">Your top two are up first. The rest are right below.</p>
      <ul class="mt-4 divide-y divide-app-line rounded-[14px] border border-app-line bg-app-surface">
        {patterns.map((p, i) => (
          <li class="flex items-center justify-between px-3 py-2.5">
            <span class={`font-medium ${i < 2 ? "text-app-ink" : "text-app-muted"}`}>{p}</span>
            <span class={`qtoggle ${i < 2 ? "on" : ""}`}></span>
          </li>
        ))}
      </ul>
      <p class="mt-4 text-[10.5px] text-app-faint leading-snug">A reflection tool, not a clinical assessment. Retake it anytime; every result is kept.</p>
      <div class="mt-3 inline-flex items-center rounded-full bg-app-ink text-app-canvas px-3.5 py-1.5 text-[11px] font-semibold">Cancel one</div>
    </div>
  </div>
</div>
<style>
  .qphone { width: min(300px, 100%); aspect-ratio: 300 / 620; border-radius: 36px; background: #1b1916; padding: 7px; box-shadow: var(--sh-object); }
  .qphone-screen { position: relative; width: 100%; height: 100%; border-radius: 29px; overflow: hidden; background: #f2ece0; color: #1b1916; font-family: var(--font-sans); }
  .qphone-notch { position: absolute; top: 10px; left: 50%; transform: translateX(-50%); width: 96px; height: 26px; border-radius: 999px; background: #0f0e0c; }
  .qtoggle { width: 42px; height: 24px; border-radius: 999px; background: #d9cfbe; position: relative; display: block; }
  .qtoggle::after { content: ""; position: absolute; top: 2px; left: 2px; width: 20px; height: 20px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,0.2); }
  .qtoggle.on { background: #486786; }
  .qtoggle.on::after { left: 20px; }
</style>
