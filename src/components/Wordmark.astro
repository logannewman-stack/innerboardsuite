---
/**
 * InnerBoard's logo (the client's file, October 21): the gold arcs and the
 * wordmark, INNER in gold and BOARD in ink. The header uses the wordmark alone
 * (the full circle is too small to read at header height) in two cuts, ink
 * BOARD on light bars and ivory BOARD on dark ones; the footer uses the whole
 * logo. Files in public/brand, cut from the client's PNG.
 */
interface Props { class?: string; href?: string; size?: "header" | "footer" }
const { class: className = "", href = "/", size = "header" } = Astro.props;
---
{size === "header" ? (
  <a href={href} class={`brand-wordmark ${className}`.trim()} aria-label="InnerBoard, home">
    <img class="bw-light" src="/brand/wordmark.png" width="384" height="47" alt="InnerBoard" />
    <img class="bw-dark" src="/brand/wordmark-dark.png" width="384" height="47" alt="" aria-hidden="true" />
  </a>
) : (
  <a href={href} class={`brand-logo ${className}`.trim()} aria-label="InnerBoard, home">
    <img src="/brand/logo.png" width="500" height="500" alt="InnerBoard" loading="lazy" decoding="async" />
  </a>
)}
