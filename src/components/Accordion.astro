---
/** An accessible accordion built on details and summary: keyboard, screen reader and no-script friendly. */
interface Props { items: { q: string; a: string }[]; theme?: "cream" | "teal" }
const { items, theme = "cream" } = Astro.props;
---
<div class="divide-y divide-line">
  {items.map((item) => (
    <details class="acc group py-1">
      <summary class="flex items-start justify-between gap-6 py-4 text-left">
        <span class="font-display text-[20px] sm:text-[22px] leading-[1.2] text-ink">{item.q}</span>
        <span class={`acc-icon mt-1 shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-full border ${theme === "teal" ? "border-teal text-teal" : "border-line-strong text-ink"}`} aria-hidden="true">
          <svg viewBox="0 0 16 16" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 3v10M3 8h10"/></svg>
        </span>
      </summary>
      <p class="pb-5 pr-10 text-[15.5px] leading-relaxed text-ink-muted max-w-[720px]" set:html={item.a}></p>
    </details>
  ))}
</div>
