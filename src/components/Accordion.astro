---
/**
 * The FAQ (1.6): each question a button with aria-expanded and aria-controls,
 * the answer a 0fr to 1fr grid row so it animates both ways. Without the
 * script every answer is open. Anchors to #q-<slug> open the item on arrival.
 */
interface Props { items: { q: string; a: string }[]; theme?: "cream" | "teal"; class?: string }
const { items, theme = "cream", class: className = "" } = Astro.props;
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 48);
---
<div class={`qs ${theme === "teal" ? "theme-teal" : ""} ${className}`.trim()}>
  {items.map((item) => {
    const id = `q-${slug(item.q)}`;
    return (
      <div class="q" id={id}>
        <h3><button type="button" class="q-btn" aria-expanded="false" aria-controls={`${id}-answer`}><span class="q-q">{item.q}</span><span class="q-ico" aria-hidden="true"></span></button></h3>
        <div class="a" id={`${id}-answer`} role="region" aria-labelledby={id}><div><p set:html={item.a}></p></div></div>
      </div>
    );
  })}
</div>
